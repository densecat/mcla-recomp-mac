+                    "Display the largest guest color target used this frame until resolves exist");
+
+namespace rex::graphics::metal {
+using ui::metal::Adopt;
+using ui::metal::ReleaseObject;
+using T = SpirvShaderTranslator;
+
+struct MetalCommandProcessor::State {
+  MTL::Device* device;
+  MetalSubmission submission;
+  MetalSharedMemory shared;
+  MetalPrimitiveProcessor primitives;
+  MetalRenderTargetCache targets;
+  MetalPipelineCache pipelines;
+  DrawExtentEstimator extent;
+  std::array<MTL::Texture*, 6> placeholders{};
+  MTL::SamplerState* sampler = nullptr;
+  bool debug_present_logged = false;
+  string::StringBuffer disassembly;
+
+  State(MTL::Device* d, MTL::CommandQueue* queue, const RegisterFile& regs, memory::Memory& memory)
+      : device(d), submission(d, queue), shared(memory, submission),
+        primitives(regs, memory, shared, d), targets(regs, memory, d, submission),
+        pipelines(d, targets), extent(regs, memory) {}
+  ~State() {
+    submission.Finish();
+    for (auto*& texture : placeholders) ReleaseObject(texture);
+    ReleaseObject(sampler);
+  }
+  bool Initialize() {
+    if (device->maxBufferLength() < SharedMemory::kBufferSize ||
+        !submission.Initialize() || !shared.Initialize(device) || !primitives.Initialize())
+      return false;
+    for (uint32_t i = 0; i < placeholders.size(); ++i) {
+      auto desc = Adopt(MTL::TextureDescriptor::alloc()->init());
+      const MTL::TextureType types[] = {MTL::TextureType2DArray, MTL::TextureType3D, MTL::TextureTypeCube};
+      desc->setTextureType(types[i % 3]);
+      desc->setPixelFormat(i >= 3 ? MTL::PixelFormatRGBA8Snorm : MTL::PixelFormatRGBA8Unorm);
+      desc->setWidth(1); desc->setHeight(1); desc->setDepth(1);
+      desc->setArrayLength(1);
+      desc->setStorageMode(MTL::StorageModeShared);
+      desc->setUsage(MTL::TextureUsageShaderRead);
+      placeholders[i] = device->newTexture(desc.get());
+      if (!placeholders[i]) return false;
+      uint32_t texel = i >= 3 ? 0x7F7F7F7F : 0xFFFFFFFF;
+      for (uint32_t slice = 0; slice < (i % 3 == 2 ? 6u : 1u); ++slice)
+        placeholders[i]->replaceRegion(MTL::Region(0, 0, 0, 1, 1, 1), 0, slice, &texel, 4, 4);
+    }
+    auto desc = Adopt(MTL::SamplerDescriptor::alloc()->init());
+    desc->setNormalizedCoordinates(true);
+    desc->setMinFilter(MTL::SamplerMinMagFilterLinear);
+    desc->setMagFilter(MTL::SamplerMinMagFilterLinear);
+    desc->setSAddressMode(MTL::SamplerAddressModeClampToEdge);
+    desc->setTAddressMode(MTL::SamplerAddressModeClampToEdge);
+    desc->setRAddressMode(MTL::SamplerAddressModeClampToEdge);
+    sampler = device->newSamplerState(desc.get());
+    return sampler != nullptr;
+  }
+  void BindTextures(const SpirvShader& shader, bool vertex) {
+    auto* encoder = submission.encoder;
+    const auto& textures = shader.GetTextureBindingsAfterTranslation();
+    for (size_t i = 0; i < textures.size(); ++i) {
+      const auto& binding = textures[i];
+      uint32_t dimension = binding.dimension == xenos::FetchOpDimension::kCube ? 2 :
+          binding.dimension == xenos::FetchOpDimension::k3DOrStacked ? 1 : 0;
+      auto* texture = placeholders[dimension + (binding.is_signed ? 3 : 0)];
+      if (vertex) encoder->setVertexTexture(texture, i);
+      else encoder->setFragmentTexture(texture, i);
+    }
+    for (size_t i = 0; i < shader.GetSamplerBindingsAfterTranslation().size(); ++i) {
+      if (vertex) encoder->setVertexSamplerState(sampler, i);
+      else encoder->setFragmentSamplerState(sampler, i);
+    }
+  }
+};
+
+namespace {
+T::SystemConstants SystemConstants(const RegisterFile& regs,
+    const PrimitiveProcessor::ProcessingResult& p, const draw_util::ViewportInfo& vp, bool polygonal,
+    const MetalRenderTargetCache& targets) {
+  T::SystemConstants c{};
+  const auto vte = regs.Get<reg::PA_CL_VTE_CNTL>();
+  const auto clip = regs.Get<reg::PA_CL_CLIP_CNTL>();
+  const auto surface = regs.Get<reg::RB_SURFACE_INFO>();
+  const auto control = regs.Get<reg::RB_COLORCONTROL>();
+  if (vte.vtx_xy_fmt) c.flags |= T::kSysFlag_XYDividedByW;
+  if (vte.vtx_z_fmt) c.flags |= T::kSysFlag_ZDividedByW;
+  if (vte.vtx_w0_fmt) c.flags |= T::kSysFlag_WNotReciprocal;
+  if (polygonal) c.flags |= T::kSysFlag_PrimitivePolygonal;
+  if (draw_util::IsPrimitiveLine(regs)) c.flags |= T::kSysFlag_PrimitiveLine;
+  c.flags |= uint32_t(surface.msaa_samples) << T::kSysFlag_MsaaSamples_Shift;
+  if (regs.Get<reg::RB_DEPTH_INFO>().depth_format == xenos::DepthRenderTargetFormat::kD24FS8)
+    c.flags |= T::kSysFlag_DepthFloat24;
+  c.flags |= uint32_t(control.alpha_test_enable ? control.alpha_func : xenos::CompareFunction::kAlways)
+             << T::kSysFlag_AlphaPassIfLess_Shift;
+  if (p.index_buffer_type == PrimitiveProcessor::kHostBuiltinForDMA) {
+    c.flags |= T::kSysFlag_ComputeOrPrimitiveVertexIndexLoad;
+    if (regs.Get<reg::VGT_DRAW_INITIATOR>().index_size == xenos::IndexFormat::kInt32)
+      c.flags |= T::kSysFlag_ComputeOrPrimitiveVertexIndexLoad32Bit;
+  }
+  c.vertex_index_load_address = p.guest_index_base;
+  c.vertex_index_endian = p.host_shader_index_endian;
+  c.vertex_base_index = regs.Get<int32_t>(XE_GPU_REG_VGT_INDX_OFFSET);
+  c.vertex_index_min = regs[XE_GPU_REG_VGT_MIN_VTX_INDX];
+  c.vertex_index_max = regs[XE_GPU_REG_VGT_MAX_VTX_INDX];
+  c.line_loop_closing_index = p.line_loop_closing_index;
+  uint32_t plane_out = 0;
+  if (!clip.clip_disable) {
+    for (uint32_t i = 0; i < 6; ++i) if (clip.ucp_ena & (1u << i))
+      std::memcpy(c.user_clip_planes[plane_out++], &regs[XE_GPU_REG_PA_CL_UCP_0_X + 4 * i], 16);
+  }
+  for (uint32_t i = 0; i < 3; ++i) {
+    c.ndc_scale[i] = vp.ndc_scale[i];
+    c.ndc_offset[i] = vp.ndc_offset[i];
+  }
+  auto point = regs.Get<reg::PA_SU_POINT_SIZE>();
+  auto bounds = regs.Get<reg::PA_SU_POINT_MINMAX>();
+  c.point_vertex_diameter_min = float(bounds.min_size) * 0.125f;
+  c.point_vertex_diameter_max = float(bounds.max_size) * 0.125f;
+  c.point_constant_diameter[0] = float(point.width) * 0.125f;
+  c.point_constant_diameter[1] = float(point.height) * 0.125f;
+  for (uint32_t i = 0; i < 2; ++i)
+    c.point_screen_diameter_to_ndc_radius[i] = 1.0f / std::max(1u, vp.xy_extent[i]);
+  c.alpha_test_reference = regs.Get<float>(XE_GPU_REG_RB_ALPHA_REF);
+  c.alpha_to_mask = control.alpha_to_mask_enable ? (control.value >> 24) | 256 : 0;
+  for (uint32_t i = 0; i < 4; ++i) {
+    auto info = regs.Get<reg::RB_COLOR_INFO>(reg::RB_COLOR_INFO::rt_register_indices[i]);
+    int32_t bias = info.color_exp_bias;
+    if (REXCVAR_GET(snorm16_render_target_full_range) &&
+        (info.color_format == xenos::ColorRenderTargetFormat::k_16_16 ||
+         info.color_format == xenos::ColorRenderTargetFormat::k_16_16_16_16)) bias -= 5;
+    c.color_exp_bias[i] = std::ldexp(1.0f, bias);
+    if (!targets.gamma_unorm16() &&
+        info.color_format == xenos::ColorRenderTargetFormat::k_8_8_8_8_GAMMA)
+      c.flags |= T::kSysFlag_ConvertColor0ToGamma << i;
+  }
+  return c;
+}
+void FloatConstants(uint8_t* dest, const RegisterFile& regs, const SpirvShader* shader, bool pixel) {
+  if (!shader) return;
+  const auto& map = shader->constant_register_map();
+  for (uint32_t group = 0; group < 4; ++group) {
+    uint64_t bits = map.float_bitmap[group];
+    uint32_t index;
+    while (rex::bit_scan_forward(bits, &index)) {
+      bits &= ~(uint64_t(1) << index);
+      std::memcpy(dest, &regs[(pixel ? XE_GPU_REG_SHADER_CONSTANT_256_X : XE_GPU_REG_SHADER_CONSTANT_000_X)
+                              + group * 256 + index * 4], 16);
+      dest += 16;
+    }
+  }
+}
+}  // namespace
+
+MetalCommandProcessor::MetalCommandProcessor(GraphicsSystem* graphics, system::KernelState* kernel)
+    : CommandProcessor(graphics, kernel) {}
+MetalCommandProcessor::~MetalCommandProcessor() = default;
+
+bool MetalCommandProcessor::SetupContext() {
+  if (!CommandProcessor::SetupContext()) return false;
+  auto pool = Adopt(NS::AutoreleasePool::alloc()->init());
+  auto* provider = static_cast<ui::metal::MetalProvider*>(graphics_system_->provider());
+  if (!provider || !provider->device() || !provider->queue()) return false;
+  state_ = std::make_unique<State>(provider->device(), provider->queue(), *register_file_, *memory_);
+  if (!state_->Initialize()) {
+    REXLOG_ERROR("Metal M2b initialization failed");
+    state_.reset();
+    return false;
+  }
+  REXLOG_WARN("Metal M2b: guest host render targets; placeholder textures; resolves and queries remain stubbed");
+  return true;
+}
+void MetalCommandProcessor::ShutdownContext() {
+  REXLOG_INFO("Metal M2b counts: draws={}, rejected={}, copies={}, swaps={}, base-query-packets={}",
+              draws_, rejected_draws_, copies_, swaps_, query_packets_);
+  auto pool = Adopt(NS::AutoreleasePool::alloc()->init());
+  state_.reset();
+  active_vertex_shader_ = active_pixel_shader_ = nullptr;
+  shaders_.clear();
+  CommandProcessor::ShutdownContext();
+}
+void MetalCommandProcessor::ClearCaches() {
+  CallInThread([this] {
+    if (!state_) return;
+    state_->submission.Submit();
+    state_->primitives.EndFrame();
+    state_->shared.ClearCache();
+    state_->targets.ClearCache();
+  });
+}
+void MetalCommandProcessor::InvalidateGpuMemory() {
+  if (state_) state_->shared.InvalidateAllPages();
+}
+void MetalCommandProcessor::OnPrimaryBufferEnd() {
+  if (state_) state_->submission.Submit();
+}
+void MetalCommandProcessor::PrepareForWait() {
+  if (state_) state_->submission.Submit();
+  CommandProcessor::PrepareForWait();
+}
+bool MetalCommandProcessor::ExecutePacketType3_EVENT_WRITE_ZPD(
+    memory::RingBuffer* reader, uint32_t packet, uint32_t count) {
+  ++query_packets_;
+  return CommandProcessor::ExecutePacketType3_EVENT_WRITE_ZPD(reader, packet, count);
+}
+Shader* MetalCommandProcessor::LoadShader(xenos::ShaderType type, uint32_t,
+                                         const uint32_t* host_address, uint32_t dword_count) {
+  if (!host_address || !dword_count) return nullptr;
+  uint64_t hash = XXH3_64bits(host_address, size_t(dword_count) * sizeof(uint32_t));
+  auto shader = std::make_unique<SpirvShader>(type, hash, host_address, dword_count);
+  auto range = shaders_.equal_range(hash);
+  for (auto it = range.first; it != range.second; ++it) {
+    if (it->second->type() == type && it->second->ucode_data() == shader->ucode_data())
+      return it->second.get();
+  }
+  auto* result = shader.get();
+  shaders_.emplace(hash, std::move(shader));
+  return result;
+}
+bool MetalCommandProcessor::IssueDraw(xenos::PrimitiveType, uint32_t, IndexBufferInfo*, bool) {
+  const auto& regs = *register_file_;
+  if (regs.Get<reg::RB_MODECONTROL>().edram_mode == xenos::EdramMode::kCopy) return IssueCopy();
+  ++draws_;
+  auto fail = [&](const char* reason) {
+    ++rejected_draws_;
+    if (rejected_draws_ == 1 || !(rejected_draws_ & 255))
+      REXLOG_ERROR("Metal draw rejected (total={}): {}", rejected_draws_, reason);
+    return false;
+  };
+  if (!state_) return fail("no context");
+  auto pool = Adopt(NS::AutoreleasePool::alloc()->init());
+  auto& s = *state_;
+  auto* vs = static_cast<SpirvShader*>(active_vertex_shader());
+  if (!vs) return fail("missing VS");
+  if (!vs->is_ucode_analyzed()) vs->AnalyzeUcode(s.disassembly);
+  bool polygonal = draw_util::IsPrimitivePolygonal(regs);
+  bool rasterize = draw_util::IsRasterizationPotentiallyDone(regs, polygonal);
+  if (!rasterize && !vs->memexport_eM_written()) return true;
+  auto* ps = rasterize && regs.Get<reg::RB_MODECONTROL>().edram_mode == xenos::EdramMode::kColorDepth
+      ? static_cast<SpirvShader*>(active_pixel_shader()) : nullptr;
+  if (ps) {
+    if (!ps->is_ucode_analyzed()) ps->AnalyzeUcode(s.disassembly);
+    if (!draw_util::IsPixelShaderNeededWithRasterization(*ps, regs)) ps = nullptr;
+  }
+  if (!s.submission.Begin()) return fail("begin submission");
+  PrimitiveProcessor::ProcessingResult p{};
+  if (!s.primitives.Process(p)) return fail("primitive conversion");
+  if (!p.host_draw_vertex_count) return true;
+  if (p.IsTessellated()) return fail("tessellation is not implemented in M2a");
+  MTL::PrimitiveType primitive;
+  switch (p.host_primitive_type) {
+    case xenos::PrimitiveType::kPointList: primitive = MTL::PrimitiveTypePoint; break;
+    case xenos::PrimitiveType::kLineList: primitive = MTL::PrimitiveTypeLine; break;
+    case xenos::PrimitiveType::kLineStrip: primitive = MTL::PrimitiveTypeLineStrip; break;
+    case xenos::PrimitiveType::kTriangleList: primitive = MTL::PrimitiveTypeTriangle; break;
+    case xenos::PrimitiveType::kTriangleStrip: primitive = MTL::PrimitiveTypeTriangleStrip; break;
+    default: return fail("unsupported host topology");
+  }
+  auto depth_control = draw_util::GetNormalizedDepthControl(regs);
+  uint32_t param_gen = UINT32_MAX;
+  uint32_t interpolators = ps ? vs->writes_interpolators() & ps->GetInterpolatorInputMask(
+      regs.Get<reg::SQ_PROGRAM_CNTL>(), regs.Get<reg::SQ_CONTEXT_MISC>(), param_gen) : 0;
+  auto* vertex = s.pipelines.GetShader(*vs, s.pipelines.VertexModification(
+      regs, *vs, p.host_vertex_shader_type, interpolators, param_gen != UINT32_MAX));
+  if (!vertex) return fail("vertex shader translation/compilation");
+
+  std::vector<std::pair<uint32_t, uint32_t>> reads, writes;
+  const auto& constants = vs->constant_register_map();
+  for (uint32_t i = 0; i < std::size(constants.vertex_fetch_bitmap); ++i) {
+    uint32_t bits = constants.vertex_fetch_bitmap[i], bit;
+    while (rex::bit_scan_forward(bits, &bit)) {
+      bits &= ~(1u << bit);
+      auto fetch = regs.GetVertexFetch(32 * i + bit);
+      if (fetch.type != xenos::FetchConstantType::kVertex &&
+          !(fetch.type == xenos::FetchConstantType::kInvalidVertex &&
+            REXCVAR_GET(gpu_allow_invalid_fetch_constants))) return fail("invalid vertex fetch");
+      reads.emplace_back((fetch.address << 2) & (SharedMemory::kBufferSize - 1), fetch.size << 2);
+    }
+  }
+  bool guest_indices = p.index_buffer_type == PrimitiveProcessor::kGuestDMA ||
+                       p.index_buffer_type == PrimitiveProcessor::kHostBuiltinForDMA;
+  bool memexport = vs->memexport_eM_written() || (ps && ps->memexport_eM_written());
+  if (memexport) {
+    std::vector<draw_util::MemExportRange> ranges;
+    draw_util::AddMemExportRanges(regs, *vs, ranges);
+    if (ps) draw_util::AddMemExportRanges(regs, *ps, ranges);
+    for (const auto& r : ranges) writes.emplace_back(r.base_address_dwords << 2, r.size_bytes);
+    if (writes.empty()) writes.emplace_back(0, SharedMemory::kBufferSize);
+  }
+  // All CPU snapshots precede constants and encoder bindings. Uploads may split
+  // the submission; none of the following code assumes the old epoch survives.
+  for (const auto* ranges : {&reads, &writes}) for (auto [start, size] : *ranges) {
+    if (start >= SharedMemory::kBufferSize || size > SharedMemory::kBufferSize - start ||
+        !s.shared.RequestRange(start, size)) return fail("shared-memory snapshot");
+  }
+  // Process already requested DMA indices; do not snapshot hot pages twice.
+  if (guest_indices) reads.emplace_back(p.guest_index_base, p.guest_draw_vertex_count *
+      (regs.Get<reg::VGT_DRAW_INITIATOR>().index_size == xenos::IndexFormat::kInt16 ? 2u : 4u));
+  draw_util::ViewportInfo viewport;
+  // Metal NDC Y points up. The helper supplies the corresponding shader Y flip.
+  draw_util::GetHostViewportInfo(regs, 1, 1, true, 16384, 16384, false,
+                                depth_control, s.targets.depth_float24_convert(), true,
+                                ps && ps->writes_depth(), viewport);
+  draw_util::Scissor scissor;
+  draw_util::GetScissor(regs, scissor);
+  uint32_t width = regs.Get<reg::RB_SURFACE_INFO>().surface_pitch;
+  uint32_t height = std::clamp(s.extent.EstimateMaxY(false, *vs), 1u, 8192u);
+  if (!width || !viewport.xy_extent[0] || !viewport.xy_extent[1] ||
+      !scissor.extent[0] || !scissor.extent[1]) {
+    rasterize = false;
+    if (!vs->memexport_eM_written()) return true;
+  }
+  uint32_t color_mask = ps ? draw_util::GetNormalizedColorMask(regs, ps->writes_color_targets()) : 0;
+
+  std::pair<MTL::Buffer*, size_t> indices{};
+  auto index_snapshot = Adopt(static_cast<MTL::Buffer*>(nullptr));
+  if (p.index_buffer_type == PrimitiveProcessor::kGuestDMA) {
+    indices = {s.shared.buffer(), p.guest_index_base};
+    if (memexport) {
+      // Match Vulkan's index snapshot for draws that may overwrite their DMA indices.
+      size_t size = size_t(p.host_draw_vertex_count) *
+                    (p.host_index_format == xenos::IndexFormat::kInt16 ? 2 : 4);
+      index_snapshot = Adopt(s.device->newBuffer(size, MTL::ResourceStorageModePrivate));
+      if (!index_snapshot) return fail("index snapshot allocation");
+      s.submission.EndEncoding(perf::CounterId::kPassEndMemexport);
+      auto* blit = s.submission.buffer()->blitCommandEncoder();
+      if (!blit) return fail("index snapshot encoder");
+      blit->copyFromBuffer(indices.first, indices.second, index_snapshot.get(), 0, size);
+      blit->endEncoding();
+      s.shared.MarkUsed(p.guest_index_base, uint32_t(size));
+      indices = {index_snapshot.get(), 0};
+    }
+  } else if (p.index_buffer_type != PrimitiveProcessor::kNone) {
+    indices = s.primitives.GetIndexBuffer(p);
+  }
+  constexpr size_t system_size = (sizeof(T::SystemConstants) + 255) & ~size_t(255);
+  constexpr size_t offsets[] = {0, system_size, system_size + 4096,
+                                system_size + 8192, system_size + 8192 + 256};
+  constexpr size_t total = system_size + 8192 + 256 + 768;
+  MTL::Buffer* uniforms;
+  size_t base;
+  if (!s.submission.AllocateConstants(total, uniforms, base)) return fail("uniform ring");
+  // Uploads, index snapshots and uniform rollover have all finished. Update can
+  // retain the current encoder or transfer ownership and open a different pass.
+  if (!s.targets.Update(rasterize, depth_control, color_mask, *vs)) return fail("guest targets");
+  for (uint32_t i = 0; i < 2; ++i) {
+    uint32_t limit = i ? s.targets.height() : s.targets.width();
+    scissor.offset[i] = std::min(scissor.offset[i], limit);
+    scissor.extent[i] = std::min(scissor.extent[i], limit - scissor.offset[i]);
+  }
+  if (!scissor.extent[0] || !scissor.extent[1]) {
+    rasterize = false;
+    if (!vs->memexport_eM_written()) return true;
+  }
+  uint32_t attachments = s.targets.depth_format() != MTL::PixelFormatInvalid ? 1 : 0;
+  for (uint32_t i = 0; i < 4; ++i)
+    if (s.targets.color_formats()[i] != MTL::PixelFormatInvalid) attachments |= 2u << i;
+  auto* pixel = ps ? s.pipelines.GetShader(*ps, s.pipelines.PixelModification(
+      regs, *ps, interpolators, param_gen, depth_control), attachments) : nullptr;
+  bool depth_only = !ps && rasterize && (attachments & 1) && depth_control.z_enable &&
+      s.targets.depth_float24_convert() &&
+      regs.Get<reg::RB_DEPTH_INFO>().depth_format == xenos::DepthRenderTargetFormat::kD24FS8;
+  if (depth_only) pixel = s.pipelines.GetDepthOnlyShader();
+  if ((ps || depth_only) && !pixel) return fail("pixel shader translation/compilation");
+  auto* pipeline = s.pipelines.GetPipeline(regs, *vertex, pixel, p.host_primitive_type,
+                                           color_mask, rasterize);
+  auto effective_depth = depth_control;
+  if (!(attachments & 1)) effective_depth.value = 0;
+  auto* depth_state = s.pipelines.GetDepthState(regs, polygonal, effective_depth);
+  if (!pipeline || !depth_state) return fail("pipeline state");
+  auto* data = static_cast<uint8_t*>(uniforms->contents()) + base;
+  std::memset(data, 0, total);
+  auto system = SystemConstants(regs, p, viewport, polygonal, s.targets);
+  std::memcpy(data, &system, sizeof(system));
+  FloatConstants(data + offsets[1], regs, vs, false);
+  FloatConstants(data + offsets[2], regs, ps, true);
+  std::memcpy(data + offsets[3], &regs[XE_GPU_REG_SHADER_CONSTANT_BOOL_000_031], 160);
+  std::memcpy(data + offsets[4], &regs[XE_GPU_REG_SHADER_CONSTANT_FETCH_00_0], 768);
+  auto* e = s.submission.encoder;
+  e->setRenderPipelineState(pipeline);
+  e->setDepthStencilState(depth_state);
+  e->setVertexBuffer(s.shared.buffer(), 0, 0);
+  e->setFragmentBuffer(s.shared.buffer(), 0, 0);
+  e->useResource(s.shared.buffer(), memexport ? MTL::ResourceUsageRead | MTL::ResourceUsageWrite
+                                             : MTL::ResourceUsageRead,
+                 MTL::RenderStageVertex | MTL::RenderStageFragment);
+  for (uint32_t i = 0; i < 5; ++i) {
+    e->setVertexBuffer(uniforms, base + offsets[i], 1 + i);
+    e->setFragmentBuffer(uniforms, base + offsets[i], 1 + i);
+  }
+  s.BindTextures(*vs, true);
+  if (ps) s.BindTextures(*ps, false);
+  e->setViewport(MTL::Viewport{double(viewport.xy_offset[0]), double(viewport.xy_offset[1]),
+      double(std::max(1u, viewport.xy_extent[0])), double(std::max(1u, viewport.xy_extent[1])),
+      viewport.z_min, viewport.z_max});
+  e->setScissorRect(rasterize ? MTL::ScissorRect{scissor.offset[0], scissor.offset[1],
+                                               scissor.extent[0], scissor.extent[1]}
+                            : MTL::ScissorRect{0, 0, 1, 1});
+  auto raster = regs.Get<reg::PA_SU_SC_MODE_CNTL>();
+  e->setCullMode(!polygonal ? MTL::CullModeNone : raster.cull_front ? MTL::CullModeFront :
+                 raster.cull_back ? MTL::CullModeBack : MTL::CullModeNone);
+  e->setFrontFacingWinding(polygonal && raster.face ? MTL::WindingClockwise : MTL::WindingCounterClockwise);
+  auto fill = xenos::PolygonType::kTriangles;
+  if (polygonal && raster.poly_mode == xenos::PolygonModeEnable::kDualMode) {
+    if (!raster.cull_front) fill = std::min(fill, raster.polymode_front_ptype);
+    if (!raster.cull_back) fill = std::min(fill, raster.polymode_back_ptype);
+  }
+  e->setTriangleFillMode(fill == xenos::PolygonType::kTriangles ? MTL::TriangleFillModeFill
+                                                              : MTL::TriangleFillModeLines);
+  e->setDepthClipMode(regs.Get<reg::PA_CL_CLIP_CNTL>().clip_disable ? MTL::DepthClipModeClamp
+                                                                 : MTL::DepthClipModeClip);
+  float slope, bias;
+  draw_util::GetPreferredFacePolygonOffset(regs, polygonal, slope, bias);
+  bias *= regs.Get<reg::RB_DEPTH_INFO>().depth_format == xenos::DepthRenderTargetFormat::kD24S8
+      ? draw_util::kD3D10PolygonOffsetFactorUnorm24 : draw_util::kD3D10PolygonOffsetFactorFloat24;
+  e->setDepthBias(bias, slope * xenos::kPolygonOffsetScaleSubpixelUnit, 0);
+  auto front = regs.Get<reg::RB_STENCILREFMASK>();
+  auto back = polygonal && depth_control.backface_enable
+      ? regs.Get<reg::RB_STENCILREFMASK>(XE_GPU_REG_RB_STENCILREFMASK_BF) : front;
+  e->setStencilReferenceValues(front.stencilref, back.stencilref);
+  e->setBlendColor(regs.Get<float>(XE_GPU_REG_RB_BLEND_RED), regs.Get<float>(XE_GPU_REG_RB_BLEND_GREEN),
+                   regs.Get<float>(XE_GPU_REG_RB_BLEND_BLUE), regs.Get<float>(XE_GPU_REG_RB_BLEND_ALPHA));
+  if (indices.first) {
+    e->drawIndexedPrimitives(primitive, p.host_draw_vertex_count,
+        p.host_index_format == xenos::IndexFormat::kInt16 ? MTL::IndexTypeUInt16 : MTL::IndexTypeUInt32,
+        indices.first, indices.second);
+  } else {
+    e->drawPrimitives(primitive, NS::UInteger(0), NS::UInteger(p.host_draw_vertex_count));
+  }
+  if (rasterize) s.targets.MarkDraw(color_mask, width, height);
+  PERF_METAL_counter_add(kDrawCalls, 1);
+  PERF_METAL_counter_add(kVerticesProcessed, p.host_draw_vertex_count);
+  PERF_METAL_counter_add(kMetalDrawsEncoded, 1);
+  if (vs->GetUsedTextureMaskAfterTranslation() || (ps && ps->GetUsedTextureMaskAfterTranslation()))
+    PERF_METAL_counter_add(kMetalPlaceholderTextureDraws, 1);
+  for (auto [start, size] : reads) s.shared.MarkUsed(start, size);
+  for (auto [start, size] : writes) {
+    s.shared.MarkUsed(start, size);
+    s.shared.RangeWrittenByGpu(start, size);
+  }
+  // Tracked Metal resources order memexport against subsequent render/blit encoders.
+  if (memexport) s.submission.EndEncoding(perf::CounterId::kPassEndMemexport);
+  return true;
+}
+bool MetalCommandProcessor::IssueCopy() {
+  ++copies_;
+  return true;  // Guest resolves / IssueCopy to memory belong to milestone 4.
+}
+
+void MetalCommandProcessor::IssueSwap(uint32_t, uint32_t width, uint32_t height) {
+  ++swaps_;
+  auto pool = Adopt(NS::AutoreleasePool::alloc()->init());
+  bool submitted = true;
+  if (state_) {
+    submitted = state_->submission.Submit(perf::CounterId::kPassEndSwap);
+    state_->primitives.EndFrame();
+    if (REXCVAR_GET(clear_memory_page_state))
+      state_->shared.SetSystemPageBlocksValidWithGpuDataWritten();
+  }
+  auto* presenter = graphics_system_->presenter();
+  if (!presenter || !width || !height) {
+    if (presenter) presenter->RefreshGuestOutput(0, 0, 0, 0, {});
+    if (state_) state_->targets.BeginFrame();
+    return;
+  }
+  double phase = std::chrono::duration<double>(
+      std::chrono::steady_clock::now().time_since_epoch()).count() * 0.25;
+  bool refreshed = submitted && presenter->RefreshGuestOutput(width, height, width, height,
+      [this, phase](ui::Presenter::GuestOutputRefreshContext& context) {
+        auto& metal = static_cast<ui::metal::MetalGuestOutputRefreshContext&>(context);
+        if (state_ && REXCVAR_GET(metal_debug_present_last_rt) && state_->targets.has_debug_target()) {
+          // CP and presenter command buffers use the same provider queue. Submit
+          // the guest first, then wait for this copy before mailbox publication.
+          if (!state_->targets.DebugPresent(metal.command_buffer(), metal.texture()) ||
+              !metal.SubmitAndWait()) return false;
+          if (!state_->debug_present_logged) {
+            REXLOG_WARN("Metal: metal_debug_present_last_rt is displaying guest rendering (textures/resolves incomplete)");
+            state_->debug_present_logged = true;
+          }
+          return true;
+        }
+        return metal.Clear(0.10 + 0.06 * std::sin(phase),
+                           0.14 + 0.06 * std::sin(phase + 2.0),
+                           0.22 + 0.06 * std::sin(phase + 4.0));
+      });
+  if (state_) state_->targets.BeginFrame();
+  if (!refreshed && !swap_failure_logged_) {
+    REXLOG_ERROR("Metal guest-output refresh failed");
+    swap_failure_logged_ = true;
+  } else if (refreshed) {
+    swap_failure_logged_ = false;
+  }
+}
+}  // namespace rex::graphics::metal
+#endif
