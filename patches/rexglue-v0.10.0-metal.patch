diff --git a/include/rex/graphics/metal/msl_shader.h b/include/rex/graphics/metal/msl_shader.h
new file mode 100644
index 0000000..ecb6c18
--- /dev/null
+++ b/include/rex/graphics/metal/msl_shader.h
@@ -0,0 +1,36 @@
+#pragma once
+#if defined(__APPLE__) && defined(REX_HAS_METAL) && REX_HAS_METAL
+#include <Metal/Metal.hpp>
+#include <cstdint>
+#include <array>
+#include <initializer_list>
+#include <vector>
+
+namespace rex::graphics::metal {
+struct MetalFunction {
+  uint64_t hash = 0;
+  uint64_t modification = 0;
+  MTL::Library* library = nullptr;
+  MTL::Function* function = nullptr;
+  ~MetalFunction();
+};
+// Keep SPIRV-Cross's SPIR-V header separate from glslang's header.
+bool CompileMSL(MTL::Device* device, const std::vector<uint8_t>& binary,
+                bool vertex, uint32_t texture_count, uint32_t sampler_count,
+                MetalFunction& result, uint32_t attachment_mask = 31);
+// SDK texture-load SPIR-V: push constants -> 0, destination -> 1, source -> 2.
+// Kept in this TU to avoid mixing glslang and SPIRV-Cross SPIR-V headers.
+bool CompileTextureLoadMSL(MTL::Device* device, const uint32_t* words, size_t count,
+                           MetalFunction& result);
+// Explicit bindings for the SDK's utility SPIR-V. Push constants always use
+// Metal buffer 0; no automatic binding allocation is relied upon.
+struct MetalSpirvBinding {
+  uint32_t set, binding, buffer, texture;
+};
+bool CompileUtilityMSL(MTL::Device* device, const uint32_t* words, size_t count,
+                       bool compute, uint32_t push_size,
+                       std::initializer_list<MetalSpirvBinding> bindings,
+                       MetalFunction& result, std::array<uint32_t, 3>* group = nullptr,
+                       uint32_t sample_mask = UINT32_MAX);
+}  // namespace rex::graphics::metal
+#endif
