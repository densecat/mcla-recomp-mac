+
+class MetalUIDrawContext final : public UIDrawContext {
+ public:
+  MetalUIDrawContext(Presenter& presenter, uint32_t width, uint32_t height,
+                     MTL::RenderCommandEncoder* encoder)
+      : UIDrawContext(presenter, width, height), encoder_(encoder) {}
+  MTL::RenderCommandEncoder* encoder() const { return encoder_; }
+
+ private:
+  MTL::RenderCommandEncoder* encoder_;
+};
+
+class MetalGuestOutputRefreshContext final : public Presenter::GuestOutputRefreshContext {
+ public:
+  // Borrowed until the refresher returns. Write every pixel, end all encoders,
+  // then call SubmitAndWait before returning true. Never commit directly.
+  // M2 may blit a resolved BGRA8 texture into texture() using command_buffer().
+  MTL::Texture* texture() const { return texture_; }
+  MTL::CommandBuffer* command_buffer() const { return command_buffer_; }
+  bool SubmitAndWait();
+  bool Clear(double red, double green, double blue);
+
+ private:
+  friend class MetalPresenter;
+  MetalGuestOutputRefreshContext(bool& is_8bpc, MTL::Texture* texture,
+                                MTL::CommandBuffer* command_buffer)
+      : GuestOutputRefreshContext(is_8bpc),
+        texture_(texture), command_buffer_(command_buffer) {}
+  MTL::Texture* texture_;
+  MTL::CommandBuffer* command_buffer_;
+  bool submitted_ = false;
+  bool completed_ = false;
+};
+
+class MetalPresenter final : public Presenter {
+ public:
+  MetalPresenter(MetalProvider& provider, HostGpuLossCallback callback);
+  ~MetalPresenter() override;
+  bool Initialize();
+  Surface::TypeFlags GetSupportedSurfaceTypes() const override;
+  bool CaptureGuestOutput(RawImage& image_out) override;
+
+ protected:
+  SurfacePaintConnectResult ConnectOrReconnectPaintingToSurfaceFromUIThread(
+      Surface& surface, uint32_t width, uint32_t height, bool was_paintable,
+      bool& is_vsync_implicit_out) override;
+  void DisconnectPaintingFromSurfaceFromUIThreadImpl() override;
+  bool RefreshGuestOutputImpl(
+      uint32_t index, uint32_t width, uint32_t height,
+      std::function<bool(GuestOutputRefreshContext&)> refresher,
+      bool& is_8bpc_out) override;
+  PaintResult PaintAndPresentImpl(bool execute_ui_drawers) override;
+
+ private:
+  MetalProvider& provider_;
+  void* layer_ = nullptr;  // Retained CAMetalLayer; touched only in the .mm.
+  bool vsync_ = true;
+  std::array<MTL::Texture*, kGuestOutputMailboxSize> guest_textures_{};
+  std::unique_ptr<MetalImmediateDrawer> guest_drawer_;
+};
+}  // namespace rex::ui::metal
+#endif
