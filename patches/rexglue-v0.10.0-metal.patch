+struct ShaderCode { const uint32_t* words; size_t count; };
+constexpr ShaderCode kResolveShaders[] = {
+    {shaders::resolve_fast_32bpp_1x2xmsaa_cs, std::size(shaders::resolve_fast_32bpp_1x2xmsaa_cs)},
+    {shaders::resolve_fast_32bpp_4xmsaa_cs, std::size(shaders::resolve_fast_32bpp_4xmsaa_cs)},
+    {shaders::resolve_fast_64bpp_1x2xmsaa_cs, std::size(shaders::resolve_fast_64bpp_1x2xmsaa_cs)},
+    {shaders::resolve_fast_64bpp_4xmsaa_cs, std::size(shaders::resolve_fast_64bpp_4xmsaa_cs)},
+    {shaders::resolve_full_8bpp_cs, std::size(shaders::resolve_full_8bpp_cs)},
+    {shaders::resolve_full_16bpp_cs, std::size(shaders::resolve_full_16bpp_cs)},
+    {shaders::resolve_full_32bpp_cs, std::size(shaders::resolve_full_32bpp_cs)},
+    {shaders::resolve_full_64bpp_cs, std::size(shaders::resolve_full_64bpp_cs)},
+    {shaders::resolve_full_128bpp_cs, std::size(shaders::resolve_full_128bpp_cs)},
+};
+constexpr ShaderCode kHostDepthStoreShaders[] = {
+    {shaders::host_depth_store_1xmsaa_cs, std::size(shaders::host_depth_store_1xmsaa_cs)},
+    {shaders::host_depth_store_2xmsaa_cs, std::size(shaders::host_depth_store_2xmsaa_cs)},
+    {shaders::host_depth_store_4xmsaa_cs, std::size(shaders::host_depth_store_4xmsaa_cs)},
+};
+static_assert(std::size(kResolveShaders) == size_t(draw_util::ResolveCopyShaderIndex::kCount));
+constexpr const char* kUtilityVertexMSL = R"MSL(
+#include <metal_stdlib>
+using namespace metal;
+struct VertexOut { float4 position [[position]]; };
+vertex VertexOut rt_vertex(uint id [[vertex_id]]) {
+  return {float4(float2((id << 1) & 2, id & 2) * 2.0f - 1.0f, 0, 1)};
+}
+)MSL";
+void Attachment(MTL::RenderPassAttachmentDescriptor* a, MTL::Texture* texture, bool fresh) {
+  a->setTexture(texture);
+  a->setLoadAction(fresh ? MTL::LoadActionClear : MTL::LoadActionLoad);
+  a->setStoreAction(MTL::StoreActionStore);
+}
+void EndUtilityPass(MTL::RenderCommandEncoder*& encoder, bool resolve) {
+  if (!encoder) return;
+  encoder->endEncoding();
+  encoder = nullptr;
+  if (resolve) PERF_METAL_counter_add(kPassEndResolve, 1);
+  else PERF_METAL_counter_add(kPassEndTransfer, 1);
+}
+}
+MetalRenderTargetCache::MetalRenderTargetCache(const RegisterFile& regs,
+    const memory::Memory& memory, MTL::Device* device, MetalSubmission& submission)
+    : RenderTargetCache(regs, memory, 1, 1), device_(device), submission_(submission),
+      gamma_unorm16_(REXCVAR_GET(gamma_render_target_as_unorm16)),
+      depth_float24_convert_(REXCVAR_GET(depth_float24_convert_in_pixel_shader)),
+      depth_float24_round_(REXCVAR_GET(depth_float24_round)),
+      native_2x_(REXCVAR_GET(native_2x_msaa) && device->supportsTextureSampleCount(2)) {
+  InitializeCommon();
+}
+MetalRenderTargetCache::~MetalRenderTargetCache() {
+  ShutdownCommon();
+  for (auto& [key, pipeline] : transfer_pipelines_) ReleaseObject(pipeline);
+  ReleaseObject(transfer_depth_state_);
+  for (auto& [key, compute] : compute_) ReleaseObject(compute.pipeline);
+  for (auto& [key, pipeline] : clear_pipelines_) ReleaseObject(pipeline);
+  ReleaseObject(edram_);
+}
+MetalRenderTargetCache::Target::~Target() {
+  ReleaseObject(stencil);
+  ReleaseObject(transfer);
+  ReleaseObject(texture);
+}
+void MetalRenderTargetCache::ClearCache() {
+  submission_.EndEncoding();
+  bound_.fill(nullptr);
+  colors_.fill(MTL::PixelFormatInvalid);
+  BeginFrame();
+  RenderTargetCache::ClearCache();
+}
+void MetalRenderTargetCache::BeginFrame() {
+  RenderTargetCache::BeginFrame();
+  debug_target_ = nullptr;
+  debug_width_ = debug_height_ = 0;
+}
+bool MetalRenderTargetCache::IsHostDepthEncodingDifferent(xenos::DepthRenderTargetFormat f) const {
+  return f == xenos::DepthRenderTargetFormat::kD24S8 ||
+      (f == xenos::DepthRenderTargetFormat::kD24FS8 && !depth_float24_convert_);
+}
+uint32_t MetalRenderTargetCache::Samples(xenos::MsaaSamples s) const {
+  return s == xenos::MsaaSamples::k2X && !native_2x_ ? 4 : 1u << uint32_t(s);
+}
+MTL::PixelFormat MetalRenderTargetCache::ColorFormat(xenos::ColorRenderTargetFormat f) const {
+  // Match this SDK's Vulkan formats through its pinned MVKPixelFormats.mm.
+  // Apple GPU RG16/RGBA16 SNORM and RGBA16 UNORM have color-attachment support.
+  using F = xenos::ColorRenderTargetFormat;
+  switch (f) {
+    case F::k_8_8_8_8: return MTL::PixelFormatRGBA8Unorm;
+    case F::k_8_8_8_8_GAMMA:
+      return gamma_unorm16_ ? MTL::PixelFormatRGBA16Unorm : MTL::PixelFormatRGBA8Unorm;
+    case F::k_2_10_10_10:
+    case F::k_2_10_10_10_AS_10_10_10_10: return MTL::PixelFormatRGBA8Unorm;
+    case F::k_2_10_10_10_FLOAT:
+    case F::k_2_10_10_10_FLOAT_AS_16_16_16_16: return MTL::PixelFormatRGBA16Float;
+    case F::k_16_16: return MTL::PixelFormatRG16Snorm;
+    case F::k_16_16_16_16: return MTL::PixelFormatRGBA16Snorm;
+    case F::k_16_16_FLOAT: return MTL::PixelFormatRG16Float;
+    case F::k_16_16_16_16_FLOAT: return MTL::PixelFormatRGBA16Float;
+    case F::k_32_FLOAT: return MTL::PixelFormatR32Float;
+    case F::k_32_32_FLOAT: return MTL::PixelFormatRG32Float;
+    default: return MTL::PixelFormatInvalid;
+  }
+}
+MTL::PixelFormat MetalRenderTargetCache::TransferFormat(xenos::ColorRenderTargetFormat f) {
+  using F = xenos::ColorRenderTargetFormat;
+  switch (f) {
+    case F::k_16_16: case F::k_16_16_FLOAT: return MTL::PixelFormatRG16Uint;
+    case F::k_16_16_16_16: case F::k_16_16_16_16_FLOAT: return MTL::PixelFormatRGBA16Uint;
+    case F::k_32_FLOAT: return MTL::PixelFormatR32Uint;
+    case F::k_32_32_FLOAT: return MTL::PixelFormatRG32Uint;
+    default: return MTL::PixelFormatInvalid;  // Use the resource's float/unorm view.
+  }
+}
+RenderTargetCache::RenderTarget* MetalRenderTargetCache::CreateRenderTarget(RenderTargetKey key) {
+  uint32_t samples = Samples(key.msaa_samples);
+  if (!device_->supportsTextureSampleCount(samples)) return nullptr;
+  auto desc = Adopt(MTL::TextureDescriptor::alloc()->init());
+  desc->setTextureType(samples > 1 ? MTL::TextureType2DMultisample : MTL::TextureType2D);
+  desc->setPixelFormat(key.is_depth ? MTL::PixelFormatDepth32Float_Stencil8
+                                  : ColorFormat(key.GetColorFormat()));
+  if (desc->pixelFormat() == MTL::PixelFormatInvalid) return nullptr;
+  desc->setWidth(key.GetWidth());
+  desc->setHeight(GetRenderTargetHeight(key.pitch_tiles_at_32bpp, key.msaa_samples));
+  desc->setSampleCount(samples);
+  desc->setStorageMode(MTL::StorageModePrivate);
+  desc->setUsage(MTL::TextureUsageRenderTarget | MTL::TextureUsageShaderRead |
+                 MTL::TextureUsagePixelFormatView);
+  auto rt = std::make_unique<Target>(key);
+  rt->texture = device_->newTexture(desc.get());
+  if (!rt->texture) {
+    REXLOG_ERROR("Metal render target allocation failed: {}", key.GetDebugName());
+    return nullptr;
+  }
+  if (key.is_depth) {
+    rt->stencil = rt->texture->newTextureView(MTL::PixelFormatX32_Stencil8);
+    if (!rt->stencil) return nullptr;
+  } else {
+    auto format = TransferFormat(key.GetColorFormat());
+    if (format == MTL::PixelFormatInvalid) {
+      rt->transfer = rt->texture;
+      rt->transfer->retain();
+    } else {
+      rt->transfer = rt->texture->newTextureView(format);
+      if (!rt->transfer) return nullptr;
+    }
+  }
+  PERF_METAL_counter_add(kMetalRenderTargetsCreated, 1);
+  return rt.release();
+}
+MTL::PixelFormat MetalRenderTargetCache::depth_format() const {
+  return bound_[0] ? bound_[0]->texture->pixelFormat() : MTL::PixelFormatInvalid;
+}
+bool MetalRenderTargetCache::Update(bool rasterize, reg::RB_DEPTHCONTROL depth,
+                                    uint32_t color_mask, const Shader& vs) {
+  if (!RenderTargetCache::Update(rasterize, depth, color_mask, vs) || !submission_.Begin())
+    return false;
+  std::array<Target*, 5> targets{};
+  bool transfers = false;
+  for (uint32_t i = 0; i < targets.size(); ++i) {
+    targets[i] = static_cast<Target*>(last_update_accumulated_render_targets()[i]);
+    transfers |= !last_update_transfers()[i].empty();
+  }
+  auto surface = register_file().Get<reg::RB_SURFACE_INFO>();
+  uint32_t pitch = ((surface.surface_pitch << uint32_t(surface.msaa_samples >= xenos::MsaaSamples::k4X))
+                     + 79) / 80;
+  uint32_t width = std::max(1u, RenderTargetKey::GetWidth(pitch, surface.msaa_samples));
+  uint32_t height = std::max(1u, GetRenderTargetHeight(pitch, surface.msaa_samples));
+  uint32_t samples = Samples(surface.msaa_samples);
+  if (transfers) submission_.EndEncoding(perf::CounterId::kPassEndTransfer);
+  else if (bound_ != targets || width_ != width || height_ != height || samples_ != samples)
+    submission_.EndEncoding(perf::CounterId::kPassEndRtChange);
+  for (uint32_t i = 0; i < targets.size(); ++i) {
+    MTL::RenderCommandEncoder* transfer_encoder = nullptr;
+    for (const auto& transfer : last_update_transfers()[i]) {
+      if (!targets[i] || !TransferTo(*targets[i], transfer, transfer_encoder)) {
+        PERF_METAL_counter_add(kMetalRtTransfersSkipped, 1);
+        auto* source = static_cast<Target*>(transfer.source);
+        auto* host = static_cast<Target*>(transfer.host_depth_source);
+        // Disjoint reasons; their counters sum to metal_rt_transfers_skipped.
+        uint32_t mode = 0;
+        if (!targets[i] || !source || !source->initialized) mode = 1;
+        else if (host && (!targets[i]->key().is_depth || !host->initialized ||
+                 !host->key().is_depth ||
+                 host->key().resource_format != targets[i]->key().resource_format)) mode = 5;
+        switch (mode) {
+          case 1: PERF_METAL_counter_add(kMetalRtSkipUninitialized, 1); break;
+          case 5: PERF_METAL_counter_add(kMetalRtSkipHostDepth, 1); break;
+          default: PERF_METAL_counter_add(kMetalRtSkipBoundsOrFailure, 1); break;
+        }
+        if (!(transfer_warning_mask_ & (1u << mode))) {
+          transfer_warning_mask_ |= 1u << mode;
+          constexpr const char* names[] = {"bounds-or-GPU-failure", "uninitialized",
+              "color-depth", "32-64bpp", "sample-layout", "host-depth"};
+          REXLOG_WARN("Metal EDRAM skip: mode={}, src={}, dst={}, host={}, tiles=[{}, {})",
+              names[mode], source ? source->key().GetDebugName() : "none",
+              targets[i] ? targets[i]->key().GetDebugName() : "none",
+              host ? host->key().GetDebugName() : "none", transfer.start_tiles, transfer.end_tiles);
+        }
+      }
+    }
+    EndUtilityPass(transfer_encoder, false);
+  }
+  bound_ = targets;
+  width_ = width; height_ = height; samples_ = samples;
+  for (uint32_t i = 0; i < colors_.size(); ++i)
+    colors_[i] = bound_[i + 1] ? bound_[i + 1]->texture->pixelFormat() : MTL::PixelFormatInvalid;
+  return BeginPass();
+}
+bool MetalRenderTargetCache::BeginPass() {
+  if (submission_.encoder) return true;
+  auto* pass = MTL::RenderPassDescriptor::renderPassDescriptor();
+  pass->setRenderTargetWidth(width_);
+  pass->setRenderTargetHeight(height_);
+  pass->setDefaultRasterSampleCount(samples_);
+  for (uint32_t i = 0; i < bound_.size(); ++i) {
+    auto* rt = bound_[i];
+    if (!rt) continue;
+    if (!i) {
+      Attachment(pass->depthAttachment(), rt->texture, !rt->initialized);
+      pass->depthAttachment()->setClearDepth(1);
+      Attachment(pass->stencilAttachment(), rt->texture, !rt->initialized);
+      pass->stencilAttachment()->setClearStencil(0);
+    } else {
+      Attachment(pass->colorAttachments()->object(i - 1), rt->texture, !rt->initialized);
+      pass->colorAttachments()->object(i - 1)->setClearColor(MTL::ClearColor(0, 0, 0, 0));
+    }
+  }
+  auto* encoder = submission_.buffer()->renderCommandEncoder(pass);
+  if (!encoder) return false;
+  submission_.encoder = encoder;
+  encoder->retain();
+  for (auto* rt : bound_) if (rt) rt->initialized = true;
+  PERF_METAL_counter_add(kRenderPassesBegun, 1);
+  return true;
+}
+MTL::RenderPipelineState* MetalRenderTargetCache::TransferPipeline(
+    const Target& source, const Target& dest, const Target* host, bool preview) {
+  auto sk = source.key(), dk = dest.key();
+  bool host_depth = host != nullptr, host_depth_copy = host == &dest;
+  auto host_samples = host && !host_depth_copy ? host->key().msaa_samples : xenos::MsaaSamples::k1X;
+  bool depth = dk.is_depth && !preview;
+  bool source_uint = !sk.is_depth && TransferFormat(sk.GetColorFormat()) != MTL::PixelFormatInvalid;
+  bool dest_uint = !dk.is_depth && TransferFormat(dk.GetColorFormat()) != MTL::PixelFormatInvalid;
+  auto format = preview ? MTL::PixelFormatBGRA8Unorm :
+      depth ? MTL::PixelFormatDepth32Float_Stencil8 : dest.transfer->pixelFormat();
+  uint32_t samples = uint32_t(source.texture->sampleCount());
+  std::array<uint32_t, 6> key{sk.resource_format, dk.resource_format, samples,
+      uint32_t(depth) | (uint32_t(host_depth) << 1) | (uint32_t(preview) << 2) |
+          (uint32_t(host_depth_copy) << 3) | (uint32_t(sk.is_depth) << 4),
+      uint32_t(format), uint32_t(sk.msaa_samples) | (uint32_t(dk.msaa_samples) << 2) |
+          (uint32_t(host_samples) << 4)};
+  auto [it, inserted] = transfer_pipelines_.emplace(key, nullptr);
+  if (!inserted) return it->second;
+  std::string code = fmt::format(
+      "#define SRC_FORMAT {}\n#define DST_FORMAT {}\n#define MSAA {}\n"
+      "#define DEPTH {}\n#define SOURCE_UINT {}\n#define DEST_UINT {}\n"
+      "#define HOST_DEPTH {}\n#define PREVIEW {}\n#define GAMMA_16 {}\n"
+      "#define ROUND_DEPTH {}\n#define TWO_IN_FOUR {}\n",
+      uint32_t(sk.resource_format), uint32_t(dk.resource_format), uint32_t(samples > 1),
+      uint32_t(depth), uint32_t(source_uint), uint32_t(dest_uint), uint32_t(host_depth),
+      uint32_t(preview), uint32_t(gamma_unorm16_), uint32_t(depth_float24_round_),
+      uint32_t(sk.msaa_samples == xenos::MsaaSamples::k2X && samples == 4));
+  code += preview ? kRenderTargetMSL : kUtilityVertexMSL;
+  auto options = Adopt(MTL::CompileOptions::alloc()->init());
+  options->setLanguageVersion(MTL::LanguageVersion2_4);
+  options->setFastMathEnabled(false);
+  NS::Error* error = nullptr;
+  auto library = Adopt(device_->newLibrary(NS::String::string(code.c_str(), NS::UTF8StringEncoding),
+                                           options.get(), &error));
+  if (!library) {
+    PERF_METAL_counter_add(kMetalMslCompileFailures, 1);
+    REXLOG_ERROR("Metal RT shader compilation failed: {}", ErrorText(error));
+    return nullptr;
+  }
+  auto vertex = Adopt(library->newFunction(NS::String::string("rt_vertex", NS::UTF8StringEncoding)));
+  auto fragment = Adopt(library->newFunction(NS::String::string("rt_fragment", NS::UTF8StringEncoding)));
+  MetalFunction converted;
+  if (!preview) {
+    HostRenderTargetTransferShaderOptions options;
+    options.dest_msaa_samples = dk.msaa_samples;
+    options.source_msaa_samples = sk.msaa_samples;
+    options.host_depth_source_msaa_samples = host_samples;
+    options.dest_resource_format = dk.resource_format;
+    options.source_resource_format = sk.resource_format;
+    using Mode = HostRenderTargetTransferMode;
+    if (!depth) options.mode = sk.is_depth ? Mode::kDepthToColor : Mode::kColorToColor;
+    else if (!host_depth) options.mode = sk.is_depth ? Mode::kDepthToDepth : Mode::kColorToDepth;
+    else if (host_depth_copy) options.mode = sk.is_depth
+        ? Mode::kDepthAndHostDepthCopyToDepth : Mode::kColorAndHostDepthCopyToDepth;
+    else options.mode = sk.is_depth ? Mode::kDepthAndHostDepthToDepth : Mode::kColorAndHostDepthToDepth;
+    options.source_color_is_uint = source_uint;
+    options.dest_color_is_uint = dest_uint;
+    options.msaa_2x_attachments_supported = native_2x_;
+    options.gamma_render_target_as_unorm16 = gamma_unorm16_;
+    options.depth_float24_round = depth_float24_round_;
+    options.sample_rate_shading = true;
+    options.shader_stencil_export = true;
+    auto words = BuildHostRenderTargetTransferSpirv(options);
+    uint32_t sample_mask = dk.msaa_samples == xenos::MsaaSamples::k2X && !native_2x_
+        ? 0b1001u : UINT32_MAX;
+    bool compiled = host_depth
+        ? CompileUtilityMSL(device_, words.data(), words.size(), false, 8,
+            {{0, 0, 1, 2}, {1, 0, 0, 0}, {1, 1, 0, 1}}, converted, nullptr, sample_mask)
+        : CompileUtilityMSL(device_, words.data(), words.size(), false, 4,
+            {{0, 0, 0, 0}, {0, 1, 0, 1}}, converted, nullptr, sample_mask);
+    if (!compiled) return nullptr;
+  }
+  auto desc = Adopt(MTL::RenderPipelineDescriptor::alloc()->init());
+  desc->setVertexFunction(vertex.get());
+  desc->setFragmentFunction(preview ? fragment.get() : converted.function);
+  desc->setRasterSampleCount(preview ? 1 : Samples(dk.msaa_samples));
+  if (depth) {
+    desc->setDepthAttachmentPixelFormat(format);
+    desc->setStencilAttachmentPixelFormat(format);
+  } else {
+    desc->colorAttachments()->object(0)->setPixelFormat(format);
+  }
+  it->second = device_->newRenderPipelineState(desc.get(), &error);
+  if (!it->second) REXLOG_ERROR("Metal RT pipeline creation failed: {}", ErrorText(error));
+  else PERF_METAL_counter_add(kMetalPipelinesCreated, 1);
+  return it->second;
+}
+bool MetalRenderTargetCache::TransferTo(Target& dest, const Transfer& transfer,
+    MTL::RenderCommandEncoder*& encoder, const Transfer::Rectangle* cutout) {
+  auto* source = static_cast<Target*>(transfer.source);
+  auto* host = static_cast<Target*>(transfer.host_depth_source);
+  if (submission_.trace_resolves())
+    REXLOG_INFO("Metal trace frame={} transfer src={} dst={} host={} tiles=[{}, {}) cutout={}",
+                submission_.frame(), source ? source->key().GetDebugName() : "none",
+                dest.key().GetDebugName(), host ? host->key().GetDebugName() : "none",
+                transfer.start_tiles, transfer.end_tiles, cutout != nullptr);
+  if (!source || !source->initialized) return false;
+  auto dk = dest.key(), sk = source->key();
+  if (host && (!dk.is_depth || !host->initialized || !host->key().is_depth ||
+      host->key().GetDepthFormat() != dk.GetDepthFormat())) return false;
+  Transfer::Rectangle rectangles[Transfer::kMaxRectanglesWithCutout];
+  uint32_t count = transfer.GetRectangles(dk.base_tiles, dk.GetPitchTiles(), dk.msaa_samples,
+                                          dk.Is64bpp(), rectangles, cutout);
+  if (!count) return true;
+  // Validate every tile before encoding any writes. Pitch/base changes and EDRAM
+  // wrapping use the same 11-bit addressing in the shader as the common cache.
+  for (uint32_t tile = transfer.start_tiles; tile < transfer.end_tiles; ++tile) {
+    for (auto* rt : {&dest, source, host}) {
+      if (!rt) continue;
+      auto key = rt->key();
+      uint32_t local = (tile - key.base_tiles) & (xenos::kEdramTileCount - 1);
+      uint32_t pitch = key.GetPitchTiles();
+      uint32_t tw = 80u >> (uint32_t(key.Is64bpp()) +
+                            uint32_t(key.msaa_samples >= xenos::MsaaSamples::k4X));
+      uint32_t th = 16u >> uint32_t(key.msaa_samples >= xenos::MsaaSamples::k2X);
+      if (!pitch || (local % pitch + 1) * tw > rt->texture->width() ||
+          (local / pitch + 1) * th > rt->texture->height()) return false;
+    }
+  }
+  // Vulkan's host_depth_store_* preserves full precision when the old depth
+  // owner is also the destination. The transfer shader reads that saved buffer.
+  bool host_depth_copy = host == &dest;
+  if (host_depth_copy) {
+    EndUtilityPass(encoder, cutout != nullptr);
+    if (!StoreHostDepth(dest, transfer, cutout)) return false;
+  }
+  auto* pipeline = TransferPipeline(*source, dest, host, false);
+  if (!pipeline || (dk.is_depth && !EnsureTransferDepthState())) return false;
+  if (!encoder) {
+    auto* pass = MTL::RenderPassDescriptor::renderPassDescriptor();
+    if (dk.is_depth) {
+      Attachment(pass->depthAttachment(), dest.texture, !dest.initialized);
+      pass->depthAttachment()->setClearDepth(1);
+      Attachment(pass->stencilAttachment(), dest.texture, !dest.initialized);
+      pass->stencilAttachment()->setClearStencil(0);
+    } else {
+      Attachment(pass->colorAttachments()->object(0), dest.transfer, !dest.initialized);
+      pass->colorAttachments()->object(0)->setClearColor(MTL::ClearColor(0, 0, 0, 0));
+    }
+    encoder = submission_.buffer()->renderCommandEncoder(pass);
+    if (!encoder) return false;
+    PERF_METAL_counter_add(kRenderPassesBegun, 1);
+  }
+  encoder->setRenderPipelineState(pipeline);
+  if (dk.is_depth) encoder->setDepthStencilState(transfer_depth_state_);
+  encoder->setFragmentTexture(sk.is_depth ? source->texture : source->transfer, 0);
+  if (sk.is_depth) encoder->setFragmentTexture(source->stencil, 1);
+  if (host_depth_copy) encoder->setFragmentBuffer(edram_, 0, 1);
+  else if (host) encoder->setFragmentTexture(host->texture, 2);
+  auto address = [&](const Target& src) {
+    auto key = src.key();
+    constexpr uint32_t delta_mask = (1u << (xenos::kEdramBaseTilesBits + 1)) - 1;
+    return dk.GetPitchTiles() | (key.GetPitchTiles() << xenos::kEdramPitchTilesBits) |
+        (((uint32_t(dk.base_tiles) - uint32_t(key.base_tiles)) & delta_mask) <<
+            (2 * xenos::kEdramPitchTilesBits));
+  };
+  std::array<uint32_t, 2> constants{host ? address(*host) : address(*source), address(*source)};
+  encoder->setFragmentBytes(constants.data(), host ? 8 : 4, 0);
+  encoder->setViewport(MTL::Viewport{0, 0, double(dest.texture->width()),
+                                      double(dest.texture->height()), 0, 1});
+  for (uint32_t i = 0; i < count; ++i) {
+    auto r = rectangles[i];
+    encoder->setScissorRect(MTL::ScissorRect{r.x_pixels, r.y_pixels, r.width_pixels, r.height_pixels});
+    encoder->drawPrimitives(MTL::PrimitiveTypeTriangle, NS::UInteger(0), NS::UInteger(3));
+  }
+  // Reuse this destination pass for the remaining transfers and optional clear.
+  dest.initialized = true;
+  return true;
+}
+void MetalRenderTargetCache::MarkDraw(uint32_t mask, uint32_t width, uint32_t height) {
+  uint32_t used = GetLastUpdateBoundRenderTargets();
+  for (uint32_t i = 0; i < 4; ++i) {
+    if (!(used & (2u << i)) || !(mask & (15u << (4 * i)))) continue;
+    auto* rt = bound_[i + 1];
+    uint32_t w = std::min(width, uint32_t(rt->texture->width()));
+    uint32_t h = std::min(height, uint32_t(rt->texture->height()));
+    if (w && h && uint64_t(w) * h >= uint64_t(debug_width_) * debug_height_) {
+      debug_target_ = rt; debug_width_ = w; debug_height_ = h;
+    }
+  }
+}
+bool MetalRenderTargetCache::DebugPresent(MTL::CommandBuffer* buffer, MTL::Texture* output) {
+  if (!debug_target_ || !buffer || !output) return false;
+  auto* pipeline = TransferPipeline(*debug_target_, *debug_target_, nullptr, true);
+  if (!pipeline) return false;
+  auto* pass = MTL::RenderPassDescriptor::renderPassDescriptor();
+  auto* color = pass->colorAttachments()->object(0);
+  color->setTexture(output);
+  color->setLoadAction(MTL::LoadActionDontCare);
+  color->setStoreAction(MTL::StoreActionStore);
+  auto* encoder = buffer->renderCommandEncoder(pass);
+  if (!encoder) return false;
+  PERF_METAL_counter_add(kRenderPassesBegun, 1);
+  encoder->setRenderPipelineState(pipeline);
+  encoder->setFragmentTexture(debug_target_->texture, 0);
+  std::array<uint32_t, 12> constants{};
+  constants[8] = debug_width_; constants[9] = debug_height_;
+  constants[10] = uint32_t(output->width()); constants[11] = uint32_t(output->height());
+  encoder->setFragmentBytes(constants.data(), sizeof(constants), 0);
+  encoder->setViewport(MTL::Viewport{0, 0, double(output->width()), double(output->height()), 0, 1});
+  encoder->drawPrimitives(MTL::PrimitiveTypeTriangle, NS::UInteger(0), NS::UInteger(3));
+  encoder->endEncoding();
+  PERF_METAL_counter_add(kPassEndSwap, 1);
+  return true;
+}
+
+bool MetalRenderTargetCache::EnsureTransferDepthState() {
+  if (transfer_depth_state_) return true;
+  auto desc = Adopt(MTL::DepthStencilDescriptor::alloc()->init());
+  desc->setDepthCompareFunction(MTL::CompareFunctionAlways);
+  desc->setDepthWriteEnabled(true);
+  auto stencil = Adopt(MTL::StencilDescriptor::alloc()->init());
+  stencil->setStencilCompareFunction(MTL::CompareFunctionAlways);
+  stencil->setDepthStencilPassOperation(MTL::StencilOperationReplace);
+  stencil->setReadMask(255); stencil->setWriteMask(255);
+  desc->setFrontFaceStencil(stencil.get()); desc->setBackFaceStencil(stencil.get());
+  transfer_depth_state_ = device_->newDepthStencilState(desc.get());
+  return transfer_depth_state_ != nullptr;
+}
+bool MetalRenderTargetCache::UnsupportedResolve(uint32_t reason) {
+  PERF_METAL_counter_add(kMetalResolvesUnsupported, 1);
+  if (!(resolve_warning_mask_ & (1u << reason))) {
+    resolve_warning_mask_ |= 1u << reason;
+    constexpr const char* names[] = {"scaled", "copy-command", "destination-format",
+        "resolve-info", "destination-range", "dump-source", "clear-or-transfer",
+        "GPU-resource-or-pipeline"};
+    REXLOG_ERROR("Metal resolve rejected: {}", names[reason]);
+  }
+  return false;
+}
+bool MetalRenderTargetCache::EnsureEdram() {
+  if (!submission_.Begin()) return false;
+  submission_.EndEncoding(perf::CounterId::kPassEndResolve);
+  if (!edram_) {
+    edram_ = device_->newBuffer(xenos::kEdramSizeBytes,
+        MTL::ResourceStorageModePrivate | MTL::ResourceHazardTrackingModeTracked);
+    if (!edram_) return false;
+  }
+  if (!edram_zeroed_) {
+    auto* blit = submission_.buffer()->blitCommandEncoder();
+    if (!blit) return false;
+    blit->fillBuffer(edram_, NS::Range::Make(0, xenos::kEdramSizeBytes), 0);
+    blit->endEncoding();
+    edram_zeroed_ = true;
+  }
+  return true;
+}
+const MetalRenderTargetCache::Compute& MetalRenderTargetCache::GetCompute(
+    uint32_t key, const uint32_t* words, size_t count, uint32_t push_size, bool source_images) {
+  auto [it, inserted] = compute_.try_emplace(key);
+  if (!inserted) return it->second;
+  auto& entry = it->second;
+  MetalFunction function;
+  function.hash = key;
+  bool compiled = source_images
+      ? CompileUtilityMSL(device_, words, count, true, push_size,
+          {{0, 0, 1, 0}, {1, 0, 0, 0}, {1, 1, 0, 1}}, function, &entry.group)
+      : CompileUtilityMSL(device_, words, count, true, push_size,
+          {{0, 0, 1, 0}, {1, 0, 2, 0}}, function, &entry.group);
+  if (!compiled) return entry;
+  NS::Error* error = nullptr;
+  entry.pipeline = device_->newComputePipelineState(function.function, &error);
+  if (!entry.pipeline) REXLOG_ERROR("Metal resolve pipeline {} failed: {}", key, ErrorText(error));
+  else if (uint64_t(entry.group[0]) * entry.group[1] * entry.group[2] >
+           entry.pipeline->maxTotalThreadsPerThreadgroup()) {
+    REXLOG_ERROR("Metal resolve pipeline {} exceeds device workgroup limit", key);
+    ReleaseObject(entry.pipeline);
+  } else PERF_METAL_counter_add(kMetalPipelinesCreated, 1);
+  return entry;
+}
+bool MetalRenderTargetCache::DumpRenderTargets(const draw_util::ResolveInfo& info) {
+  if (!EnsureEdram()) return false;
+  uint32_t base, row_length, rows, pitch;
+  info.GetCopyEdramTileSpan(base, row_length, rows, pitch);
+  std::vector<ResolveCopyDumpRectangle> rectangles;
+  GetResolveCopyRectanglesToDump(base, row_length, rows, pitch, rectangles);
+  for (const auto& rectangle : rectangles) {
+    auto* target = static_cast<Target*>(rectangle.render_target);
+    if (!target || !target->initialized) return false;
+    auto key = target->key();
+    if (submission_.trace_resolves())
+      REXLOG_INFO("Metal trace frame={} dump owner={} host={}x{} samples={} dump-base={} "
+                  "row-tiles={} rows={} pitch-tiles={}",
+                  submission_.frame(), key.GetDebugName(), target->texture->width(),
+                  target->texture->height(), target->texture->sampleCount(), base, row_length, rows, pitch);
+    uint32_t shader_key = 0x1000 | uint32_t(key.msaa_samples) |
+        (uint32_t(key.resource_format) << 2) | (uint32_t(key.is_depth) << 6);
+    auto cached = compute_.find(shader_key);
+    if (cached == compute_.end()) {
+      HostRenderTargetDumpShaderOptions options;
+      options.msaa_samples = key.msaa_samples;
+      options.resource_format = key.resource_format;
+      options.is_depth = key.is_depth;
+      options.msaa_2x_attachments_supported = native_2x_;
+      options.gamma_render_target_as_unorm16 = gamma_unorm16_;
+      options.depth_float24_round = depth_float24_round_;
+      options.source_color_is_uint = !key.is_depth &&
+          TransferFormat(key.GetColorFormat()) != MTL::PixelFormatInvalid;
+      auto words = BuildHostRenderTargetDumpSpirv(options);
+      GetCompute(shader_key, words.data(), words.size(), 8, true);
+    }
+    const auto& compute = compute_.at(shader_key);
+    if (!compute.pipeline) return false;
+    auto* encoder = submission_.buffer()->computeCommandEncoder();
+    if (!encoder) return false;
+    encoder->setComputePipelineState(compute.pipeline);
+    encoder->setBuffer(edram_, 0, 1);
+    encoder->setTexture(key.is_depth ? target->texture : target->transfer, 0);
+    if (key.is_depth) encoder->setTexture(target->stencil, 1);
+    ResolveCopyDumpRectangle::Dispatch dispatches[ResolveCopyDumpRectangle::kMaxDispatches];
+    uint32_t count = rectangle.GetDispatches(pitch, row_length, dispatches);
+    for (uint32_t i = 0; i < count; ++i) {
+      const auto& dispatch = dispatches[i];
+      // Vulkan DumpPitches and DumpOffsets, preserving wrapping's extra bit.
+      std::array<uint32_t, 2> constants{
+          pitch | (key.GetPitchTiles() << xenos::kEdramPitchTilesBits),
+          ((base + dispatch.offset) & ((1u << (xenos::kEdramBaseTilesBits + 1)) - 1)) |
+              (uint32_t(key.base_tiles) << (xenos::kEdramBaseTilesBits + 1))};
+      encoder->setBytes(constants.data(), sizeof(constants), 0);
+      encoder->dispatchThreadgroups(MTL::Size(
+          ((xenos::kEdramTileWidthSamples >> uint32_t(key.Is64bpp())) * dispatch.width_tiles +
+            compute.group[0] - 1) / compute.group[0],
+          (xenos::kEdramTileHeightSamples * dispatch.height_tiles + compute.group[1] - 1) /
+            compute.group[1], 1),
+          MTL::Size(compute.group[0], compute.group[1], compute.group[2]));
+    }
+    encoder->endEncoding();
+  }
+  // Tracked resources order dump writes before the separate resolve encoder.
+  return true;
+}
+bool MetalRenderTargetCache::StoreHostDepth(Target& target, const Transfer& transfer,
+    const Transfer::Rectangle* cutout) {
+  if (!EnsureEdram()) return false;
+  auto key = target.key();
+  const auto& code = kHostDepthStoreShaders[size_t(key.msaa_samples)];
+  const auto& compute = GetCompute(0x100 + uint32_t(key.msaa_samples),
+      code.words, code.count, sizeof(HostDepthStoreConstants), true);
+  if (!compute.pipeline) return false;
+  auto* encoder = submission_.buffer()->computeCommandEncoder();
+  if (!encoder) return false;
+  encoder->setComputePipelineState(compute.pipeline);
+  encoder->setBuffer(edram_, 0, 1);
+  encoder->setTexture(target.texture, 0);
+  HostDepthStoreConstants constants{};
+  constants.render_target =
+      GetHostDepthStoreRenderTargetConstant(key.pitch_tiles_at_32bpp, native_2x_);
+  Transfer::Rectangle rectangles[Transfer::kMaxRectanglesWithCutout];
+  uint32_t count = transfer.GetRectangles(key.base_tiles, key.GetPitchTiles(),
+                                          key.msaa_samples, false, rectangles, cutout);
+  for (uint32_t i = 0; i < count; ++i) {
+    uint32_t groups_x, groups_y;
+    GetHostDepthStoreRectangleInfo(rectangles[i], key.msaa_samples, constants.rectangle,
+                                   groups_x, groups_y);
+    encoder->setBytes(&constants, sizeof(constants), 0);
+    encoder->dispatchThreadgroups(MTL::Size(groups_x, groups_y, 1),
+        MTL::Size(compute.group[0], compute.group[1], compute.group[2]));
+  }
+  encoder->endEncoding();
+  return true;
+}
+
+bool MetalRenderTargetCache::ClearResolveTarget(
+    Target& target, const Transfer::Rectangle& rectangle, uint64_t value,
+    MTL::RenderCommandEncoder*& encoder) {
+  auto key = target.key();
+  if (!rectangle.width_pixels || !rectangle.height_pixels) return true;
+  if (uint64_t(rectangle.x_pixels) + rectangle.width_pixels > target.texture->width() ||
+      uint64_t(rectangle.y_pixels) + rectangle.height_pixels > target.texture->height()) return false;
+  if (submission_.trace_resolves())
+    REXLOG_INFO("Metal trace frame={} clear target={} rect={},{}+{}x{} value={:016X} reuse-pass={}",
+                submission_.frame(), key.GetDebugName(), rectangle.x_pixels, rectangle.y_pixels,
+                rectangle.width_pixels, rectangle.height_pixels, value, encoder != nullptr);
+  bool uint_color = !key.is_depth && TransferFormat(key.GetColorFormat()) != MTL::PixelFormatInvalid;
+  std::array<uint32_t, 4> bits{};
+  auto set_float = [&](uint32_t index, float component) {
+    std::memcpy(&bits[index], &component, sizeof(component));
+  };
+  if (key.is_depth) {
+    uint32_t depth = (uint32_t(value) >> 8) & 0xFFFFFF;
+    set_float(0, key.GetDepthFormat() == xenos::DepthRenderTargetFormat::kD24S8
+        ? xenos::UNorm24To32(depth) : xenos::Float20e4To32(depth) * 0.5f);
+    bits[1] = uint32_t(value) & 255;
+  } else {
+    using F = xenos::ColorRenderTargetFormat;
+    switch (key.GetColorFormat()) {
+      case F::k_8_8_8_8: case F::k_8_8_8_8_GAMMA:
+        for (uint32_t i = 0; i < 4; ++i) {
+          float component = float((value >> (i * 8)) & 255) / 255.0f;
+          if (i < 3 && key.GetColorFormat() == F::k_8_8_8_8_GAMMA && gamma_unorm16_)
+            component = xenos::PWLGammaToLinear(component);
+          set_float(i, component);
+        }
+        break;
+      case F::k_2_10_10_10: case F::k_2_10_10_10_AS_10_10_10_10:
+      case F::k_2_10_10_10_FLOAT: case F::k_2_10_10_10_FLOAT_AS_16_16_16_16:
+        for (uint32_t i = 0; i < 3; ++i) {
+          uint32_t component = uint32_t((value >> (i * 10)) & 1023);
+          set_float(i, key.GetColorFormat() == F::k_2_10_10_10_FLOAT ||
+              key.GetColorFormat() == F::k_2_10_10_10_FLOAT_AS_16_16_16_16
+                  ? xenos::Float7e3To32(component) : float(component) / 1023.0f);
+        }
+        set_float(3, float((value >> 30) & 3) / 3.0f);
+        break;
+      case F::k_16_16: case F::k_16_16_16_16:
+      case F::k_16_16_FLOAT: case F::k_16_16_16_16_FLOAT:
+        // Clear through integer transfer views to preserve all guest bits.
+        for (uint32_t i = 0; i < 4; ++i) bits[i] = uint32_t((value >> (i * 16)) & 65535);
+        break;
+      case F::k_32_FLOAT: case F::k_32_32_FLOAT:
+        bits[0] = uint32_t(value); bits[1] = uint32_t(value >> 32);
+        break;
+      default: return false;
+    }
+  }
+  auto format = key.is_depth ? target.texture->pixelFormat() : target.transfer->pixelFormat();
+  uint64_t pipeline_key = uint64_t(format) | (uint64_t(Samples(key.msaa_samples)) << 32);
+  auto [it, inserted] = clear_pipelines_.emplace(pipeline_key, nullptr);
+  if (inserted) {
+    std::string source = fmt::format("#define CLEAR_DEPTH {}\n#define CLEAR_UINT {}\n",
+                                     uint32_t(key.is_depth), uint32_t(uint_color));
+    source += kUtilityVertexMSL;
+    source += R"MSL(
+#if CLEAR_DEPTH
+struct ClearOut { float depth [[depth(any)]]; uint stencil [[stencil]]; };
+fragment ClearOut rt_clear(constant uint4& value [[buffer(0)]]) {
+  return {as_type<float>(value.x), value.y};
+}
+#elif CLEAR_UINT
+fragment uint4 rt_clear(constant uint4& value [[buffer(0)]]) { return value; }
+#else
+fragment float4 rt_clear(constant uint4& value [[buffer(0)]]) { return as_type<float4>(value); }
+#endif
+)MSL";
+    auto options = Adopt(MTL::CompileOptions::alloc()->init());
+    options->setLanguageVersion(MTL::LanguageVersion2_4);
+    options->setFastMathEnabled(false);
+    NS::Error* error = nullptr;
+    auto library = Adopt(device_->newLibrary(
+        NS::String::string(source.c_str(), NS::UTF8StringEncoding), options.get(), &error));
+    if (!library) {
+      PERF_METAL_counter_add(kMetalMslCompileFailures, 1);
+      REXLOG_ERROR("Metal resolve clear shader failed: {}", ErrorText(error));
+      return false;
+    }
+    auto vertex = Adopt(library->newFunction(NS::String::string("rt_vertex", NS::UTF8StringEncoding)));
+    auto fragment = Adopt(library->newFunction(NS::String::string("rt_clear", NS::UTF8StringEncoding)));
+    auto desc = Adopt(MTL::RenderPipelineDescriptor::alloc()->init());
+    desc->setVertexFunction(vertex.get()); desc->setFragmentFunction(fragment.get());
+    desc->setRasterSampleCount(Samples(key.msaa_samples));
+    if (key.is_depth) {
+      desc->setDepthAttachmentPixelFormat(format);
+      desc->setStencilAttachmentPixelFormat(format);
+    } else desc->colorAttachments()->object(0)->setPixelFormat(format);
+    it->second = device_->newRenderPipelineState(desc.get(), &error);
+    if (!it->second) REXLOG_ERROR("Metal resolve clear pipeline failed: {}", ErrorText(error));
+    else PERF_METAL_counter_add(kMetalPipelinesCreated, 1);
+  }
+  if (!it->second || (key.is_depth && !EnsureTransferDepthState())) return false;
+  if (!encoder) {
+    auto* pass = MTL::RenderPassDescriptor::renderPassDescriptor();
+    if (key.is_depth) {
+      Attachment(pass->depthAttachment(), target.texture, !target.initialized);
+      pass->depthAttachment()->setClearDepth(1);
+      Attachment(pass->stencilAttachment(), target.texture, !target.initialized);
+      pass->stencilAttachment()->setClearStencil(0);
+    } else {
+      Attachment(pass->colorAttachments()->object(0), target.transfer, !target.initialized);
+      pass->colorAttachments()->object(0)->setClearColor(MTL::ClearColor(0, 0, 0, 0));
+    }
+    encoder = submission_.buffer()->renderCommandEncoder(pass);
+    if (!encoder) return false;
+    PERF_METAL_counter_add(kRenderPassesBegun, 1);
+  }
+  encoder->setRenderPipelineState(it->second);
+  if (key.is_depth) encoder->setDepthStencilState(transfer_depth_state_);
+  encoder->setFragmentBytes(bits.data(), sizeof(bits), 0);
+  encoder->setViewport(MTL::Viewport{0, 0, double(target.texture->width()),
+                                    double(target.texture->height()), 0, 1});
+  encoder->setScissorRect(MTL::ScissorRect{rectangle.x_pixels, rectangle.y_pixels,
+                                         rectangle.width_pixels, rectangle.height_pixels});
+  encoder->drawPrimitives(MTL::PrimitiveTypeTriangle, NS::UInteger(0), NS::UInteger(3));
+  target.initialized = true;
+  return true;
+}
+
+bool MetalRenderTargetCache::Resolve(const memory::Memory& memory, MetalSharedMemory& shared,
+    MetalTextureCache& textures, uint32_t& written_address, uint32_t& written_length) {
+  PERF_METAL_counter_add(kMetalResolves, 1);
+  written_address = written_length = 0;
+  // The caches and shader translator stay at 1x. Reject scaled requests rather
+  // than writing unscaled data and claiming that the configured scale worked.
+  if (IsDrawResolutionScaled() || REXCVAR_GET(draw_resolution_scale_x) > 1 ||
+      REXCVAR_GET(draw_resolution_scale_y) > 1) return UnsupportedResolve(0);
+  auto control = register_file().Get<reg::RB_COPY_CONTROL>();
+  if (control.copy_command != xenos::CopyCommand::kRaw &&
+      control.copy_command != xenos::CopyCommand::kConvert) return UnsupportedResolve(1);
+  if (control.copy_src_select < xenos::kMaxColorRenderTargets &&
+      FormatInfo::Get(xenos::TextureFormat(register_file().Get<reg::RB_COPY_DEST_INFO>().
+          copy_dest_format))->type != FormatType::kResolvable) return UnsupportedResolve(2);
+  draw_util::ResolveInfo info{};
+  bool fixed16_truncated = !REXCVAR_GET(snorm16_render_target_full_range);
+  if (!draw_util::GetResolveInfo(register_file(), memory, 1, 1,
+                                 fixed16_truncated, fixed16_truncated, info))
+    return UnsupportedResolve(3);
+  if (submission_.trace_resolves()) {
+    const auto source = info.IsCopyingDepth() ? info.depth_edram_info : info.color_edram_info;
+    REXLOG_INFO("Metal trace frame={} resolve depth={} src-base={} pitch-tiles={} format={} msaa={} "
+                "size={}x{} dst={:08X} range={:08X}+{} dst-pitch={} dst-height={} "
+                "dst-format={} endian={} swap-rb={} tiled=1 array={} sample={} "
+                "dst-info={:08X} coords={:08X} clear-color={} clear-depth={} epoch={}",
+                submission_.frame(), info.IsCopyingDepth(), uint32_t(source.base_tiles),
+                uint32_t(source.pitch_tiles), uint32_t(source.format), uint32_t(source.msaa_samples),
+                uint32_t(info.coordinate_info.width_div_8) << 3, info.height_div_8 << 3,
+                info.copy_dest_base, info.copy_dest_extent_start, info.copy_dest_extent_length,
+                uint32_t(info.copy_dest_coordinate_info.pitch_aligned_div_32) << 5,
+                uint32_t(info.copy_dest_coordinate_info.height_aligned_div_32) << 5,
+                uint32_t(info.copy_dest_info.copy_dest_format), uint32_t(info.copy_dest_info.copy_dest_endian),
+                uint32_t(info.copy_dest_info.copy_dest_swap), uint32_t(info.copy_dest_info.copy_dest_array),
+                uint32_t(info.copy_dest_coordinate_info.copy_sample_select), info.copy_dest_info.value, info.copy_dest_coordinate_info.packed,
+                info.IsClearingColor(), info.IsClearingDepth(), submission_.epoch());
+  }
+  if (!info.coordinate_info.width_div_8 || !info.height_div_8) return true;
+  if (!info.copy_dest_extent_length && !info.IsClearingDepth() && !info.IsClearingColor()) return true;
+  if (!submission_.Begin()) return UnsupportedResolve(7);
+  submission_.EndEncoding(perf::CounterId::kPassEndResolve);
+  if (info.copy_dest_extent_length) {
+    draw_util::ResolveCopyShaderConstants constants{};
+    uint32_t groups_x, groups_y;
+    auto shader = info.GetCopyShader(1, 1, constants, groups_x, groups_y);
+    if (shader == draw_util::ResolveCopyShaderIndex::kUnknown) return UnsupportedResolve(2);
+    const auto& code = kResolveShaders[size_t(shader)];
+    const auto& compute = GetCompute(uint32_t(shader), code.words, code.count,
+                                     sizeof(constants), false);
+    if (!compute.pipeline) return UnsupportedResolve(7);
+    if (!shared.RequestRangeForGpuWrite(info.copy_dest_extent_start, info.copy_dest_extent_length))
+      return UnsupportedResolve(4);
+    // A CPU upload hazard may have submitted the previous command buffer.
+    if (!submission_.Begin() || !DumpRenderTargets(info)) return UnsupportedResolve(5);
+    auto* encoder = submission_.buffer()->computeCommandEncoder();
+    if (!encoder) return UnsupportedResolve(7);
+    encoder->setComputePipelineState(compute.pipeline);
+    encoder->setBuffer(edram_, 0, 1);
+    encoder->setBuffer(shared.buffer(), 0, 2);
+    // Bind the full 512 MiB guest buffer: dest_base remains the guest byte
+    // address (Vulkan subtracts a per-resolve buffer binding offset instead).
+    encoder->setBytes(&constants, sizeof(constants), 0);
+    encoder->dispatchThreadgroups(MTL::Size(groups_x, groups_y, 1),
+        MTL::Size(compute.group[0], compute.group[1], compute.group[2]));
+    encoder->endEncoding();
+    shared.MarkGpuWrittenRange(info.copy_dest_extent_start, info.copy_dest_extent_length);
+    textures.MarkRangeAsResolved(info.copy_dest_extent_start, info.copy_dest_extent_length);
+    if (submission_.trace_resolves())
+      REXLOG_INFO("Metal trace frame={} resolved+invalidated range={:08X}+{} shader={} epoch={}",
+                  submission_.frame(), info.copy_dest_extent_start, info.copy_dest_extent_length,
+                  uint32_t(shader), submission_.epoch());
+    written_address = info.copy_dest_extent_start;
+    written_length = info.copy_dest_extent_length;
+  }
+  if (info.IsClearingDepth() || info.IsClearingColor()) {
+    Transfer::Rectangle rectangle{};
+    RenderTarget* targets[2]{};
+    std::vector<Transfer> transfers[2];
+    // The common helper changes ownership; discard the accumulated draw set.
+    ResetAccumulatedRenderTargets();
+    if (!PrepareHostRenderTargetsResolveClear(info, rectangle, targets[0], transfers[0],
+                                              targets[1], transfers[1]))
+      return UnsupportedResolve(6);
+    const uint64_t values[] = {info.rb_depth_clear,
+        info.rb_color_clear | (uint64_t(info.rb_color_clear_lo) << 32)};
+    for (uint32_t i = 0; i < 2; ++i) {
+      if (!targets[i]) continue;
+      auto& target = *static_cast<Target*>(targets[i]);
+      MTL::RenderCommandEncoder* encoder = nullptr;
+      bool success = true;
+      for (const auto& transfer : transfers[i]) {
+        if (!TransferTo(target, transfer, encoder, &rectangle)) { success = false; break; }
+      }
+      if (success) success = ClearResolveTarget(target, rectangle, values[i], encoder);
+      EndUtilityPass(encoder, true);
+      if (!success) return UnsupportedResolve(6);
+    }
+  }
+  return true;
+}
+
