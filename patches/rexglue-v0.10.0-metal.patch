+#include <rex/ui/metal/provider.h>
+#if defined(__APPLE__) && defined(REX_HAS_METAL) && REX_HAS_METAL
+
+#include <utility>
+#include <rex/ui/metal/immediate_drawer.h>
+#include <rex/ui/metal/presenter.h>
+#include "metal_util.h"
+
+namespace rex::ui::metal {
+std::unique_ptr<MetalProvider> MetalProvider::Create() {
+  auto pool = Adopt(NS::AutoreleasePool::alloc()->init());
+  auto provider = std::unique_ptr<MetalProvider>(new MetalProvider());
+  provider->device_ = MTL::CreateSystemDefaultDevice();
+  if (!provider->device_) {
+    REXLOG_ERROR("Metal: no system default device");
+    return nullptr;
+  }
+  provider->queue_ = provider->device_->newCommandQueue();
+  if (!provider->queue_) {
+    REXLOG_ERROR("Metal: command queue creation failed");
+    return nullptr;
+  }
+  auto* device = provider->device_;
+  REXLOG_INFO("GPU backend: Metal (native), device {}", device->name()->utf8String());
+  REXLOG_INFO("Metal families: apple7={}, metal3={}, metal4={}",
+              device->supportsFamily(MTL::GPUFamilyApple7),
+              device->supportsFamily(MTL::GPUFamilyMetal3),
+              device->supportsFamily(MTL::GPUFamilyMetal4));
+  return provider;
+}
+
+MetalProvider::~MetalProvider() {
+  ReleaseObject(queue_);
+  ReleaseObject(device_);
+}
+
+std::unique_ptr<Presenter> MetalProvider::CreatePresenter(
+    Presenter::HostGpuLossCallback callback) {
+  auto presenter = std::make_unique<MetalPresenter>(*this, std::move(callback));
+  if (!presenter->Initialize()) return nullptr;
+  return presenter;
+}
+
+std::unique_ptr<ImmediateDrawer> MetalProvider::CreateImmediateDrawer() {
+  auto drawer = std::make_unique<MetalImmediateDrawer>(*this);
+  if (!drawer->Initialize()) return nullptr;
+  return drawer;
+}
+}  // namespace rex::ui::metal
+#endif
