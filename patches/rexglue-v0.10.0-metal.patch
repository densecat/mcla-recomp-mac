+#pragma once
+#if defined(__APPLE__) && defined(REX_HAS_METAL) && REX_HAS_METAL
+
+#include <memory>
+#include <Foundation/Foundation.hpp>
+#include <Metal/Metal.hpp>
+#include <rex/logging.h>
+
+namespace rex::ui::metal {
+struct ObjectReleaser {
+  template <typename T>
+  void operator()(T* object) const { if (object) object->release(); }
+};
+template <typename T>
+auto Adopt(T* object) {
+  return std::unique_ptr<T, ObjectReleaser>(object);
+}
+template <typename T>
+void ReleaseObject(T*& object) {
+  if (object) object->release();
+  object = nullptr;
+}
+inline const char* ErrorText(NS::Error* error) {
+  auto* description = error ? error->localizedDescription() : nullptr;
+  const char* text = description ? description->utf8String() : nullptr;
+  return text ? text : "unknown error";
+}
+inline bool WaitForSubmission(MTL::CommandBuffer* buffer) {
+  buffer->waitUntilCompleted();
+  if (buffer->status() == MTL::CommandBufferStatusCompleted) return true;
+  REXLOG_ERROR("Metal submission failed: {}", ErrorText(buffer->error()));
+  return false;
+}
+}  // namespace rex::ui::metal
