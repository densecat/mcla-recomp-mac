diff --git a/cmake/rexglue_metal.cmake b/cmake/rexglue_metal.cmake
new file mode 100644
index 0000000..e94d794
--- /dev/null
+++ b/cmake/rexglue_metal.cmake
@@ -0,0 +1,15 @@
+# Headers only; the implementation is compiled once, into rexruntime via rexui.
+include(FetchContent)
+FetchContent_Declare(rexglue_metal_cpp
+    GIT_REPOSITORY https://github.com/apple/metal-cpp.git
+    GIT_TAG 27c4382b7151d55a51692cdcb27aaa98752240de
+    GIT_SHALLOW FALSE
+    SOURCE_SUBDIR rexglue-headers-only
+)
+FetchContent_MakeAvailable(rexglue_metal_cpp)
+set(REXGLUE_METAL_CPP_INCLUDE_DIR "${rexglue_metal_cpp_SOURCE_DIR}")
+set(REXGLUE_METAL_FRAMEWORKS
+    "-framework Metal"
+    "-framework QuartzCore"
+    "-framework Foundation"
+)
