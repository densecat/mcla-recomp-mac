+#include <rex/graphics/pipeline/render_target/cache.h>
+
+namespace rex::graphics::metal {
+class MetalRenderTargetCache final : public RenderTargetCache {
+ public:
+  MetalRenderTargetCache(const RegisterFile& regs, const memory::Memory& memory,
+                        MTL::Device* device, MetalSubmission& submission);
+  ~MetalRenderTargetCache() override;
+  Path GetPath() const override { return Path::kHostRenderTargets; }
+  void ClearCache() override;
+  void BeginFrame() override;
+  bool Update(bool rasterize, reg::RB_DEPTHCONTROL depth, uint32_t color_mask,
+              const Shader& vertex_shader) override;
+  const std::array<MTL::PixelFormat, 4>& color_formats() const { return colors_; }
+  MTL::PixelFormat depth_format() const;
+  uint32_t samples() const { return samples_; }
+  uint32_t width() const { return width_; }
+  uint32_t height() const { return height_; }
+  bool gamma_unorm16() const { return gamma_unorm16_; }
+  bool depth_float24_convert() const { return depth_float24_convert_; }
+  bool depth_float24_round() const { return depth_float24_round_; }
+  void MarkDraw(uint32_t color_mask, uint32_t width, uint32_t height);
+  bool has_debug_target() const { return debug_target_ != nullptr; }
+  // Encodes only. The presenter owns commit/wait and publishes after completion.
+  bool DebugPresent(MTL::CommandBuffer* buffer, MTL::Texture* output);
+
+ protected:
+  bool IsGammaFormatHostStorageSeparate() const override { return gamma_unorm16_; }
+  bool IsHostDepthEncodingDifferent(xenos::DepthRenderTargetFormat format) const override;
+  uint32_t GetMaxRenderTargetWidth() const override { return 16384; }
+  uint32_t GetMaxRenderTargetHeight() const override { return 16384; }
+  RenderTarget* CreateRenderTarget(RenderTargetKey key) override;
+
+ private:
+  struct Target final : RenderTarget {
+    explicit Target(RenderTargetKey key) : RenderTarget(key) {}
+    ~Target() override;
+    MTL::Texture* texture = nullptr;
+    MTL::Texture* transfer = nullptr;
+    MTL::Texture* stencil = nullptr;
+    bool initialized = false;
+  };
+  MTL::PixelFormat ColorFormat(xenos::ColorRenderTargetFormat format) const;
+  static MTL::PixelFormat TransferFormat(xenos::ColorRenderTargetFormat format);
+  uint32_t Samples(xenos::MsaaSamples samples) const;
+  MTL::RenderPipelineState* TransferPipeline(const Target& source, const Target& dest,
+                                            bool host_depth, bool preview);
+  bool TransferTo(Target& dest, const Transfer& transfer);
+  bool BeginPass();
+  MTL::Device* device_;
+  MetalSubmission& submission_;
+  const bool gamma_unorm16_, depth_float24_convert_, depth_float24_round_, native_2x_;
+  std::array<Target*, 5> bound_{};
+  std::array<MTL::PixelFormat, 4> colors_{};
+  uint32_t width_ = 1, height_ = 1, samples_ = 1;
+  Target* debug_target_ = nullptr;
+  uint32_t debug_width_ = 0, debug_height_ = 0;
+  MTL::DepthStencilState* transfer_depth_state_ = nullptr;
+  std::map<std::array<uint32_t, 6>, MTL::RenderPipelineState*> transfer_pipelines_;
+  bool transfer_warning_logged_ = false;
+};
+}  // namespace rex::graphics::metal
+#endif
diff --git a/include/rex/graphics/metal/resources.h b/include/rex/graphics/metal/resources.h
new file mode 100644
index 0000000..533cdfd
--- /dev/null
+++ b/include/rex/graphics/metal/resources.h
@@ -0,0 +1,91 @@
+#pragma once
+#if defined(__APPLE__) && defined(REX_HAS_METAL) && REX_HAS_METAL
+
+#include <Metal/Metal.hpp>
+#include <array>
+#include <deque>
+#include <vector>
+#include <rex/perf/counter.h>
+#include <rex/graphics/primitive_processor.h>
+#include <rex/graphics/shared_memory.h>
+
+namespace rex::graphics::metal {
+// CP-thread-owned. The signal is the final command in each submission.
+class MetalSubmission {
+ public:
+  MetalSubmission(MTL::Device* device, MTL::CommandQueue* queue);
+  ~MetalSubmission();
+  bool Initialize();
+  bool Begin();
+  bool Submit(perf::CounterId reason = perf::CounterId::kPassEndOther);
+  bool Poll();
+  bool BeforeUpload(uint64_t last_use);
+  void EndEncoding(perf::CounterId reason = perf::CounterId::kPassEndOther);
+  void Finish();
+  bool AllocateConstants(size_t size, MTL::Buffer*& buffer, size_t& offset);
+  uint64_t epoch() const { return epoch_; }
+  MTL::CommandBuffer* buffer() const { return buffer_; }
+  MTL::RenderCommandEncoder* encoder = nullptr;  // Retained until EndEncoding.
+
+ private:
+  bool Wait(uint64_t epoch);
+  struct Pending {
+    uint64_t epoch;
+    MTL::CommandBuffer* buffer;
+    MTL::Buffer* uniforms;
+  };
+  MTL::Device* device_;
+  MTL::CommandQueue* queue_;
+  MTL::SharedEvent* event_ = nullptr;
+  MTL::SharedEventListener* listener_ = nullptr;
+  MTL::CommandBuffer* buffer_ = nullptr;
+  MTL::Buffer* uniforms_ = nullptr;
+  size_t uniform_offset_ = 0;
+  uint64_t epoch_ = 1;
+  bool failed_ = false;
+  std::deque<Pending> pending_;
+  std::vector<MTL::Buffer*> free_uniforms_;
+};
+
+class MetalSharedMemory final : public SharedMemory {
+ public:
+  MetalSharedMemory(memory::Memory& memory, MetalSubmission& submission)
+      : SharedMemory(memory), submission_(submission) {}
+  ~MetalSharedMemory() override;
+  bool Initialize(MTL::Device* device);
+  MTL::Buffer* buffer() const { return buffer_; }
+  void MarkUsed(uint32_t start, uint32_t length);
+ protected:
+  bool UploadRanges(const std::vector<std::pair<uint32_t, uint32_t>>& ranges) override;
+  bool UploadByteRanges(const std::vector<std::pair<uint32_t, uint32_t>>& ranges) override;
+ private:
+  bool Copy(uint32_t start, uint32_t length, bool make_valid);
+  MetalSubmission& submission_;
+  MTL::Buffer* buffer_ = nullptr;
+  // Fixed 16 KiB hazard granularity, independent of base validity granularity.
+  std::array<uint64_t, kBufferSize / 16384> last_use_{};
+};
+
+class MetalPrimitiveProcessor final : public PrimitiveProcessor {
+ public:
+  MetalPrimitiveProcessor(const RegisterFile& regs, memory::Memory& memory,
+                          MetalSharedMemory& shared, MTL::Device* device)
+      : PrimitiveProcessor(regs, memory, shared), memory_(memory), device_(device) {}
+  ~MetalPrimitiveProcessor() override;
+  bool Initialize() { return InitializeCommon(true, false, false, false, false, false); }
+  bool Process(ProcessingResult& result);
+  void EndFrame();
+  std::pair<MTL::Buffer*, size_t> GetIndexBuffer(const ProcessingResult& result) const;
+ protected:
+  bool InitializeBuiltinIndexBuffer(size_t size, std::function<void(void*)> fill) override;
+  void* RequestHostConvertedIndexBufferForCurrentFrame(
+      xenos::IndexFormat format, uint32_t count, bool coalign, uint32_t original,
+      size_t& handle) override;
+ private:
+  memory::Memory& memory_;
+  MTL::Device* device_;
+  MTL::Buffer* builtin_ = nullptr;
+  std::vector<std::pair<MTL::Buffer*, size_t>> converted_;
+};
+}  // namespace rex::graphics::metal
+#endif
