+
+namespace rex::graphics {
+// Describe actual host views, including uint aliases and SNORM fallbacks.
+struct HostRenderTargetShaderOptions {
+  uint32_t draw_resolution_scale_x = 1, draw_resolution_scale_y = 1;
+  bool msaa_2x_attachments_supported = true;
+  bool gamma_render_target_as_unorm16 = false, depth_float24_round = false;
+  bool source_color_is_uint = false, dest_color_is_uint = false;
+  bool source_color_16_is_float = false, dest_color_16_is_float = false;
+  bool sample_rate_shading = false, shader_stencil_export = false;
+};
+enum class HostRenderTargetTransferMode : uint32_t {
+  kColorToDepth,
+  kColorToColor,
+
+  kDepthToDepth,
+  kDepthToColor,
+
+  kColorToStencilBit,
+  kDepthToStencilBit,
+
+  // Two-source modes, using the host depth if it, when converted to the guest
+  // format, matches what's in the owner source (not modified, keep host
+  // precision), or the guest data otherwise (significantly modified, possibly
+  // cleared). Stencil for FragStencilRef is always taken from the guest
+  // source.
+
+  kColorAndHostDepthToDepth,
+  // When using different source and destination depth formats.
+  kDepthAndHostDepthToDepth,
+
+  // If host depth is fetched, but it's the same image as the destination,
+  // it's copied to the EDRAM buffer (but since it's just a scratch buffer,
+  // with tiles laid out linearly with the same pitch as in the original
+  // render target; also no swapping of 40-sample columns as opposed to the
+  // host render target - this is done only for the color source) and fetched
+  // from there instead of the host depth texture.
+  kColorAndHostDepthCopyToDepth,
+  kDepthAndHostDepthCopyToDepth,
+
+  kCount,
+};
+// Host-texture ownership transfer fragment shader (not a general EDRAM load).
+// Sets compact in order: saved depth buffer/texture, owner depth/stencil, color.
+// Color/depth use binding 0; stencil uses binding 1. Push words: optional saved
+// depth address, owner address, optional stencil mask. Each address packs
+// dest pitch (10 bits), source pitch (10 bits), signed base delta (12 bits).
+struct HostRenderTargetTransferShaderOptions : HostRenderTargetShaderOptions {
+  xenos::MsaaSamples dest_msaa_samples = xenos::MsaaSamples::k1X;
+  uint32_t dest_color_rt_index = 0, dest_resource_format = 0;
+  xenos::MsaaSamples source_msaa_samples = xenos::MsaaSamples::k1X;
+  xenos::MsaaSamples host_depth_source_msaa_samples = xenos::MsaaSamples::k1X;
+  uint32_t source_resource_format = 0;
+  HostRenderTargetTransferMode mode = HostRenderTargetTransferMode::kColorToColor;
+};
+// Dump: SSBO set 0/binding 0, source set 1/binding 0, stencil set 1/binding 1.
+// uint pitches at byte 0: destination | source << 10; uint offsets at byte 4:
+// dispatch first tile | source base << 12. Dispatch complete tiles, 8x16 threads.
+struct HostRenderTargetDumpShaderOptions : HostRenderTargetShaderOptions {
+  xenos::MsaaSamples msaa_samples = xenos::MsaaSamples::k1X;
+  uint32_t resource_format = 0;
+  bool is_depth = false;
+  xenos::ColorRenderTargetFormat GetColorFormat() const {
+    assert_false(is_depth); return xenos::ColorRenderTargetFormat(resource_format);
+  }
+  xenos::DepthRenderTargetFormat GetDepthFormat() const {
+    assert_true(is_depth); return xenos::DepthRenderTargetFormat(resource_format);
+  }
+};
+std::vector<uint32_t> BuildHostRenderTargetTransferSpirv(
+    const HostRenderTargetTransferShaderOptions& options);
+std::vector<uint32_t> BuildHostRenderTargetDumpSpirv(
+    const HostRenderTargetDumpShaderOptions& options);
+}  // namespace rex::graphics
