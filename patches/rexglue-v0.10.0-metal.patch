diff --git a/include/rex/graphics/metal/resources.h b/include/rex/graphics/metal/resources.h
new file mode 100644
index 0000000..8db20a2
--- /dev/null
+++ b/include/rex/graphics/metal/resources.h
@@ -0,0 +1,90 @@
+#pragma once
+#if defined(__APPLE__) && defined(REX_HAS_METAL) && REX_HAS_METAL
+
+#include <Metal/Metal.hpp>
+#include <array>
+#include <deque>
+#include <vector>
+#include <rex/graphics/primitive_processor.h>
+#include <rex/graphics/shared_memory.h>
+
+namespace rex::graphics::metal {
+// CP-thread-owned. The signal is the final command in each submission.
+class MetalSubmission {
+ public:
+  MetalSubmission(MTL::Device* device, MTL::CommandQueue* queue);
+  ~MetalSubmission();
+  bool Initialize();
+  bool Begin();
+  bool Submit();
+  bool Poll();
+  bool BeforeUpload(uint64_t last_use);
+  void EndEncoding();
+  void Finish();
+  bool AllocateConstants(size_t size, MTL::Buffer*& buffer, size_t& offset);
+  uint64_t epoch() const { return epoch_; }
+  MTL::CommandBuffer* buffer() const { return buffer_; }
+  MTL::RenderCommandEncoder* encoder = nullptr;  // Retained until EndEncoding.
+
+ private:
+  bool Wait(uint64_t epoch);
+  struct Pending {
+    uint64_t epoch;
+    MTL::CommandBuffer* buffer;
+    MTL::Buffer* uniforms;
+  };
+  MTL::Device* device_;
+  MTL::CommandQueue* queue_;
+  MTL::SharedEvent* event_ = nullptr;
+  MTL::SharedEventListener* listener_ = nullptr;
+  MTL::CommandBuffer* buffer_ = nullptr;
+  MTL::Buffer* uniforms_ = nullptr;
+  size_t uniform_offset_ = 0;
+  uint64_t epoch_ = 1;
+  bool failed_ = false;
+  std::deque<Pending> pending_;
+  std::vector<MTL::Buffer*> free_uniforms_;
+};
+
+class MetalSharedMemory final : public SharedMemory {
+ public:
+  MetalSharedMemory(memory::Memory& memory, MetalSubmission& submission)
+      : SharedMemory(memory), submission_(submission) {}
+  ~MetalSharedMemory() override;
+  bool Initialize(MTL::Device* device);
+  MTL::Buffer* buffer() const { return buffer_; }
+  void MarkUsed(uint32_t start, uint32_t length);
+ protected:
+  bool UploadRanges(const std::vector<std::pair<uint32_t, uint32_t>>& ranges) override;
+  bool UploadByteRanges(const std::vector<std::pair<uint32_t, uint32_t>>& ranges) override;
+ private:
+  bool Copy(uint32_t start, uint32_t length, bool make_valid);
+  MetalSubmission& submission_;
+  MTL::Buffer* buffer_ = nullptr;
+  // Fixed 16 KiB hazard granularity, independent of base validity granularity.
+  std::array<uint64_t, kBufferSize / 16384> last_use_{};
+};
+
+class MetalPrimitiveProcessor final : public PrimitiveProcessor {
+ public:
+  MetalPrimitiveProcessor(const RegisterFile& regs, memory::Memory& memory,
+                          MetalSharedMemory& shared, MTL::Device* device)
+      : PrimitiveProcessor(regs, memory, shared), memory_(memory), device_(device) {}
+  ~MetalPrimitiveProcessor() override;
+  bool Initialize() { return InitializeCommon(true, false, false, false, false, false); }
+  bool Process(ProcessingResult& result);
+  void EndFrame();
+  std::pair<MTL::Buffer*, size_t> GetIndexBuffer(const ProcessingResult& result) const;
+ protected:
+  bool InitializeBuiltinIndexBuffer(size_t size, std::function<void(void*)> fill) override;
+  void* RequestHostConvertedIndexBufferForCurrentFrame(
+      xenos::IndexFormat format, uint32_t count, bool coalign, uint32_t original,
+      size_t& handle) override;
+ private:
+  memory::Memory& memory_;
+  MTL::Device* device_;
+  MTL::Buffer* builtin_ = nullptr;
+  std::vector<std::pair<MTL::Buffer*, size_t>> converted_;
+};
+}  // namespace rex::graphics::metal
+#endif
