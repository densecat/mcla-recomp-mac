--- /dev/null
+++ b/src/ui/metal/presenter.mm
@@ -0,0 +1,251 @@
+#include <rex/ui/metal/presenter.h>
+#if defined(__APPLE__) && defined(REX_HAS_METAL) && REX_HAS_METAL
+
+#import <Metal/Metal.h>
+#import <QuartzCore/CAMetalLayer.h>
+
+#include <algorithm>
+#include <utility>
+#include <rex/cvar.h>
+#include <rex/ui/flags.h>
+#include <rex/ui/metal/immediate_drawer.h>
+#include <rex/ui/metal/provider.h>
+#include <rex/ui/surface_mac.h>
+#include "metal_util.h"
+
+namespace rex::ui::metal {
+namespace {
+bool VSyncEnabled() {
+  // The cvar is defined in the GPU plugin; never link the runtime back to it.
+  return !rex::cvar::GetFlagInfo("vsync") || REXCVAR_QUERY(bool, vsync);
+}
+}
+
+bool MetalGuestOutputRefreshContext::SubmitAndWait() {
+  if (!submitted_) {
+    submitted_ = true;
+    command_buffer_->commit();
+    completed_ = WaitForSubmission(command_buffer_);
+  }
+  return completed_;
+}
+
+bool MetalGuestOutputRefreshContext::Clear(double red, double green, double blue) {
+  if (submitted_) return false;
+  auto* pass = MTL::RenderPassDescriptor::renderPassDescriptor();
+  auto* color = pass->colorAttachments()->object(0);
+  color->setTexture(texture_);
+  color->setLoadAction(MTL::LoadActionClear);
+  color->setStoreAction(MTL::StoreActionStore);
+  color->setClearColor(MTL::ClearColor(red, green, blue, 1));
+  auto* encoder = command_buffer_->renderCommandEncoder(pass);
+  if (!encoder) return false;
+  encoder->endEncoding();
+  SetIs8bpc(true);
+  return SubmitAndWait();
+}
+
+MetalPresenter::MetalPresenter(MetalProvider& provider, HostGpuLossCallback callback)
+    : Presenter(std::move(callback)), provider_(provider) {}
+
+MetalPresenter::~MetalPresenter() {
+  SetWindowSurfaceFromUIThread(nullptr, nullptr);
+  DisconnectPaintingFromSurfaceFromUIThreadImpl();
+  guest_drawer_.reset();
+  for (auto*& texture : guest_textures_) ReleaseObject(texture);
+}
+
+bool MetalPresenter::Initialize() {
+  if (!InitializeCommonSurfaceIndependent()) return false;
+  guest_drawer_ = std::make_unique<MetalImmediateDrawer>(provider_);
+  if (!guest_drawer_->Initialize()) return false;
+  guest_drawer_->SetPresenter(this);
+  return true;
+}
+
+Surface::TypeFlags MetalPresenter::GetSupportedSurfaceTypes() const {
+  return Surface::kTypeFlag_CAMetalLayer;
+}
+
+Presenter::SurfacePaintConnectResult
+MetalPresenter::ConnectOrReconnectPaintingToSurfaceFromUIThread(
+    Surface& surface, uint32_t width, uint32_t height, bool,
+    bool& is_vsync_implicit_out) {
+  @autoreleasepool {
+    DisconnectPaintingFromSurfaceFromUIThreadImpl();
+    if (surface.GetType() != Surface::kTypeIndex_CAMetalLayer || !width || !height) {
+      return SurfacePaintConnectResult::kFailureSurfaceUnusable;
+    }
+    auto* layer = (__bridge CAMetalLayer*)const_cast<void*>(
+        static_cast<CAMetalLayerSurface&>(surface).layer());
+    if (!layer) return SurfacePaintConnectResult::kFailureSurfaceUnusable;
+    layer.device = (__bridge id<MTLDevice>)provider_.device();
+    layer.pixelFormat = MTLPixelFormatBGRA8Unorm;
+    layer.framebufferOnly = YES;
+    // PaintAndPresentImpl may run on the guest GPU thread, outside a UI transaction.
+    layer.presentsWithTransaction = NO;
+    layer.opaque = YES;
+    layer.maximumDrawableCount = 3;
+    layer.allowsNextDrawableTimeout = YES;
+    vsync_ = VSyncEnabled();
+    layer.displaySyncEnabled = vsync_;
+    // CAMetalLayerSurface already returns backing pixels, not logical points.
+    layer.drawableSize = CGSizeMake(width, height);
+    [layer retain];
+    layer_ = (__bridge void*)layer;
+    is_vsync_implicit_out = vsync_;
+    REXLOG_INFO("Metal surface: {}x{}, BGRA8, drawables=3, vsync={}", width, height, vsync_);
+    return SurfacePaintConnectResult::kSuccess;
+  }
+}
+
+void MetalPresenter::DisconnectPaintingFromSurfaceFromUIThreadImpl() {
+  if (layer_) {
+    [(__bridge CAMetalLayer*)layer_ release];
+    layer_ = nullptr;
+  }
+}
+
+bool MetalPresenter::RefreshGuestOutputImpl(
+    uint32_t index, uint32_t width, uint32_t height,
+    std::function<bool(GuestOutputRefreshContext&)> refresher, bool& is_8bpc_out) {
+  auto pool = Adopt(NS::AutoreleasePool::alloc()->init());
+  if (index >= guest_textures_.size() || !width || !height ||
+      width > 16384 || height > 16384) return false;
+  auto*& texture = guest_textures_[index];
+  if (!texture || texture->width() != width || texture->height() != height) {
+    auto descriptor = Adopt(MTL::TextureDescriptor::alloc()->init());
+    descriptor->setTextureType(MTL::TextureType2D);
+    descriptor->setPixelFormat(MTL::PixelFormatBGRA8Unorm);
+    descriptor->setWidth(width);
+    descriptor->setHeight(height);
+    descriptor->setStorageMode(MTL::StorageModePrivate);
+    descriptor->setUsage(MTL::TextureUsageRenderTarget | MTL::TextureUsageShaderRead);
+    auto* replacement = provider_.device()->newTexture(descriptor.get());
+    if (!replacement) {
+      REXLOG_ERROR("Metal guest texture allocation failed: {}x{}", width, height);
+      return false;
+    }
+    ReleaseObject(texture);
+    texture = replacement;
+  }
+  auto* buffer = provider_.queue()->commandBuffer();
+  if (!buffer) return false;
+  MetalGuestOutputRefreshContext context(is_8bpc_out, texture, buffer);
+  bool refreshed = refresher(context);
+  // Base Presenter publishes this slot immediately after we return true.
+  return refreshed && context.submitted_ && context.completed_;
+}
+
+bool MetalPresenter::CaptureGuestOutput(RawImage& image_out) {
+  auto pool = Adopt(NS::AutoreleasePool::alloc()->init());
+  uint32_t index;
+  auto lock = ConsumeGuestOutput(index, nullptr, nullptr);
+  if (index == UINT32_MAX || !guest_textures_[index]) return false;
+  auto* texture = guest_textures_[index];
+  uint32_t width = uint32_t(texture->width()), height = uint32_t(texture->height());
+  size_t stride = size_t(width) * 4;
+  size_t pitch = (stride + 255) & ~size_t(255);
+  auto staging = Adopt(provider_.device()->newBuffer(pitch * height, MTL::ResourceStorageModeShared));
+  auto* buffer = provider_.queue()->commandBuffer();
+  if (!staging || !buffer) return false;
+  auto* blit = buffer->blitCommandEncoder();
+  if (!blit) return false;
+  blit->copyFromTexture(texture, 0, 0, MTL::Origin(0, 0, 0), MTL::Size(width, height, 1),
+                        staging.get(), 0, pitch, pitch * height);
+  blit->endEncoding();
+  buffer->commit();
+  if (!WaitForSubmission(buffer)) return false;
+  // Keep the mailbox lock through GPU completion. The staging copy is now independent.
+  lock.unlock();
+  RawImage image;
+  image.width = width;
+  image.height = height;
+  image.stride = stride;
+  image.data.resize(stride * height);
+  const auto* source = static_cast<const uint8_t*>(staging->contents());
+  for (uint32_t y = 0; y < height; ++y) {
+    for (uint32_t x = 0; x < width; ++x) {
+      const uint8_t* bgra = source + y * pitch + x * 4;
+      uint8_t* rgba = image.data.data() + y * stride + x * 4;
+      rgba[0] = bgra[2]; rgba[1] = bgra[1]; rgba[2] = bgra[0]; rgba[3] = 255;
+    }
+  }
+  image_out = std::move(image);
+  return true;
+}
+
+Presenter::PaintResult MetalPresenter::PaintAndPresentImpl(bool execute_ui_drawers) {
+  @autoreleasepool {
+    if (!layer_) return PaintResult::kNotPresented;
+    if (vsync_ != VSyncEnabled()) return PaintResult::kNotPresentedConnectionOutdated;
+    auto* layer = (__bridge CAMetalLayer*)layer_;
+    id<CAMetalDrawable> drawable = [layer nextDrawable];
+    if (!drawable) return PaintResult::kNotPresented;  // Occluded/minimized/timeout.
+    auto* target = (__bridge MTL::Texture*)drawable.texture;
+    uint32_t width = uint32_t(target->width()), height = uint32_t(target->height());
+    if (!width || !height) return PaintResult::kNotPresented;
+
+    uint32_t index;
+    GuestOutputProperties properties;
+    auto lock = ConsumeGuestOutput(index, &properties, nullptr);
+    auto* buffer = provider_.queue()->commandBuffer();
+    if (!buffer) return PaintResult::kNotPresented;
+    auto* pass = MTL::RenderPassDescriptor::renderPassDescriptor();
+    auto* color = pass->colorAttachments()->object(0);
+    color->setTexture(target);
+    color->setLoadAction(MTL::LoadActionClear);
+    color->setStoreAction(MTL::StoreActionStore);
+    color->setClearColor(MTL::ClearColor(0, 0, 0, 1));
+    auto* encoder = buffer->renderCommandEncoder(pass);
+    if (!encoder) return PaintResult::kNotPresented;
+    if (index != UINT32_MAX && guest_textures_[index]) {
+      auto texture = guest_drawer_->WrapTexture(guest_textures_[index]);
+      float draw_width = float(width), draw_height = float(height);
+      if (REXCVAR_GET(present_letterbox)) {
+        double aspect = double(properties.display_aspect_ratio_x) / properties.display_aspect_ratio_y;
+        if (double(width) / height > aspect) draw_width = float(height * aspect);
+        else draw_height = float(width / aspect);
+      }
+      float left = (width - draw_width) * 0.5f, top = (height - draw_height) * 0.5f;
+      float right = left + draw_width, bottom = top + draw_height;
+      const ImmediateVertex vertices[] = {
+          {left, top, 0, 0, 0xFFFFFFFF}, {right, top, 1, 0, 0xFFFFFFFF},
+          {left, bottom, 0, 1, 0xFFFFFFFF}, {right, top, 1, 0, 0xFFFFFFFF},
+          {right, bottom, 1, 1, 0xFFFFFFFF}, {left, bottom, 0, 1, 0xFFFFFFFF}};
+      MetalUIDrawContext context(*this, width, height, encoder);
+      guest_drawer_->Begin(context, float(width), float(height));
+      guest_drawer_->BeginDrawBatch(ImmediateDrawBatch{vertices, 6, nullptr, 0});
+      ImmediateDraw draw;
+      draw.count = 6;
+      draw.texture = texture.get();
+      guest_drawer_->Draw(draw);
+      guest_drawer_->End();
+    }
+    encoder->endEncoding();
+    if (!execute_ui_drawers) buffer->presentDrawable((__bridge MTL::Drawable*)drawable);
+    buffer->commit();
+    bool completed = WaitForSubmission(buffer);
+    lock.unlock();
+    if (!completed) return PaintResult::kNotPresented;
+
+    if (execute_ui_drawers) {
+      // UI callbacks may themselves capture guest output. Never call them while
+      // holding the mailbox lock. The guest sampling above has already completed.
+      buffer = provider_.queue()->commandBuffer();
+      if (!buffer) return PaintResult::kNotPresented;
+      color->setLoadAction(MTL::LoadActionLoad);
+      encoder = buffer->renderCommandEncoder(pass);
+      if (!encoder) return PaintResult::kNotPresented;
+      MetalUIDrawContext context(*this, width, height, encoder);
+      ExecuteUIDrawersFromUIThread(context);
+      encoder->endEncoding();
+      buffer->presentDrawable((__bridge MTL::Drawable*)drawable);
+      buffer->commit();
+      if (!WaitForSubmission(buffer)) return PaintResult::kNotPresented;
+    }
+    return PaintResult::kPresented;
+  }
+}
+}  // namespace rex::ui::metal
+#endif
