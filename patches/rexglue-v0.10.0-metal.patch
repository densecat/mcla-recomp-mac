+  // attachment mask. Uploads must precede both uniform allocation and RT Update.
+  uint32_t texture_mask = 0;
+  for (const Shader* shader : {static_cast<const Shader*>(vs), static_cast<const Shader*>(ps)})
+    if (shader) for (const auto& binding : shader->texture_bindings())
