+    uint3 values = uint3(rgb * 1023.0f + 0.5f);
+    for (uint channel = 0; channel < 3; ++channel) {
+      uint value = values[channel];
+      uint entry = ramp[(value >> 3u) * 3u + channel];
+      float corrected = float(entry & 65535u) +
+          float((value & 7u) * (entry >> 16u)) * 0.125f;
+      rgb[channel] = clamp(corrected * 1.52737048e-05f, 0.0f, 1.0f);
+    }
+  } else {
+    uint3 values = uint3(rgb * 255.0f + 0.5f);
+    rgb = float3((ramp[values.r] >> 20u) & 1023u,
+                 (ramp[values.g] >> 10u) & 1023u,
+                  ramp[values.b] & 1023u) * (1.0f / 1023.0f);
+  }
+  return float4(rgb, 1.0f);
+}
+)MSL";
+    auto options = Adopt(MTL::CompileOptions::alloc()->init());
+    options->setLanguageVersion(MTL::LanguageVersion2_4);
+    options->setFastMathEnabled(false);
+    NS::Error* error = nullptr;
+    auto library = Adopt(device->newLibrary(
+        NS::String::string(source, NS::UTF8StringEncoding), options.get(), &error));
+    if (library) {
+      auto vertex = Adopt(library->newFunction(
+          NS::String::string("swap_vertex", NS::UTF8StringEncoding)));
+      auto fragment = Adopt(library->newFunction(
+          NS::String::string("swap_fragment", NS::UTF8StringEncoding)));
+      if (vertex && fragment) {
+        auto desc = Adopt(MTL::RenderPipelineDescriptor::alloc()->init());
+        desc->setVertexFunction(vertex.get()); desc->setFragmentFunction(fragment.get());
+        desc->colorAttachments()->object(0)->setPixelFormat(MTL::PixelFormatBGRA8Unorm);
+        swap_pipeline = device->newRenderPipelineState(desc.get(), &error);
+      }
+    }
+    if (!swap_pipeline) {
+      PERF_METAL_counter_add(kMetalMslCompileFailures, 1);
+      REXLOG_ERROR("Metal frontbuffer gamma pipeline failed: {}", ui::metal::ErrorText(error));
+    }
+    return swap_pipeline;
+  }
+  bool PresentSwap(ui::metal::MetalGuestOutputRefreshContext& context,
+      MTL::Texture* source, bool pwl, const void* ramp, size_t ramp_size) {
+    auto* pipeline = GetSwapPipeline();
+    auto* output = context.texture();
+    if (!pipeline || !source || !output || output->pixelFormat() != MTL::PixelFormatBGRA8Unorm ||
+        output->width() > source->width() || output->height() > source->height()) return false;
+    auto* pass = MTL::RenderPassDescriptor::renderPassDescriptor();
+    auto* color = pass->colorAttachments()->object(0);
+    color->setTexture(output); color->setLoadAction(MTL::LoadActionDontCare);
+    color->setStoreAction(MTL::StoreActionStore);
+    auto* encoder = context.command_buffer()->renderCommandEncoder(pass);
+    if (!encoder) return false;
+    PERF_METAL_counter_add(kRenderPassesBegun, 1);
+    encoder->setRenderPipelineState(pipeline);
+    encoder->setFragmentTexture(source, 0);
+    // setFragmentBytes snapshots each swap's ramp without modifying an in-flight buffer.
+    encoder->setFragmentBytes(ramp, ramp_size, 0);
+    uint32_t flags = uint32_t(pwl);
+    encoder->setFragmentBytes(&flags, sizeof(flags), 1);
+    encoder->setViewport(MTL::Viewport{0, 0, double(output->width()), double(output->height()), 0, 1});
+    encoder->setScissorRect(MTL::ScissorRect{0, 0, output->width(), output->height()});
+    encoder->setCullMode(MTL::CullModeNone);
+    encoder->drawPrimitives(MTL::PrimitiveTypeTriangle, NS::UInteger(0), NS::UInteger(3));
+    encoder->endEncoding();
+    PERF_METAL_counter_add(kPassEndSwap, 1);
+    context.SetIs8bpc(true);  // Existing presenter mailbox is BGRA8.
+    return context.SubmitAndWait();
+  }
+  bool BindTextures(const SpirvShader& shader, bool vertex) {
+    auto* encoder = submission.encoder;
+    bool fallback = false;
+    const auto& bindings = shader.GetTextureBindingsAfterTranslation();
+    for (size_t i = 0; i < bindings.size(); ++i) {
+      const auto& binding = bindings[i];
+      bool missing;
+      auto* texture = textures.GetTexture(binding, missing);
+      fallback |= missing;
+      if (!texture) {
+        uint32_t dimension = binding.dimension == xenos::FetchOpDimension::kCube ? 2 :
+            binding.dimension == xenos::FetchOpDimension::k3DOrStacked ? 1 : 0;
+        texture = placeholders[dimension + (binding.is_signed ? 3 : 0)];
+      }
+      if (vertex) encoder->setVertexTexture(texture, i);
+      else encoder->setFragmentTexture(texture, i);
+    }
+    const auto& samplers = shader.GetSamplerBindingsAfterTranslation();
+    for (size_t i = 0; i < samplers.size(); ++i) {
+      auto* state = textures.GetSampler(samplers[i]);
+      fallback |= !state;
+      if (vertex) encoder->setVertexSamplerState(state ? state : sampler, i);
+      else encoder->setFragmentSamplerState(state ? state : sampler, i);
+    }
+    return fallback;
+  }
