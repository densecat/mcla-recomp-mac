+#pragma once
+// Host-RT conversion rules mirror vulkan/render_target_cache.cpp and
+// SpirvShaderTranslator's 7e3 / 20e4 helpers (Xenia, BSD; see LICENSE).
+namespace rex::graphics::metal {
+inline constexpr const char* kRenderTargetMSL = R"MSL(
+#include <metal_stdlib>
+using namespace metal;
+struct Params { uint4 address; uint4 shape; uint4 extent; };
+struct VertexOut { float4 position [[position]]; };
+vertex VertexOut rt_vertex(uint id [[vertex_id]]) {
+  return {float4(float2((id << 1) & 2, id & 2) * 2.0f - 1.0f, 0, 1)};
+}
+#if MSAA
+#define TEX(T) texture2d_ms<T>
+#define DEPTH_TEX depth2d_ms<float>
+#define READ(t, p, s) t.read(p, s)
+#else
+#define TEX(T) texture2d<T>
+#define DEPTH_TEX depth2d<float>
+#define READ(t, p, s) t.read(p)
+#endif
+float linear_to_gamma(float v) {
+  v = saturate(v) * 1023.0f;
+  return (v >= 512 ? v * 0.125f + 128 :
+          v >= 128 ? v * 0.25f + 64 :
+          v >= 64 ? v * 0.5f + 32 : v) / 255.0f;
+}
+float gamma_to_linear(float v) {
+  float t = saturate(v) * 255.0f;
+  float scale = t >= 192 ? 8 : t >= 96 ? 4 : t >= 64 ? 2 : 1;
+  float offset = t >= 192 ? -1024 : t >= 96 ? -256 : t >= 64 ? -64 : 0;
+  float l = t * scale + offset;
+  return (l + trunc(l * (scale / 1024.0f))) / 1023.0f;
+}
+uint to_7e3(float v) {
+  uint b = as_type<uint>(fmin(fmax(v, 0.0f), 31.875f));
+  b = b < 0x3E800000u ? ((b & 0x7FFFFFu) | 0x800000u) >>
+      min(125u - (b >> 23), 24u) : b - (124u << 23);
+  return ((b + 0x7FFFu + ((b >> 16) & 1)) >> 16) & 1023;
+}
+float from_7e3(uint v) {
+  uint e = (v >> 7) & 7, m = v & 127;
+  return e ? ldexp(float(128 + m), int(e) - 10) : ldexp(float(m), -9);
+}
+uint pack_depth(float v, uint format) {
+  if (!format) return uint(rint(saturate(v) * 16777215.0f));
+  // D24FS8 is stored in [0, 1) on the host for guest [0, 2).
+  if (!(v > 0)) return 0;
+  uint b = as_type<uint>(v);
+  if (b >= 0x3F7FFFF8u) return 0xFFFFFF;
+  b = b < 0x38000000u ? ((b & 0x7FFFFFu) | 0x800000u) >>
+      min(112u - (b >> 23), 24u) : b - (111u << 23);
+#if ROUND_DEPTH
+  b += 3 + ((b >> 3) & 1);
+#endif
+  return (b >> 3) & 0xFFFFFF;
+}
+float unpack_depth(uint v, uint format) {
+  if (!format) return float(v) / 16777215.0f;
+  uint e = v >> 20, m = v & 0xFFFFF;
+  return e ? as_type<float>(((e + 111) << 23) | (m << 3)) : ldexp(float(m), -35);
+}
+uint2 source_coord(uint2 p, constant Params& c, bool host = false) {
+  uint tile = c.address.y + (p.y / c.shape.y) * c.address.w + p.x / c.shape.x;
+  uint relative = (tile - (host ? c.shape.z : c.address.x)) & 2047;
+  uint pitch = host ? c.shape.w : c.address.z;
+  return uint2(relative % pitch, relative / pitch) * c.shape.xy + p % c.shape.xy;
+}
+#if PREVIEW
+fragment float4 rt_fragment(float4 p [[position]], TEX(float) src [[texture(0)]],
+                           constant Params& c [[buffer(0)]]) {
+  uint2 xy = min(uint2(p.xy * float2(c.extent.xy) / float2(c.extent.zw)),
+                 c.extent.xy - 1);
+  float4 color;
+#if MSAA
+  color = float4(0);
+#if TWO_IN_FOUR
+  color = (src.read(xy, 0) + src.read(xy, 3)) * 0.5f;
+#else
+  for (uint s = 0; s < src.get_num_samples(); ++s) color += src.read(xy, s);
+  color /= float(src.get_num_samples());
+#endif
+#else
+  color = src.read(xy);
+#endif
+#if SRC_FORMAT == 1 && GAMMA_16
+  color.rgb = float3(linear_to_gamma(color.r), linear_to_gamma(color.g),
+                     linear_to_gamma(color.b));
+#endif
+  return float4(color.rgb, 1);
+}
+#elif DEPTH
+struct DepthOut { float depth [[depth(any)]]; uint stencil [[stencil]]; };
+fragment DepthOut rt_fragment(float4 p [[position]], uint sample [[sample_id]],
+                              DEPTH_TEX src [[texture(0)]],
+                              TEX(uint) stencil [[texture(1)]],
+#if HOST_DEPTH
+                              DEPTH_TEX old_depth [[texture(2)]],
+#endif
+                              constant Params& c [[buffer(0)]]) {
+  uint2 xy = source_coord(uint2(p.xy), c);
+  float d = READ(src, xy, sample);
+  uint bits = pack_depth(d, SRC_FORMAT);
+#if SRC_FORMAT != DST_FORMAT
+  d = unpack_depth(bits, DST_FORMAT);
+#endif
+#if HOST_DEPTH
+  float old = READ(old_depth, source_coord(uint2(p.xy), c, true), sample);
+  if (pack_depth(old, DST_FORMAT) == bits) d = old;
+#endif
+  return {d, READ(stencil, xy, sample).r};
+}
+#else
+#if SOURCE_UINT
+#define SOURCE_TYPE uint
+#else
+#define SOURCE_TYPE float
+#endif
+#if DEST_UINT
+#define DEST_TYPE uint
+#else
+#define DEST_TYPE float
+#endif
+uint2 pack_color(vec<SOURCE_TYPE, 4> c) {
+#if SRC_FORMAT == 4 || SRC_FORMAT == 5 || SRC_FORMAT == 6 || SRC_FORMAT == 7
+  return uint2(c.x | (c.y << 16), c.z | (c.w << 16));
+#elif SRC_FORMAT == 14 || SRC_FORMAT == 15
+  return c.xy;
+#else
+#if SRC_FORMAT == 0 || SRC_FORMAT == 1
+#if SRC_FORMAT == 1 && GAMMA_16
+  c.rgb = float3(linear_to_gamma(c.r), linear_to_gamma(c.g), linear_to_gamma(c.b));
+#endif
+  uint4 v = uint4(saturate(c) * 255.0f + 0.5f);
+  return uint2(v.x | (v.y << 8) | (v.z << 16) | (v.w << 24), 0);
+#else
+#if SRC_FORMAT == 3 || SRC_FORMAT == 12
+  uint3 rgb = uint3(to_7e3(c.r), to_7e3(c.g), to_7e3(c.b));
+#else
+  uint3 rgb = uint3(saturate(c.rgb) * 1023.0f + 0.5f);
+#endif
+  return uint2(rgb.x | (rgb.y << 10) | (rgb.z << 20) |
+               (uint(saturate(c.a) * 3.0f + 0.5f) << 30), 0);
+#endif
+#endif
+}
+vec<DEST_TYPE, 4> unpack_color(uint2 v) {
+#if DST_FORMAT == 4 || DST_FORMAT == 5 || DST_FORMAT == 6 || DST_FORMAT == 7
+  return uint4(v.x & 65535, v.x >> 16, v.y & 65535, v.y >> 16);
+#elif DST_FORMAT == 14 || DST_FORMAT == 15
+  return uint4(v, 0, 0);
+#elif DST_FORMAT == 0 || DST_FORMAT == 1
+  float4 c = float4(uint4(v.x, v.x >> 8, v.x >> 16, v.x >> 24) & 255) / 255.0f;
+#if DST_FORMAT == 1 && GAMMA_16
+  c.rgb = float3(gamma_to_linear(c.r), gamma_to_linear(c.g), gamma_to_linear(c.b));
+#endif
+  return c;
+#else
+  uint3 rgb = uint3(v.x, v.x >> 10, v.x >> 20) & 1023;
+#if DST_FORMAT == 3 || DST_FORMAT == 12
+  return float4(from_7e3(rgb.x), from_7e3(rgb.y), from_7e3(rgb.z), float(v.x >> 30) / 3);
+#else
+  return float4(float3(rgb) / 1023.0f, float(v.x >> 30) / 3);
+#endif
+#endif
+}
+fragment vec<DEST_TYPE, 4> rt_fragment(float4 p [[position]], uint sample [[sample_id]],
+                                      TEX(SOURCE_TYPE) src [[texture(0)]],
+                                      constant Params& c [[buffer(0)]]) {
+  auto color = READ(src, source_coord(uint2(p.xy), c), sample);
+#if SRC_FORMAT == DST_FORMAT
+  return color;
+#else
+  return unpack_color(pack_color(color));
+#endif
+}
+#endif
+)MSL";
+}  // namespace rex::graphics::metal
