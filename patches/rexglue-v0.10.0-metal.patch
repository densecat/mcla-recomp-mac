+#include <rex/graphics/metal/msl_shader.h>
+#if defined(__APPLE__) && defined(REX_HAS_METAL) && REX_HAS_METAL
+#include <spirv_msl.hpp>
+#include <cstring>
+#include <stdexcept>
+#include <rex/logging.h>
+#include <rex/perf/counter.h>
+#include "../../ui/metal/metal_util.h"
+
+namespace rex::graphics::metal {
+namespace cross = SPIRV_CROSS_NAMESPACE;
+using ui::metal::Adopt;
+using ui::metal::ErrorText;
+using ui::metal::ReleaseObject;
+
+MetalFunction::~MetalFunction() {
+  ReleaseObject(function);
+  ReleaseObject(library);
+}
+bool CompileMSL(MTL::Device* device, const std::vector<uint8_t>& binary,
+                bool vertex, uint32_t texture_count, uint32_t sampler_count,
+                MetalFunction& result, uint32_t attachment_mask) {
+  auto pool = Adopt(NS::AutoreleasePool::alloc()->init());
+  try {
+    if (binary.empty() || binary.size() % 4 || texture_count > 128 || sampler_count > 16)
+      throw std::runtime_error("invalid SPIR-V size or discrete Metal resource limit exceeded");
+    std::vector<uint32_t> words(binary.size() / 4);
+    std::memcpy(words.data(), binary.data(), binary.size());
+    cross::CompilerMSL compiler(std::move(words));
+    auto options = compiler.get_msl_options();
+    options.platform = cross::CompilerMSL::Options::macOS;
+    options.set_msl_version(2, 4);
+    options.argument_buffers = false;
+    // Match the real pass, including sparse MRT slots; preserve shader side effects.
+    options.enable_frag_output_mask = attachment_mask >> 1;
+    options.enable_frag_depth_builtin = (attachment_mask & 1) != 0;
+    compiler.set_msl_options(options);
+    auto stage = vertex ? spv::ExecutionModelVertex : spv::ExecutionModelFragment;
+    compiler.set_entry_point("main", stage);
+    // These layouts are asserted against SpirvShaderTranslator in pipeline_cache.cpp.
+    auto bind = [&](uint32_t set, uint32_t binding, uint32_t buffer,
+                    uint32_t texture, uint32_t sampler) {
+      cross::MSLResourceBinding resource{};
+      resource.stage = stage;
+      resource.desc_set = set;
+      resource.binding = binding;
+      resource.msl_buffer = buffer;
+      resource.msl_texture = texture;
+      resource.msl_sampler = sampler;
+      compiler.add_msl_resource_binding(resource);
+    };
+    bind(0, 0, 0, 0, 0);  // Single 512 MiB shared-memory SSBO.
+    for (uint32_t i = 0; i < 5; ++i) bind(1, i, 1 + i, 0, 0);
+    uint32_t texture_set = vertex ? 2 : 3;
+    for (uint32_t i = 0; i < texture_count; ++i) bind(texture_set, i, 0, i, 0);
+    for (uint32_t i = 0; i < sampler_count; ++i)
+      bind(texture_set, texture_count + i, 0, 0, i);
+    std::string source = compiler.compile();
+    std::string entry = compiler.get_cleansed_entry_point_name("main", stage);
+    auto compile_options = Adopt(MTL::CompileOptions::alloc()->init());
+    compile_options->setLanguageVersion(MTL::LanguageVersion2_4);
+    compile_options->setFastMathEnabled(false);
+    NS::Error* error = nullptr;
+    result.library = device->newLibrary(NS::String::string(source.c_str(), NS::UTF8StringEncoding),
+                                        compile_options.get(), &error);
+    if (!result.library) throw std::runtime_error(ErrorText(error));
+    result.function = result.library->newFunction(
+        NS::String::string(entry.c_str(), NS::UTF8StringEncoding));
+    if (!result.function) throw std::runtime_error("compiled library has no stage entry point");
+    return true;
+  } catch (const std::exception& error) {
+    PERF_METAL_counter_add(kMetalMslCompileFailures, 1);
+    REXLOG_ERROR("Metal MSL compile failed: hash={:016X}, modification={:016X}, stage={}: {}",
+                 result.hash, result.modification, vertex ? "VS" : "PS", error.what());
+    ReleaseObject(result.function);
+    ReleaseObject(result.library);
+    return false;
+  }
+}
+bool CompileTextureLoadMSL(MTL::Device* device, const uint32_t* words, size_t count,
+                           MetalFunction& result) {
+  try {
+    cross::CompilerMSL compiler(words, count);
+    compiler.set_entry_point("main", spv::ExecutionModelGLCompute);
+    // Reject an incompatible shader ABI, rather than silently using Edge's
+    // padded 64-byte constant structure with this SDK's 40-byte constants.
+    const auto resources = compiler.get_shader_resources();
+    if (resources.push_constant_buffers.size() != 1 || resources.storage_buffers.size() != 2)
+      throw std::runtime_error("unexpected texture-load resources");
+    const auto& type = compiler.get_type(resources.push_constant_buffers[0].base_type_id);
+    constexpr uint32_t offsets[] = {0, 4, 8, 12, 16, 28, 32, 36};
+    if (type.member_types.size() != std::size(offsets) ||
+        compiler.get_declared_struct_size(type) != 40)
+      throw std::runtime_error("unexpected texture-load constant size");
+    for (uint32_t i = 0; i < std::size(offsets); ++i)
+      if (compiler.type_struct_member_offset(type, i) != offsets[i])
+        throw std::runtime_error("unexpected texture-load constant offset");
+    if (compiler.get_execution_mode_argument(spv::ExecutionModeLocalSize, 0) != 4 ||
+        compiler.get_execution_mode_argument(spv::ExecutionModeLocalSize, 1) != 32 ||
+        compiler.get_execution_mode_argument(spv::ExecutionModeLocalSize, 2) != 1)
+      throw std::runtime_error("unexpected texture-load workgroup size");
+    auto options = compiler.get_msl_options();
+    options.platform = cross::CompilerMSL::Options::macOS;
+    options.set_msl_version(2, 4);
+    options.argument_buffers = false;
+    compiler.set_msl_options(options);
+    auto bind = [&](uint32_t set, uint32_t binding, uint32_t buffer) {
+      cross::MSLResourceBinding r{};
+      r.stage = spv::ExecutionModelGLCompute;
+      r.desc_set = set; r.binding = binding; r.msl_buffer = buffer;
+      compiler.add_msl_resource_binding(r);
+    };
+    bind(cross::kPushConstDescSet, cross::kPushConstBinding, 0);
+    bind(0, 0, 1);
+    bind(1, 0, 2);
+    std::string source = compiler.compile();
+    auto options_mtl = Adopt(MTL::CompileOptions::alloc()->init());
+    options_mtl->setLanguageVersion(MTL::LanguageVersion2_4);
+    options_mtl->setFastMathEnabled(false);
+    NS::Error* error = nullptr;
+    result.library = device->newLibrary(NS::String::string(source.c_str(), NS::UTF8StringEncoding),
+                                        options_mtl.get(), &error);
+    if (!result.library) throw std::runtime_error(ErrorText(error));
+    result.function = result.library->newFunction(NS::String::string(
+        compiler.get_cleansed_entry_point_name("main", spv::ExecutionModelGLCompute).c_str(),
+        NS::UTF8StringEncoding));
+    if (!result.function) throw std::runtime_error("missing texture-load entry point");
+    return true;
+  } catch (const std::exception& e) {
+    PERF_METAL_counter_add(kMetalMslCompileFailures, 1);
+    REXLOG_ERROR("Metal texture-load shader {} failed: {}", result.hash, e.what());
+    ReleaseObject(result.function);
+    ReleaseObject(result.library);
+    return false;
+  }
+}
+bool CompileUtilityMSL(MTL::Device* device, const uint32_t* words, size_t count,
+                       bool compute, uint32_t push_size,
+                       std::initializer_list<MetalSpirvBinding> bindings,
+                       MetalFunction& result, std::array<uint32_t, 3>* group, uint32_t sample_mask) {
+  auto pool = Adopt(NS::AutoreleasePool::alloc()->init());
+  try {
+    if (!words || !count) throw std::runtime_error("empty utility SPIR-V");
+    cross::CompilerMSL compiler(words, count);
+    auto stage = compute ? spv::ExecutionModelGLCompute : spv::ExecutionModelFragment;
+    compiler.set_entry_point("main", stage);
+    auto resources = compiler.get_shader_resources();
+    if (resources.push_constant_buffers.size() != 1 ||
+        compiler.get_declared_struct_size(compiler.get_type(
+            resources.push_constant_buffers[0].base_type_id)) != push_size)
+      throw std::runtime_error("utility push constant ABI mismatch");
+    if (!resources.uniform_buffers.empty() || !resources.sampled_images.empty() ||
+        !resources.separate_samplers.empty() || !resources.storage_images.empty())
+      throw std::runtime_error("unexpected utility resource type");
+    auto validate = [&](const auto& list) {
+      for (const auto& resource : list) {
+        uint32_t set = compiler.get_decoration(resource.id, spv::DecorationDescriptorSet);
+        uint32_t binding = compiler.get_decoration(resource.id, spv::DecorationBinding);
+        bool found = false;
+        for (const auto& b : bindings) found |= b.set == set && b.binding == binding;
+        if (!found) throw std::runtime_error("unmapped utility resource");
+      }
+    };
+    validate(resources.storage_buffers);
+    validate(resources.separate_images);
+    auto options = compiler.get_msl_options();
+    options.platform = cross::CompilerMSL::Options::macOS;
+    options.set_msl_version(2, 4);
+    options.argument_buffers = false;
+    if (!compute) options.additional_fixed_sample_mask = sample_mask;
+    compiler.set_msl_options(options);
+    auto bind = [&](uint32_t set, uint32_t binding, uint32_t buffer, uint32_t texture) {
+      cross::MSLResourceBinding r{};
+      r.stage = stage; r.desc_set = set; r.binding = binding;
+      r.msl_buffer = buffer; r.msl_texture = texture;
+      compiler.add_msl_resource_binding(r);
+    };
+    bind(cross::kPushConstDescSet, cross::kPushConstBinding, 0, 0);
+    for (const auto& b : bindings) bind(b.set, b.binding, b.buffer, b.texture);
+    if (compute && group) {
+      for (uint32_t i = 0; i < 3; ++i) {
+        (*group)[i] = compiler.get_execution_mode_argument(spv::ExecutionModeLocalSize, i);
+        if (!(*group)[i]) throw std::runtime_error("invalid utility workgroup");
+      }
+    }
+    std::string source = compiler.compile();
+    auto compile_options = Adopt(MTL::CompileOptions::alloc()->init());
+    compile_options->setLanguageVersion(MTL::LanguageVersion2_4);
+    compile_options->setFastMathEnabled(false);
+    NS::Error* error = nullptr;
+    result.library = device->newLibrary(NS::String::string(source.c_str(), NS::UTF8StringEncoding),
+                                        compile_options.get(), &error);
+    if (!result.library) throw std::runtime_error(ErrorText(error));
+    result.function = result.library->newFunction(NS::String::string(
+        compiler.get_cleansed_entry_point_name("main", stage).c_str(), NS::UTF8StringEncoding));
+    if (!result.function) throw std::runtime_error("missing utility entry point");
+    return true;
+  } catch (const std::exception& error) {
+    PERF_METAL_counter_add(kMetalMslCompileFailures, 1);
+    REXLOG_ERROR("Metal utility shader {} failed: {}", result.hash, error.what());
+    ReleaseObject(result.function);
+    ReleaseObject(result.library);
+    return false;
+  }
+}
+}  // namespace rex::graphics::metal
+#endif
