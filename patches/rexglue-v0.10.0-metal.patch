+#include "../shaders/vulkan_spirv/texture_load_dxt3a_cs.h"
+#include "../shaders/vulkan_spirv/texture_load_dxt3aas1111_argb4_cs.h"
+#include "../shaders/vulkan_spirv/texture_load_dxt5a_r8_cs.h"
+#include "../shaders/vulkan_spirv/texture_load_ctx1_cs.h"
+#include "../shaders/vulkan_spirv/texture_load_depth_unorm_cs.h"
+#include "../shaders/vulkan_spirv/texture_load_depth_float_cs.h"
+}
+using ui::metal::Adopt;
+using ui::metal::ReleaseObject;
+using ui::metal::ErrorText;
+
+MetalTextureCache::MetalTextureCache(const RegisterFile& regs, MetalSharedMemory& shared,
+    MTL::Device* device, MetalSubmission& submission)
+    : TextureCache(regs, shared, 1, 1), device_(device), submission_(submission), shared_(shared),
+      bc_(device->supportsBCTextureCompression()),
+      float32_filter_(device->supports32BitFloatFiltering()) {}
+MetalTextureCache::~MetalTextureCache() {
+  DestroyAllTextures(true);
+  for (auto& [key, sampler] : samplers_) ReleaseObject(sampler);
+  ReleaseObject(untiled_);
+  ReleaseObject(upload_);
+}
+MetalTextureCache::Loader::~Loader() { ReleaseObject(pipeline); }
+MetalTextureCache::MetalTexture::MetalTexture(MetalTextureCache& cache, TextureKey key,
+                                            MTL::Texture* texture)
+    : Texture(cache, key), image(texture) { AccountMemory(); }
+void MetalTextureCache::MetalTexture::AccountMemory() {
+  SetHostMemoryUsage(image->allocatedSize() + (slice ? slice->allocatedSize() : 0));
+}
+MetalTextureCache::MetalTexture::~MetalTexture() {
+  for (auto& [key, view] : views) ReleaseObject(view);
+  ReleaseObject(slice);
+  ReleaseObject(image);
+}
+void MetalTextureCache::ClearCache() {
+  submission_.EndEncoding(perf::CounterId::kPassEndBarrierTexture);
+  TextureCache::ClearCache();
+  for (auto& [key, sampler] : samplers_) ReleaseObject(sampler);
+  samplers_.clear();
+  ReleaseObject(untiled_);
+  ReleaseObject(upload_);
+}
+void MetalTextureCache::BeginFrame() {
+  TextureCache::BeginFrame();
+  // Encoded submissions retain sampler states. Bound pointers aren't cached by CP.
+  if (samplers_.size() > 4096) {
+    for (auto& [key, sampler] : samplers_) ReleaseObject(sampler);
+    samplers_.clear();
+  }
+}
+void MetalTextureCache::SyncSubmission() {
+  if (cache_epoch_ != submission_.epoch()) {
+    cache_epoch_ = submission_.epoch();
+    BeginSubmission(cache_epoch_);
+  }
+}
+void MetalTextureCache::RequestTextures(uint32_t mask) {
+  SyncSubmission();
+  // Evict only outside the base class's pending-load traversal.
+  CompletedSubmissionUpdated(submission_.completed_epoch());
+  TextureCache::RequestTextures(mask);
+  SyncSubmission();  // A shared-memory upload may have split the submission.
+  for (uint32_t i = 0; i < 32; ++i) {
+    if (!(mask & (1u << i))) continue;
+    const auto* binding = GetValidTextureBinding(i);
+    if (!binding) continue;
+    for (auto* base : {binding->texture, binding->texture_signed}) {
+      if (!base) continue;
+      base->MarkAsUsed();
+      auto& texture = *static_cast<MetalTexture*>(base);
+      if (!base->outdated_mask() && base->key().dimension == xenos::DataDimension::k3D &&
+          REXCVAR_GET(gpu_3d_to_2d_texture)) PrepareSlice(texture);
+    }
+  }
+}
+bool MetalTextureCache::UnsupportedResolveTexture(uint32_t reason) {
+  PERF_METAL_counter_add(kMetalResolvesUnsupported, 1);
+  if (!(resolve_warning_mask_ & (1u << reason))) {
+    resolve_warning_mask_ |= 1u << reason;
+    constexpr const char* names[] = {"scaled", "swap-address-alignment", "swap-fetch", "swap-format"};
+    REXLOG_ERROR("Metal resolve texture rejected: {}", names[reason]);
+  }
+  return false;
+}
+MTL::Texture* MetalTextureCache::RequestSwapTexture(
+    uint32_t& width, uint32_t& height, xenos::TextureFormat& format) {
+  width = height = 0;
+  format = xenos::TextureFormat::k_8_8_8_8;
+  uint32_t scale_x, scale_y;
+  GetConfigDrawResolutionScale(scale_x, scale_y);
+  if (scale_x != 1 || scale_y != 1 || IsDrawResolutionScaled()) {
+    UnsupportedResolveTexture(0); return nullptr;
+  }
+  auto fetch = register_file().GetTextureFetch(0);
+  TextureKey key;
+  BindingInfoFromFetchConstant(fetch, key, nullptr);
+  if (!key.is_valid || !key.base_page || key.dimension != xenos::DataDimension::k2DOrStacked) {
+    UnsupportedResolveTexture(2); return nullptr;
+  }
+  switch (key.format) {
+    case xenos::TextureFormat::k_8_8_8_8:
+    case xenos::TextureFormat::k_8_8_8_8_AS_16_16_16_16:
+    case xenos::TextureFormat::k_2_10_10_10:
+    case xenos::TextureFormat::k_2_10_10_10_AS_16_16_16_16: break;
+    default: UnsupportedResolveTexture(3); return nullptr;
+  }
+  SyncSubmission();
+  CompletedSubmissionUpdated(submission_.completed_epoch());
+  auto* texture = static_cast<MetalTexture*>(FindOrCreateTexture(key));
+  if (!texture) return nullptr;
+  key = texture->key();
+  if (key.scaled_resolve) { UnsupportedResolveTexture(0); return nullptr; }
+  if (submission_.trace_resolves())
+    REXLOG_INFO("Metal trace frame={} swap-fetch base={:08X} size={}x{} pitch={} "
+                "format={} tiled={} endian={} swizzle={:03X} outdated={} epoch={}",
+                submission_.frame(), uint32_t(key.base_page) << 12, key.GetWidth(), key.GetHeight(),
+                uint32_t(fetch.pitch) << 5, uint32_t(key.format), uint32_t(key.tiled),
+                uint32_t(key.endianness), uint32_t(fetch.swizzle), uint32_t(texture->outdated_mask()),
+                submission_.epoch());
+  if (!LoadTextureData(*texture)) return nullptr;
+  SyncSubmission();
+  texture->MarkAsUsed();
+  uint32_t swizzle = GuestToHostSwizzle(fetch.swizzle, GetHostFormatSwizzle(key));
+  // Metal applies the view swizzle directly; no MoltenVK RB fallback is needed.
+  // Bit 14 distinguishes a non-array base-level swap view from guest views.
+  uint64_t view_key = uint64_t(swizzle) | (uint64_t(1) << 14);
+  auto it = texture->views.find(view_key);
+  MTL::Texture* view = nullptr;
+  if (it != texture->views.end()) view = it->second;
+  else {
+    constexpr MTL::TextureSwizzle channels[] = {
+        MTL::TextureSwizzleRed, MTL::TextureSwizzleGreen, MTL::TextureSwizzleBlue,
+        MTL::TextureSwizzleAlpha, MTL::TextureSwizzleZero, MTL::TextureSwizzleOne,
+        MTL::TextureSwizzleZero, MTL::TextureSwizzleZero};
+    MTL::TextureSwizzleChannels mapping{channels[swizzle & 7], channels[(swizzle >> 3) & 7],
+        channels[(swizzle >> 6) & 7], channels[(swizzle >> 9) & 7]};
+    view = texture->image->newTextureView(GetFormat(key, false).pixel, MTL::TextureType2D,
+        NS::Range::Make(0, 1), NS::Range::Make(0, 1), mapping);
+    if (!view) return nullptr;
+    texture->views.emplace(view_key, view);
+  }
+  if (!view) return nullptr;
+  width = key.GetWidth(); height = key.GetHeight(); format = key.format;
+  return view;
+}
+uint32_t MetalTextureCache::GetMaxHostTextureWidthHeight(xenos::DataDimension dim) const {
+  return dim == xenos::DataDimension::k3D ? 2048 : 16384;
+}
+uint32_t MetalTextureCache::GetMaxHostTextureDepthOrArraySize(xenos::DataDimension dim) const {
+  return dim == xenos::DataDimension::k3D ? 2048 : dim == xenos::DataDimension::kCube ? 6 : 2048;
+}
+MetalTextureCache::Format MetalTextureCache::GetFormat(TextureKey key, bool sign) const {
+  using F = xenos::TextureFormat;
+  // Metal BC textures are 2D/cube; also decompress unaligned base dimensions.
+  const bool bc = bc_ && key.dimension != xenos::DataDimension::k3D &&
+                  !(key.GetWidth() & 3) && !(key.GetHeight() & 3);
+  switch (key.format) {
+    case F::k_8: case F::k_8_A:
+      return {sign ? MTL::PixelFormatR8Snorm : MTL::PixelFormatR8Unorm, kLoadShaderIndex8bpb};
+    case F::k_8_8:
+      return {sign ? MTL::PixelFormatRG8Snorm : MTL::PixelFormatRG8Unorm, kLoadShaderIndex16bpb};
+    case F::k_8_8_8_8: case F::k_8_8_8_8_AS_16_16_16_16:
+      return {sign ? MTL::PixelFormatRGBA8Snorm : MTL::PixelFormatRGBA8Unorm, kLoadShaderIndex32bpb};
+    case F::k_16:
+      return {sign ? MTL::PixelFormatR16Snorm : MTL::PixelFormatR16Unorm, kLoadShaderIndex16bpb};
+    case F::k_16_16:
+      return {sign ? MTL::PixelFormatRG16Snorm : MTL::PixelFormatRG16Unorm, kLoadShaderIndex32bpb};
+    case F::k_16_16_16_16:
+      return {sign ? MTL::PixelFormatRGBA16Snorm : MTL::PixelFormatRGBA16Unorm, kLoadShaderIndex64bpb};
+    case F::k_10_11_11: case F::k_10_11_11_AS_16_16_16_16:
+      return {sign ? MTL::PixelFormatRGBA16Snorm : MTL::PixelFormatRGBA16Unorm,
+              sign ? kLoadShaderIndexR11G11B10ToRGBA16SNorm : kLoadShaderIndexR11G11B10ToRGBA16};
+    case F::k_11_11_10: case F::k_11_11_10_AS_16_16_16_16:
+      return {sign ? MTL::PixelFormatRGBA16Snorm : MTL::PixelFormatRGBA16Unorm,
+              sign ? kLoadShaderIndexR10G11B11ToRGBA16SNorm : kLoadShaderIndexR10G11B11ToRGBA16};
+    case F::k_16_EXPAND: case F::k_16_FLOAT:
+      return {MTL::PixelFormatR16Float, kLoadShaderIndex16bpb};
+    case F::k_16_16_EXPAND: case F::k_16_16_FLOAT:
+      return {MTL::PixelFormatRG16Float, kLoadShaderIndex32bpb};
+    case F::k_16_16_16_16_EXPAND: case F::k_16_16_16_16_FLOAT:
+      return {MTL::PixelFormatRGBA16Float, kLoadShaderIndex64bpb};
+    case F::k_32_FLOAT: return {MTL::PixelFormatR32Float, kLoadShaderIndex32bpb};
+    case F::k_32_32_FLOAT: return {MTL::PixelFormatRG32Float, kLoadShaderIndex64bpb};
+    case F::k_32_32_32_32_FLOAT: return {MTL::PixelFormatRGBA32Float, kLoadShaderIndex128bpb};
+    case F::k_24_8: return {MTL::PixelFormatR32Float, kLoadShaderIndexDepthUnorm};
+    case F::k_24_8_FLOAT: return {MTL::PixelFormatR32Float, kLoadShaderIndexDepthFloat};
+    default: break;
+  }
+  // These formats have no signed interpretation in the SDK's Vulkan cache.
+  if (sign) return {};
+  switch (key.format) {
+    case F::k_1_5_5_5:
+      return {MTL::PixelFormatBGR5A1Unorm, kLoadShaderIndexR5G5B5A1ToB5G5R5A1};
+    case F::k_5_6_5: return {MTL::PixelFormatB5G6R5Unorm, kLoadShaderIndexR5G6B5ToB5G6R5};
+    case F::k_6_5_5:
+      return {MTL::PixelFormatB5G6R5Unorm, kLoadShaderIndexR5G5B6ToB5G6R5WithRBGASwizzle};
+    case F::k_4_4_4_4: return {MTL::PixelFormatABGR4Unorm, kLoadShaderIndexRGBA4ToARGB4};
+    case F::k_2_10_10_10: case F::k_2_10_10_10_AS_16_16_16_16:
+      return {MTL::PixelFormatRGB10A2Unorm, kLoadShaderIndex32bpb};
+    case F::k_Cr_Y1_Cb_Y0_REP: return {MTL::PixelFormatRGBA8Unorm, kLoadShaderIndexGBGR8ToRGB8};
+    case F::k_Y1_Cr_Y0_Cb_REP: return {MTL::PixelFormatRGBA8Unorm, kLoadShaderIndexBGRG8ToRGB8};
+    case F::k_DXT1: case F::k_DXT1_AS_16_16_16_16:
+      return bc ? Format{MTL::PixelFormatBC1_RGBA, kLoadShaderIndex64bpb, true}
+                : Format{MTL::PixelFormatRGBA8Unorm, kLoadShaderIndexDXT1ToRGBA8};
+    case F::k_DXT2_3: case F::k_DXT2_3_AS_16_16_16_16:
+      return bc ? Format{MTL::PixelFormatBC2_RGBA, kLoadShaderIndex128bpb, true}
+                : Format{MTL::PixelFormatRGBA8Unorm, kLoadShaderIndexDXT3ToRGBA8};
+    case F::k_DXT4_5: case F::k_DXT4_5_AS_16_16_16_16:
+      return bc ? Format{MTL::PixelFormatBC3_RGBA, kLoadShaderIndex128bpb, true}
+                : Format{MTL::PixelFormatRGBA8Unorm, kLoadShaderIndexDXT5ToRGBA8};
+    case F::k_DXN:
+      return bc ? Format{MTL::PixelFormatBC5_RGUnorm, kLoadShaderIndex128bpb, true}
+                : Format{MTL::PixelFormatRG8Unorm, kLoadShaderIndexDXNToRG8};
+    case F::k_DXT5A:
+      return bc ? Format{MTL::PixelFormatBC4_RUnorm, kLoadShaderIndex64bpb, true}
+                : Format{MTL::PixelFormatR8Unorm, kLoadShaderIndexDXT5AToR8};
+    case F::k_DXT3A: return {MTL::PixelFormatR8Unorm, kLoadShaderIndexDXT3A};
+    case F::k_DXT3A_AS_1_1_1_1:
+      return {MTL::PixelFormatABGR4Unorm, kLoadShaderIndexDXT3AAs1111ToARGB4};
+    case F::k_CTX1: return {MTL::PixelFormatRG8Unorm, kLoadShaderIndexCTX1};
+    default: return {};
+  }
+}
+bool MetalTextureCache::IsSignedVersionSeparateForFormat(TextureKey key) const {
+  auto u = GetFormat(key, false), s = GetFormat(key, true);
+  return s.pixel != MTL::PixelFormatInvalid && s.load != u.load;
+}
+uint32_t MetalTextureCache::GetHostFormatSwizzle(TextureKey key) const {
+  using F = xenos::TextureFormat;
+  switch (key.format) {
+    case F::k_8: case F::k_8_A: case F::k_16: case F::k_16_EXPAND: case F::k_16_FLOAT:
+    case F::k_32_FLOAT: case F::k_24_8: case F::k_24_8_FLOAT: case F::k_DXT3A: case F::k_DXT5A:
+      return xenos::XE_GPU_TEXTURE_SWIZZLE_RRRR;
+    case F::k_8_8: case F::k_16_16: case F::k_16_16_EXPAND: case F::k_16_16_FLOAT:
+    case F::k_32_32_FLOAT: case F::k_DXN: case F::k_CTX1:
+      return xenos::XE_GPU_TEXTURE_SWIZZLE_RGGG;
+    case F::k_5_6_5: case F::k_10_11_11: case F::k_11_11_10:
+    case F::k_10_11_11_AS_16_16_16_16: case F::k_11_11_10_AS_16_16_16_16:
+    case F::k_Cr_Y1_Cb_Y0_REP: case F::k_Y1_Cr_Y0_Cb_REP:
+      return xenos::XE_GPU_TEXTURE_SWIZZLE_RGBB;
+    case F::k_6_5_5: return XE_GPU_MAKE_TEXTURE_SWIZZLE(R, B, G, G);
+    // Vulkan B4G4R4A4 maps to Metal ABGR4 with R/B exchanged (MoltenVK).
+    case F::k_4_4_4_4: case F::k_DXT3A_AS_1_1_1_1:
+      return XE_GPU_MAKE_TEXTURE_SWIZZLE(B, G, R, A);
+    default: return xenos::XE_GPU_TEXTURE_SWIZZLE_RGBA;
+  }
+}
+std::unique_ptr<TextureCache::Texture> MetalTextureCache::CreateTexture(TextureKey key) {
+  auto format = GetFormat(key, key.signed_separate);
+  if (key.scaled_resolve) { UnsupportedResolveTexture(0); return nullptr; }
+  if (format.pixel == MTL::PixelFormatInvalid) return nullptr;
+  const bool volume = key.dimension == xenos::DataDimension::k3D;
+  const bool cube = key.dimension == xenos::DataDimension::kCube;
+  auto desc = Adopt(MTL::TextureDescriptor::alloc()->init());
+  // The guest translator represents both 1D and stacked 2D as texture2d_array.
+  desc->setTextureType(volume ? MTL::TextureType3D : cube ? MTL::TextureTypeCube
+                                                        : MTL::TextureType2DArray);
+  desc->setPixelFormat(format.pixel);
+  desc->setWidth(key.GetWidth()); desc->setHeight(key.GetHeight());
+  desc->setDepth(volume ? key.GetDepthOrArraySize() : 1);
+  desc->setArrayLength(volume || cube ? 1 : key.GetDepthOrArraySize());
+  desc->setMipmapLevelCount(key.mip_max_level + 1);
+  desc->setStorageMode(MTL::StorageModePrivate);
+  desc->setUsage(MTL::TextureUsageShaderRead | MTL::TextureUsagePixelFormatView);
+  auto* texture = device_->newTexture(desc.get());
+  if (!texture) {
+    REXLOG_ERROR("Metal texture allocation failed: format={}, size={}x{}x{}",
+                 uint32_t(key.format), key.GetWidth(), key.GetHeight(), key.GetDepthOrArraySize());
+    return nullptr;
+  }
+  return std::make_unique<MetalTexture>(*this, key, texture);
+}
+MTL::ComputePipelineState* MetalTextureCache::GetLoader(LoadShaderIndex index) {
+  if (index >= kLoadShaderCount) return nullptr;
+  auto& loader = loaders_[index];
+  if (loader.attempted) return loader.pipeline;
+  loader.attempted = true;
+  const uint32_t* code = nullptr;
+  size_t count = 0;
+  switch (index) {
+#define LOAD(index, name) case kLoadShaderIndex##index: \
+    code = shaders::texture_load_##name##_cs; count = std::size(shaders::texture_load_##name##_cs); break
+    LOAD(8bpb, 8bpb);
+    LOAD(16bpb, 16bpb);
+    LOAD(32bpb, 32bpb);
+    LOAD(64bpb, 64bpb);
+    LOAD(128bpb, 128bpb);
+    LOAD(R5G5B5A1ToB5G5R5A1, r5g5b5a1_b5g5r5a1);
+    LOAD(R5G6B5ToB5G6R5, r5g6b5_b5g6r5);
+    LOAD(R5G5B6ToB5G6R5WithRBGASwizzle, r5g5b6_b5g6r5_swizzle_rbga);
+    LOAD(RGBA4ToARGB4, r4g4b4a4_a4r4g4b4);
+    LOAD(GBGR8ToRGB8, gbgr8_rgb8);
+    LOAD(BGRG8ToRGB8, bgrg8_rgb8);
+    LOAD(R10G11B11ToRGBA16, r10g11b11_rgba16);
+    LOAD(R10G11B11ToRGBA16SNorm, r10g11b11_rgba16_snorm);
+    LOAD(R11G11B10ToRGBA16, r11g11b10_rgba16);
+    LOAD(R11G11B10ToRGBA16SNorm, r11g11b10_rgba16_snorm);
+    LOAD(DXT1ToRGBA8, dxt1_rgba8);
+    LOAD(DXT3ToRGBA8, dxt3_rgba8);
+    LOAD(DXT5ToRGBA8, dxt5_rgba8);
+    LOAD(DXNToRG8, dxn_rg8);
+    LOAD(DXT3A, dxt3a);
+    LOAD(DXT3AAs1111ToARGB4, dxt3aas1111_argb4);
+    LOAD(DXT5AToR8, dxt5a_r8);
+    LOAD(CTX1, ctx1);
+    LOAD(DepthUnorm, depth_unorm);
+    LOAD(DepthFloat, depth_float);
+#undef LOAD
+    default: return nullptr;
+  }
+  loader.function.hash = uint64_t(index);
+  if (!CompileTextureLoadMSL(device_, code, count, loader.function)) return nullptr;
+  NS::Error* error = nullptr;
+  loader.pipeline = device_->newComputePipelineState(loader.function.function, &error);
+  if (!loader.pipeline) REXLOG_ERROR("Metal texture-load pipeline {}: {}", uint32_t(index), ErrorText(error));
+  return loader.pipeline;
+}
+bool MetalTextureCache::GrowBuffer(MTL::Buffer*& buffer, size_t size) {
+  if (!size || size > device_->maxBufferLength() || size > UINT32_MAX) return false;
+  if (buffer && buffer->length() >= size) return true;
+  auto* replacement = device_->newBuffer(size, MTL::ResourceStorageModePrivate);
+  if (!replacement) return false;
+  ReleaseObject(buffer);  // Previously encoded commands retain the old buffer.
+  buffer = replacement;
+  return true;
+}
+bool MetalTextureCache::LoadTextureDataFromResidentMemoryImpl(Texture& base, bool load_base,
+                                                               bool load_mips) {
+  static_assert(sizeof(LoadConstants) == 40 && offsetof(LoadConstants, host_offset) == 28 &&
+                offsetof(LoadConstants, host_pitch) == 32 && offsetof(LoadConstants, height_texels) == 36);
+  auto& texture = static_cast<MetalTexture&>(base);
+  const auto key = texture.key();
+  if (submission_.trace_resolves())
+    REXLOG_INFO("Metal trace frame={} texture-load base={:08X}+{} mips={:08X}+{} "
+                "load={}/{} format={} tiled={} endian={} epoch={}",
+                submission_.frame(), uint32_t(key.base_page) << 12, texture.GetGuestBaseSize(),
+                uint32_t(key.mip_page) << 12, texture.GetGuestMipsSize(), load_base, load_mips,
+                uint32_t(key.format), uint32_t(key.tiled), uint32_t(key.endianness),
+                submission_.epoch());
+  if (key.scaled_resolve) return UnsupportedResolveTexture(0);
+  const auto format = GetFormat(key, key.signed_separate);
+  auto* pipeline = GetLoader(format.load);
+  if (!pipeline) return false;
+  if (!repack_.attempted) {
+    repack_.attempted = true;
+    // Byte copies also support R8 packed tails with offsets/row sizes that
+    // aren't multiples of four (invalid for Metal buffer-to-buffer blits).
+    constexpr const char* source = R"MSL(
+#include <metal_stdlib>
+using namespace metal;
+struct Copy { uint4 src; uint4 dst; uint4 extent; };
+kernel void repack(device const uchar* src [[buffer(0)]], device uchar* dst [[buffer(1)]],
+                   constant Copy& c [[buffer(2)]], uint3 p [[thread_position_in_grid]]) {
+  if (any(p >= c.extent.xyz)) return;
+  dst[c.dst.x + p.z * c.dst.z + p.y * c.dst.y + p.x] =
+      src[c.src.x + p.z * c.src.z + p.y * c.src.y + p.x];
+}
+)MSL";
+    auto options = Adopt(MTL::CompileOptions::alloc()->init());
+    options->setLanguageVersion(MTL::LanguageVersion2_4);
+    NS::Error* error = nullptr;
+    repack_.function.library = device_->newLibrary(
+        NS::String::string(source, NS::UTF8StringEncoding), options.get(), &error);
+    if (repack_.function.library) {
+      repack_.function.function = repack_.function.library->newFunction(
+          NS::String::string("repack", NS::UTF8StringEncoding));
+      if (repack_.function.function)
+        repack_.pipeline = device_->newComputePipelineState(repack_.function.function, &error);
+    }
+    if (!repack_.pipeline) {
+      PERF_METAL_counter_add(kMetalMslCompileFailures, 1);
+      REXLOG_ERROR("Metal texture repack compilation failed: {}", ErrorText(error));
+    }
+  }
+  if (!repack_.pipeline) return false;
+  const auto& info = GetLoadShaderInfo(format.load);
+  const auto& guest = texture.guest_layout();
+  const auto* guest_format = FormatInfo::Get(key.format);
+  const uint32_t bw = guest_format->block_width, bh = guest_format->block_height;
+  const uint32_t hb = format.compressed ? bw : 1, hv = format.compressed ? bh : 1;
+  const uint32_t bpb = info.bytes_per_host_block;
+  const bool volume = key.dimension == xenos::DataDimension::k3D;
+  const uint32_t depth = volume ? key.GetDepthOrArraySize() : 1;
+  const uint32_t layers = volume ? 1 : key.GetDepthOrArraySize();
+  const uint32_t first = load_base ? 0 : 1, last = load_mips ? key.mip_max_level : 0;
+  const uint32_t packed = guest.packed_level;
+  const uint32_t loop_first = packed ? std::min(first, packed) : uint32_t(first != 0);
+  const uint32_t loop_last = packed ? std::min(last, packed) : uint32_t(last != 0);
+  if (first > last) return false;
+  struct Stored {
+    bool base;
+    uint32_t level, offset, pitch, rows, depth, slice_bytes;
+    LoadConstants constants;
+  };
+  std::vector<Stored> stored;
+  uint64_t untiled_size = 0;
+  for (uint32_t loop = loop_first; loop <= loop_last; ++loop) {
+    const bool is_base = loop == 0;
+    const uint32_t level = packed ? loop : 0;
+    const auto& layout = is_base ? guest.base : guest.mips[level];
+    const uint32_t w = level == packed ? layout.x_extent_blocks * bw
+                                      : std::max(key.GetWidth() >> level, 1u);
+    const uint32_t h = level == packed ? layout.y_extent_blocks * bh
+                                      : std::max(key.GetHeight() >> level, 1u);
+    const uint32_t d = level == packed ? layout.z_extent : std::max(depth >> level, 1u);
+    const uint32_t blocks_per_thread =
+        (1u << info.guest_x_blocks_per_thread_log2) * (format.compressed ? 1 : bw);
+    const uint32_t pitch = rex::align(rex::round_up((w + hb - 1) / hb, blocks_per_thread) * bpb, 256u);
+    const uint32_t rows = (h + hv - 1) / hv;
+    const uint64_t slice_bytes = uint64_t(pitch) * rows * d;
+    if (!slice_bytes || untiled_size + slice_bytes * layers > UINT32_MAX) return false;
+    LoadConstants c{};
+    c.is_tiled_3d_endian_scale = uint32_t(key.tiled) | (uint32_t(volume) << 1) |
+        (uint32_t(key.endianness) << 2) | (1u << 4) | (1u << 7);
+    c.guest_offset = ((is_base ? key.base_page : key.mip_page) << 12) +
+                      (is_base ? 0 : guest.mip_offsets_bytes[level]);
+    c.guest_pitch_aligned = layout.row_pitch_bytes /
+                            (key.tiled ? guest_format->bytes_per_block() : 1);
+    c.guest_z_stride_block_rows_aligned = layout.z_slice_stride_block_rows;
+    c.size_blocks[0] = (w + bw - 1) / bw;
+    c.size_blocks[1] = (h + bh - 1) / bh;
+    c.size_blocks[2] = d;
+    c.host_offset = uint32_t(untiled_size);
+    c.host_pitch = pitch;
+    c.height_texels = h;
+    stored.push_back({is_base, level, uint32_t(untiled_size), pitch, rows, d,
+                      uint32_t(slice_bytes), c});
+    untiled_size += slice_bytes * layers;
+  }
+  struct Copy {
+    std::array<uint32_t, 12> c;
+    uint32_t width, height, depth, layer, level;
+  };
+  std::vector<Copy> copies;
+  uint64_t upload_size = 0;
+  for (uint32_t level = first; level <= last; ++level) {
+    auto it = std::find_if(stored.begin(), stored.end(), [&](const Stored& s) {
+      return s.base == (level == 0) && s.level == std::min(level, packed);
+    });
+    if (it == stored.end()) return false;
+    const uint32_t w = std::max(key.GetWidth() >> level, 1u);
+    const uint32_t h = std::max(key.GetHeight() >> level, 1u);
+    const uint32_t d = std::max(depth >> level, 1u);
+    uint32_t x = 0, y = 0, z = 0;
+    if (level >= packed) {
+      texture_util::GetPackedMipOffset(key.GetWidth(), key.GetHeight(), depth, key.format,
+                                       level, x, y, z);
+      if (!format.compressed) { x *= bw; y *= bh; }
+    }
+    const uint32_t row_bytes = ((w + hb - 1) / hb) * bpb;
+    const uint32_t rows = (h + hv - 1) / hv;
+    const uint32_t dst_pitch = rex::align(row_bytes, 256u);
+    const uint64_t dst_image = uint64_t(dst_pitch) * rows;
+    const uint64_t src_image = uint64_t(it->pitch) * it->rows;
+    // Check packed-tail extents before generating any GPU commands.
+    if (uint64_t(x) * bpb + row_bytes > it->pitch || y + rows > it->rows || z + d > it->depth)
+      return false;
+    for (uint32_t layer = 0; layer < layers; ++layer) {
+      const uint64_t src_offset = uint64_t(it->offset) + uint64_t(layer) * it->slice_bytes +
+                                  uint64_t(z) * src_image + uint64_t(y) * it->pitch + uint64_t(x) * bpb;
+      if (upload_size + dst_image * d > UINT32_MAX) return false;
+      copies.push_back({{uint32_t(src_offset), it->pitch, uint32_t(src_image), 0,
+                         uint32_t(upload_size), dst_pitch, uint32_t(dst_image), 0,
+                         row_bytes, rows, d, 0}, w, h, d, layer, level});
+      upload_size += dst_image * d;
+    }
+  }
+  if (!GrowBuffer(untiled_, size_t(untiled_size)) || !GrowBuffer(upload_, size_t(upload_size)) ||
+      !submission_.Begin()) return false;
+  SyncSubmission();
+  texture.MarkAsUsed();
+  submission_.EndEncoding(perf::CounterId::kPassEndBarrierTexture);
+  auto* encoder = submission_.buffer()->computeCommandEncoder();
+  if (!encoder) return false;
+  encoder->setComputePipelineState(pipeline);
+  encoder->setBuffer(untiled_, 0, 1);
+  encoder->setBuffer(shared_.buffer(), 0, 2);
+  for (const auto& s : stored) {
+    auto c = s.constants;
+    const auto& layout = s.base ? guest.base : guest.mips[s.level];
+    for (uint32_t layer = 0; layer < layers; ++layer) {
+      // Pad the binding size, not the ABI's uint3 / host_offset boundary.
+      std::array<uint32_t, 12> constants{};
+      std::memcpy(constants.data(), &c, sizeof(c));
+      encoder->setBytes(constants.data(), sizeof(constants), 0);
+      const uint32_t gx = 1u << info.GetGuestXBlocksPerGroupLog2();
+      encoder->dispatchThreadgroups(
+          MTL::Size((c.size_blocks[0] + gx - 1) / gx, (c.size_blocks[1] + 31) / 32,
+                    c.size_blocks[2]), MTL::Size(4, 32, 1));
+      c.guest_offset += layout.array_slice_stride_bytes;
+      c.host_offset += s.slice_bytes;
+    }
+  }
+  encoder->endEncoding();
+  // Mark source ranges even if a later encoder allocation fails: the compute
+  // reads have already been queued, and CPU snapshot overwrites must wait.
+  if (load_base) shared_.MarkUsed(key.base_page << 12, rex::align(texture.GetGuestBaseSize(), 16u));
+  if (load_mips) shared_.MarkUsed(key.mip_page << 12, rex::align(texture.GetGuestMipsSize(), 16u));
+  encoder = submission_.buffer()->computeCommandEncoder();
+  if (!encoder) return false;
+  encoder->setComputePipelineState(repack_.pipeline);
+  encoder->setBuffer(untiled_, 0, 0);
+  encoder->setBuffer(upload_, 0, 1);
+  for (const auto& copy : copies) {
+    encoder->setBytes(copy.c.data(), sizeof(copy.c), 2);
+    encoder->dispatchThreadgroups(MTL::Size((copy.c[8] + 15) / 16, (copy.c[9] + 7) / 8,
+                                            copy.depth), MTL::Size(16, 8, 1));
+  }
+  encoder->endEncoding();
+  auto* blit = submission_.buffer()->blitCommandEncoder();
+  if (!blit) return false;
+  for (const auto& copy : copies)
+    blit->copyFromBuffer(upload_, copy.c[4], copy.c[5], copy.c[6],
+        MTL::Size(copy.width, copy.height, copy.depth), texture.image, copy.layer, copy.level,
+        MTL::Origin(0, 0, 0));
+  blit->endEncoding();
+  // All resources use Metal's tracked hazards, on the same queue as guest draws.
+  texture.slice_dirty = true;
+  PERF_METAL_counter_add(kMetalTextureLoads, 1);
+  return true;
+}
+bool MetalTextureCache::PrepareSlice(MetalTexture& texture) {
+  if (!texture.slice_dirty) return true;
+  if (!texture.slice) {
+    auto desc = Adopt(MTL::TextureDescriptor::alloc()->init());
+    desc->setTextureType(MTL::TextureType2DArray);
+    desc->setPixelFormat(texture.image->pixelFormat());
+    desc->setWidth(texture.image->width()); desc->setHeight(texture.image->height());
+    desc->setMipmapLevelCount(texture.image->mipmapLevelCount());
+    desc->setStorageMode(MTL::StorageModePrivate);
+    desc->setUsage(MTL::TextureUsageShaderRead | MTL::TextureUsagePixelFormatView);
+    texture.slice = device_->newTexture(desc.get());
+    if (!texture.slice) return false;
+    texture.AccountMemory();
+  }
+  if (!submission_.Begin()) return false;
+  submission_.EndEncoding(perf::CounterId::kPassEndBarrierTexture);
+  auto* blit = submission_.buffer()->blitCommandEncoder();
+  if (!blit) return false;
+  const auto key = texture.key();
+  for (uint32_t level = key.base_page ? 0 : 1; level <= key.mip_max_level; ++level)
+    blit->copyFromTexture(texture.image, 0, level, MTL::Origin(0, 0, 0),
+        MTL::Size(std::max(key.GetWidth() >> level, 1u), std::max(key.GetHeight() >> level, 1u), 1),
+        texture.slice, 0, level, MTL::Origin(0, 0, 0));
+  blit->endEncoding();
+  texture.slice_dirty = false;
+  return true;
+}
+MTL::Texture* MetalTextureCache::GetTexture(const SpirvShader::TextureBinding& request, bool& missing) {
+  const auto* binding = GetValidTextureBinding(request.fetch_constant);
+  missing = !binding;
+  if (!binding) return nullptr;
+  const bool sign = request.is_signed;
+  const bool needed_sign = sign ? texture_util::IsAnySignSigned(binding->swizzled_signs)
+                                : texture_util::IsAnySignNotSigned(binding->swizzled_signs);
+  const auto dim = request.dimension;
+  const auto guest_dim = binding->key.dimension;
+  const bool want_volume = dim == xenos::FetchOpDimension::k3DOrStacked;
+  const bool want_cube = dim == xenos::FetchOpDimension::kCube;
+  // The translator emits both 2D-array and 3D resources for a 3D/stacked fetch.
+  // Unselected dimension/sign descriptors must be valid but aren't failed draws.
+  if ((want_volume && guest_dim != xenos::DataDimension::k3D) ||
+      want_cube != (guest_dim == xenos::DataDimension::kCube)) return nullptr;
+  const bool slice = !want_volume && guest_dim == xenos::DataDimension::k3D;
+  if (slice && !REXCVAR_GET(gpu_3d_to_2d_texture)) return nullptr;
+  auto* texture = static_cast<MetalTexture*>(sign && IsSignedVersionSeparateForFormat(binding->key)
+                                               ? binding->texture_signed : binding->texture);
+  auto format = GetFormat(binding->key, sign);
+  auto* image = texture ? (slice ? texture->slice : texture->image) : nullptr;
+  missing = needed_sign && (!texture || texture->outdated_mask() || !image ||
+                            (slice && texture->slice_dirty) || format.pixel == MTL::PixelFormatInvalid);
+  if (missing) {
+    uint8_t bit = uint8_t(1u << uint32_t(sign));
+    auto& logged = unsupported_[uint32_t(binding->key.format)];
+    if (!(logged & bit)) {
+      logged |= bit;
+      REXLOG_WARN("Metal texture fallback: format={}, signed={}, dimension={}, resident={}",
+          uint32_t(binding->key.format), sign, uint32_t(guest_dim),
+          texture && !texture->outdated_mask());
+    }
+    return nullptr;
+  }
+  if (!image || format.pixel == MTL::PixelFormatInvalid) return nullptr;
+  const uint64_t view_key = uint64_t(binding->host_swizzle) | (uint64_t(sign) << 12) |
+                            (uint64_t(slice) << 13);
+  auto it = texture->views.find(view_key);
+  if (it != texture->views.end()) {
+    missing = needed_sign && !it->second;
+    return it->second;
+  }
+  constexpr MTL::TextureSwizzle swizzles[] = {
+      MTL::TextureSwizzleRed, MTL::TextureSwizzleGreen, MTL::TextureSwizzleBlue,
+      MTL::TextureSwizzleAlpha, MTL::TextureSwizzleZero, MTL::TextureSwizzleOne,
+      MTL::TextureSwizzleZero, MTL::TextureSwizzleZero};
+  auto swizzle = binding->host_swizzle;
+  MTL::TextureSwizzleChannels channels{swizzles[swizzle & 7], swizzles[(swizzle >> 3) & 7],
+                                      swizzles[(swizzle >> 6) & 7], swizzles[(swizzle >> 9) & 7]};
+  const uint32_t slices = want_volume ? 1 : want_cube ? 6 : uint32_t(image->arrayLength());
+  auto* view = image->newTextureView(format.pixel, image->textureType(),
+      NS::Range::Make(0, image->mipmapLevelCount()), NS::Range::Make(0, slices), channels);
+  texture->views.emplace(view_key, view);
+  missing = needed_sign && !view;
+  return view;
+}
+MTL::SamplerState* MetalTextureCache::GetSampler(const SpirvShader::SamplerBinding& b) {
+  const auto fetch = register_file().GetTextureFetch(b.fetch_constant);
+  xenos::ClampMode x, y, z;
+  texture_util::GetClampModesForDimension(fetch, x, y, z);
+  // Same approximations as Vulkan for halfway and mirror-to-border modes.
+  constexpr MTL::SamplerAddressMode modes[] = {
+      MTL::SamplerAddressModeRepeat, MTL::SamplerAddressModeMirrorRepeat,
+      MTL::SamplerAddressModeClampToEdge, MTL::SamplerAddressModeMirrorClampToEdge,
+      MTL::SamplerAddressModeClampToEdge, MTL::SamplerAddressModeMirrorClampToEdge,
+      MTL::SamplerAddressModeClampToBorderColor, MTL::SamplerAddressModeMirrorClampToEdge};
+  auto filter = [](xenos::TextureFilter instruction, xenos::TextureFilter constant) {
+    return instruction == xenos::TextureFilter::kUseFetchConst ? constant : instruction;
+  };
+  auto mag = filter(b.mag_filter, fetch.mag_filter), min = filter(b.min_filter, fetch.min_filter);
+  auto mip = filter(b.mip_filter, fetch.mip_filter);
+  auto aniso = b.aniso_filter == xenos::AnisoFilter::kUseFetchConst ? fetch.aniso_filter : b.aniso_filter;
+  uint32_t first, last;
+  texture_util::GetSubresourcesFromFetchConstant(fetch, nullptr, nullptr, nullptr, nullptr, nullptr,
+                                                 &first, &last);
+  const bool base_map = mip == xenos::TextureFilter::kBaseMap;
+  int32_t override = REXCVAR_GET(anisotropic_override);
+  if (override >= 0 && override < 6 && last > first && !base_map &&
+      mag == xenos::TextureFilter::kLinear && min == xenos::TextureFilter::kLinear &&
+      (mip == xenos::TextureFilter::kPoint || mip == xenos::TextureFilter::kLinear))
+    aniso = xenos::AnisoFilter(override);
+  uint32_t anisotropy = std::min(uint32_t(aniso), 5u);
+  bool linear_mag = mag == xenos::TextureFilter::kLinear || anisotropy;
+  bool linear_min = min == xenos::TextureFilter::kLinear || anisotropy;
+  bool linear_mip = mip == xenos::TextureFilter::kLinear || anisotropy;
+  const auto* binding = GetValidTextureBinding(b.fetch_constant);
+  auto format = binding ? GetFormat(binding->key, false).pixel : MTL::PixelFormatInvalid;
+  if (!float32_filter_ && (format == MTL::PixelFormatR32Float || format == MTL::PixelFormatRG32Float ||
+                           format == MTL::PixelFormatRGBA32Float)) {
+    linear_mag = linear_min = linear_mip = false;
+    anisotropy = 0;
+  }
+  auto border = MTL::SamplerBorderColorTransparentBlack;
+  const bool uses_border = modes[uint32_t(x)] == MTL::SamplerAddressModeClampToBorderColor ||
+      modes[uint32_t(y)] == MTL::SamplerAddressModeClampToBorderColor ||
+      modes[uint32_t(z)] == MTL::SamplerAddressModeClampToBorderColor;
+  if (uses_border) {
+    if (fetch.border_color == xenos::BorderColor::k_ABGR_White) border = MTL::SamplerBorderColorOpaqueWhite;
+    else if (fetch.border_color != xenos::BorderColor::k_ABGR_Black && !border_warning_) {
+      REXLOG_WARN("Metal: YCbCr custom sampler borders use transparent black (Vulkan fallback)");
+      border_warning_ = true;
+    }
+  }
+  const uint64_t key = uint64_t(x) | (uint64_t(y) << 3) | (uint64_t(z) << 6) |
+      (uint64_t(border) << 9) | (uint64_t(linear_mag) << 11) | (uint64_t(linear_min) << 12) |
+      (uint64_t(linear_mip) << 13) | (uint64_t(anisotropy) << 14) | (uint64_t(first) << 17) |
+      (uint64_t(last) << 21) | (uint64_t(base_map) << 25);
+  auto it = samplers_.find(key);
+  if (it != samplers_.end()) return it->second;
+  auto desc = Adopt(MTL::SamplerDescriptor::alloc()->init());
+  desc->setNormalizedCoordinates(true);
+  desc->setSAddressMode(modes[uint32_t(x)]); desc->setTAddressMode(modes[uint32_t(y)]);
+  desc->setRAddressMode(modes[uint32_t(z)]);
+  desc->setBorderColor(border);
+  desc->setMagFilter(linear_mag ? MTL::SamplerMinMagFilterLinear : MTL::SamplerMinMagFilterNearest);
+  desc->setMinFilter(linear_min ? MTL::SamplerMinMagFilterLinear : MTL::SamplerMinMagFilterNearest);
+  desc->setMipFilter(linear_mip ? MTL::SamplerMipFilterLinear : MTL::SamplerMipFilterNearest);
+  desc->setMaxAnisotropy(anisotropy ? (1u << (anisotropy - 1)) : 1);
+  // Fetch/instruction LOD biases are already applied by SpirvShaderTranslator.
+  desc->setLodMinClamp(float(first));
+  desc->setLodMaxClamp(base_map ? std::min(float(first) + 0.25f, float(last)) : float(last));
+  auto* sampler = device_->newSamplerState(desc.get());
+  samplers_.emplace(key, sampler);
+  return sampler;
+}
