diff --git a/src/ui/metal/immediate_drawer.cpp b/src/ui/metal/immediate_drawer.cpp
new file mode 100644
index 0000000..4a0250a
--- /dev/null
+++ b/src/ui/metal/immediate_drawer.cpp
@@ -0,0 +1,221 @@
+#include <rex/ui/metal/immediate_drawer.h>
+#if defined(__APPLE__) && defined(REX_HAS_METAL) && REX_HAS_METAL
+
+#include <cstddef>
+#include <vector>
+#include <rex/ui/metal/presenter.h>
+#include <rex/ui/metal/provider.h>
+#include "metal_util.h"
+
+namespace rex::ui::metal {
+namespace {
+// Packed fields match ImmediateVertex's 20-byte layout, including ImGui RGBA.
+constexpr char kShader[] = R"msl(
+#include <metal_stdlib>
+using namespace metal;
+struct Vertex { packed_float2 position; packed_float2 uv; uint color; };
+struct Out { float4 position [[position]]; float2 uv; float4 color; };
+vertex Out ui_vertex(uint id [[vertex_id]],
+                     const device Vertex* vertices [[buffer(0)]],
+                     constant float2& inverse_size [[buffer(1)]]) {
+  Vertex v = vertices[id];
+  Out o;
+  o.position = float4(float2(v.position) * inverse_size * float2(2, -2)
+                      + float2(-1, 1), 0, 1);
+  o.uv = float2(v.uv);
+  o.color = float4(v.color & 255u, (v.color >> 8) & 255u,
+                   (v.color >> 16) & 255u, v.color >> 24) / 255.0;
+  return o;
+}
+fragment float4 ui_fragment(Out in [[stage_in]], texture2d<float> tex [[texture(0)]],
+                            sampler sam [[sampler(0)]],
+                            constant uint& opaque [[buffer(0)]]) {
+  float4 texel = tex.sample(sam, in.uv);
+  if (opaque) texel.a = 1;
+  return in.color * texel;
+}
+)msl";
+static_assert(sizeof(ImmediateVertex) == 20);
+static_assert(offsetof(ImmediateVertex, u) == 8);
+static_assert(offsetof(ImmediateVertex, color) == 16);
+}  // namespace
+
+class MetalImmediateDrawer::Texture final : public ImmediateTexture {
+ public:
+  Texture(uint32_t width, uint32_t height, MTL::Texture* texture, MTL::SamplerState* sampler)
+      : ImmediateTexture(width, height), texture(texture), sampler(sampler) {}
+  ~Texture() override {
+    ReleaseObject(texture);
+    ReleaseObject(sampler);
+  }
+  MTL::Texture* texture;
+  MTL::SamplerState* sampler;
+  bool opaque = false;
+};
+
+MetalImmediateDrawer::MetalImmediateDrawer(MetalProvider& provider) : provider_(provider) {}
+MetalImmediateDrawer::~MetalImmediateDrawer() {
+  EndDrawBatch();
+  ReleaseObject(pipeline_);
+}
+
+bool MetalImmediateDrawer::Initialize() {
+  auto pool = Adopt(NS::AutoreleasePool::alloc()->init());
+  NS::Error* error = nullptr;
+  // metal-cpp's newLibrary(source, options, error) wraps newLibraryWithSource.
+  auto library = Adopt(provider_.device()->newLibrary(
+      NS::String::string(kShader, NS::UTF8StringEncoding), nullptr, &error));
+  if (!library) {
+    REXLOG_ERROR("Metal UI shader compilation failed: {}",
+                 ErrorText(error));
+    return false;
+  }
+  auto vertex = Adopt(library->newFunction(
+      NS::String::string("ui_vertex", NS::UTF8StringEncoding)));
+  auto fragment = Adopt(library->newFunction(
+      NS::String::string("ui_fragment", NS::UTF8StringEncoding)));
+  if (!vertex || !fragment) return false;
+  auto descriptor = Adopt(MTL::RenderPipelineDescriptor::alloc()->init());
+  descriptor->setVertexFunction(vertex.get());
+  descriptor->setFragmentFunction(fragment.get());
+  auto* color = descriptor->colorAttachments()->object(0);
+  color->setPixelFormat(MTL::PixelFormatBGRA8Unorm);
+  color->setBlendingEnabled(true);
+  color->setRgbBlendOperation(MTL::BlendOperationAdd);
+  color->setAlphaBlendOperation(MTL::BlendOperationAdd);
+  color->setSourceRGBBlendFactor(MTL::BlendFactorSourceAlpha);
+  color->setDestinationRGBBlendFactor(MTL::BlendFactorOneMinusSourceAlpha);
+  color->setSourceAlphaBlendFactor(MTL::BlendFactorOne);
+  color->setDestinationAlphaBlendFactor(MTL::BlendFactorOneMinusSourceAlpha);
+  pipeline_ = provider_.device()->newRenderPipelineState(descriptor.get(), &error);
+  if (!pipeline_) {
+    REXLOG_ERROR("Metal UI pipeline creation failed: {}",
+                 ErrorText(error));
+    return false;
+  }
+  const uint8_t white[4] = {255, 255, 255, 255};
+  white_ = CreateTexture(1, 1, ImmediateTextureFilter::kLinear, false, white);
+  return white_ != nullptr;
+}
+
+std::unique_ptr<ImmediateTexture> MetalImmediateDrawer::CreateTexture(
+    uint32_t width, uint32_t height, ImmediateTextureFilter filter,
+    bool is_repeated, const uint8_t* data) {
+  if (!width || !height || width > 16384 || height > 16384) return nullptr;
+  auto pool = Adopt(NS::AutoreleasePool::alloc()->init());
+  auto descriptor = Adopt(MTL::TextureDescriptor::alloc()->init());
+  descriptor->setTextureType(MTL::TextureType2D);
+  descriptor->setPixelFormat(MTL::PixelFormatRGBA8Unorm);
+  descriptor->setWidth(width);
+  descriptor->setHeight(height);
+  descriptor->setUsage(MTL::TextureUsageShaderRead);
+  descriptor->setStorageMode(provider_.device()->hasUnifiedMemory()
+                                 ? MTL::StorageModeShared : MTL::StorageModeManaged);
+  auto texture = Adopt(provider_.device()->newTexture(descriptor.get()));
+  if (!texture) return nullptr;
+  std::vector<uint8_t> zeroes;
+  if (!data) {
+    zeroes.resize(size_t(width) * height * 4);
+    data = zeroes.data();
+  }
+  texture->replaceRegion(MTL::Region(0, 0, width, height), 0, data, size_t(width) * 4);
+  auto sampler_descriptor = Adopt(MTL::SamplerDescriptor::alloc()->init());
+  auto metal_filter = filter == ImmediateTextureFilter::kNearest
+                          ? MTL::SamplerMinMagFilterNearest : MTL::SamplerMinMagFilterLinear;
+  sampler_descriptor->setMinFilter(metal_filter);
+  sampler_descriptor->setMagFilter(metal_filter);
+  sampler_descriptor->setNormalizedCoordinates(true);
+  auto address = is_repeated ? MTL::SamplerAddressModeRepeat : MTL::SamplerAddressModeClampToEdge;
+  sampler_descriptor->setSAddressMode(address);
+  sampler_descriptor->setTAddressMode(address);
+  auto sampler = Adopt(provider_.device()->newSamplerState(sampler_descriptor.get()));
+  if (!sampler) return nullptr;
+  return std::make_unique<Texture>(width, height, texture.release(), sampler.release());
+}
+
+std::unique_ptr<ImmediateTexture> MetalImmediateDrawer::WrapTexture(MTL::Texture* texture) {
+  if (!texture || !white_) return nullptr;
+  auto* sampler = static_cast<Texture*>(white_.get())->sampler;
+  texture->retain();
+  sampler->retain();
+  auto wrapped = std::make_unique<Texture>(uint32_t(texture->width()), uint32_t(texture->height()),
+                                           texture, sampler);
+  wrapped->opaque = true;
+  return wrapped;
+}
+
+void MetalImmediateDrawer::Begin(UIDrawContext& context, float width, float height) {
+  ImmediateDrawer::Begin(context, width, height);
+  encoder_ = static_cast<MetalUIDrawContext&>(context).encoder();
+  encoder_->setRenderPipelineState(pipeline_);
+  encoder_->setCullMode(MTL::CullModeNone);
+  encoder_->setViewport(MTL::Viewport{0, 0, double(context.render_target_width()),
+                                     double(context.render_target_height()), 0, 1});
+  const float inverse_size[] = {1.0f / coordinate_space_width(), 1.0f / coordinate_space_height()};
+  encoder_->setVertexBytes(inverse_size, sizeof(inverse_size), 1);
+}
+
+void MetalImmediateDrawer::BeginDrawBatch(const ImmediateDrawBatch& batch) {
+  EndDrawBatch();
+  if (!encoder_ || !batch.vertices || batch.vertex_count <= 0 || batch.index_count < 0) return;
+  vertices_ = provider_.device()->newBuffer(batch.vertices,
+      size_t(batch.vertex_count) * sizeof(ImmediateVertex), MTL::ResourceStorageModeShared);
+  if (!vertices_) return;
+  vertex_count_ = batch.vertex_count;
+  indexed_ = batch.index_count > 0;
+  if (indexed_) {
+    if (!batch.indices) { EndDrawBatch(); return; }
+    indices_ = provider_.device()->newBuffer(batch.indices,
+        size_t(batch.index_count) * sizeof(uint16_t), MTL::ResourceStorageModeShared);
+    if (!indices_) { EndDrawBatch(); return; }
+    index_count_ = batch.index_count;
+  }
+  encoder_->setVertexBuffer(vertices_, 0, 0);
+}
+
+void MetalImmediateDrawer::Draw(const ImmediateDraw& draw) {
+  if (!encoder_ || !vertices_ || draw.count <= 0 || draw.base_vertex < 0) return;
+  if (indexed_) {
+    if (draw.index_offset < 0 || draw.index_offset > index_count_ ||
+        draw.count > index_count_ - draw.index_offset) return;
+    // Avoid a malformed debug-overlay batch reading outside its vertex buffer.
+    const auto* indices = static_cast<const uint16_t*>(indices_->contents()) + draw.index_offset;
+    for (int i = 0; i < draw.count; ++i) {
+      if (uint64_t(draw.base_vertex) + indices[i] >= uint64_t(vertex_count_)) return;
+    }
+  } else if (draw.base_vertex > vertex_count_ || draw.count > vertex_count_ - draw.base_vertex) {
+    return;
+  }
+  uint32_t left, top, width, height;
+  if (!ScissorToRenderTarget(draw, left, top, width, height)) return;
+  encoder_->setScissorRect(MTL::ScissorRect{left, top, width, height});
+  auto* texture = static_cast<Texture*>(draw.texture ? draw.texture : white_.get());
+  uint32_t opaque = texture->opaque ? 1 : 0;
+  encoder_->setFragmentBytes(&opaque, sizeof(opaque), 0);
+  encoder_->setFragmentTexture(texture->texture, 0);
+  encoder_->setFragmentSamplerState(texture->sampler, 0);
+  auto primitive = draw.primitive_type == ImmediatePrimitiveType::kLines
+                       ? MTL::PrimitiveTypeLine : MTL::PrimitiveTypeTriangle;
+  if (indexed_) {
+    encoder_->drawIndexedPrimitives(primitive, NS::UInteger(draw.count), MTL::IndexTypeUInt16,
+        indices_, size_t(draw.index_offset) * sizeof(uint16_t), 1, draw.base_vertex, 0);
+  } else {
+    encoder_->drawPrimitives(primitive, NS::UInteger(draw.base_vertex), NS::UInteger(draw.count));
+  }
+}
+
+void MetalImmediateDrawer::EndDrawBatch() {
+  // commandBuffer() retains bound resources through GPU completion.
+  ReleaseObject(vertices_);
+  ReleaseObject(indices_);
+  vertex_count_ = index_count_ = 0;
+  indexed_ = false;
+}
+
+void MetalImmediateDrawer::End() {
+  EndDrawBatch();
+  encoder_ = nullptr;
+  ImmediateDrawer::End();
+}
+}  // namespace rex::ui::metal
+#endif
