+// Adapted from Xenia / ReXGlue's Vulkan host-render-target implementation.
+// Copyright 2021-2022 Ben Vanik. All rights reserved.
+// Released under the BSD license - see LICENSE in the root for more details.
+#include <rex/graphics/metal/resources.h>
+#if defined(__APPLE__) && defined(REX_HAS_METAL) && REX_HAS_METAL
+
+#include <algorithm>
+#include <chrono>
+#include <condition_variable>
+#include <cstring>
+#include <mutex>
+#include <rex/logging.h>
+#include <rex/graphics/flags.h>
+#include <rex/perf/counter.h>
+#include "../../ui/metal/metal_util.h"
+
+REXCVAR_DEFINE_UINT64(metal_trace_resolves, 0, "GPU",
+                     "Trace resolves, transfers, texture reloads and swaps for N frames; 0 disables");
+REXCVAR_DEFINE_UINT64(metal_trace_resolves_start, 1, "GPU",
+                     "First swap number to trace (1-based)");
+
+namespace rex::graphics::metal {
+using ui::metal::Adopt;
+using ui::metal::ReleaseObject;
+using ui::metal::ErrorText;
+
+MetalSubmission::MetalSubmission(MTL::Device* device, MTL::CommandQueue* queue)
+    : device_(device), queue_(queue) {}
+MetalSubmission::~MetalSubmission() {
+  Finish();
+  for (auto* buffer : free_uniforms_) buffer->release();
+  ReleaseObject(listener_);
+  ReleaseObject(event_);
+}
+bool MetalSubmission::trace_resolves() const {
+  uint64_t start = std::max(uint64_t(1), REXCVAR_GET(metal_trace_resolves_start));
+  return frame_ >= start && frame_ - start < REXCVAR_GET(metal_trace_resolves);
+}
+bool MetalSubmission::Initialize() {
+  event_ = device_->newSharedEvent();
+  listener_ = MTL::SharedEventListener::alloc()->init();
+  return event_ && listener_;
+}
+bool MetalSubmission::Poll() {
+  // Inspect errors even if a failed buffer did not reach its signal command.
+  for (const auto& p : pending_) {
+    if (p.buffer->status() == MTL::CommandBufferStatusError && !failed_) {
+      REXLOG_ERROR("Metal submission {} failed: {}", p.epoch, ErrorText(p.buffer->error()));
+      failed_ = true;
+    }
+  }
+  while (!pending_.empty()) {
+    const auto& p = pending_.front();
+    if (p.buffer->status() != MTL::CommandBufferStatusCompleted &&
+        p.buffer->status() != MTL::CommandBufferStatusError) break;
+    if (p.uniforms) free_uniforms_.push_back(p.uniforms);
+    p.buffer->release();
+    pending_.pop_front();
+  }
+  return !failed_;
+}
+bool MetalSubmission::Begin() {
+  if (!Poll()) return false;
+  if (!buffer_) {
+    buffer_ = queue_->commandBuffer();
+    if (!buffer_) return false;
+    buffer_->retain();  // commandBuffer retains every encoded resource.
+  }
+  return true;
+}
+void MetalSubmission::EndEncoding([[maybe_unused]] perf::CounterId reason) {
+  if (encoder) {
+    encoder->endEncoding();
+    ReleaseObject(encoder);
+#if defined(REXGLUE_ENABLE_PERF_COUNTERS) && !REX_PLATFORM_PS5
+    perf::IncrementCounter(reason);
+#endif
+  }
+}
+bool MetalSubmission::Submit(perf::CounterId reason) {
+  auto pool = Adopt(NS::AutoreleasePool::alloc()->init());
+  if (!buffer_) return Poll();
+  EndEncoding(reason);
+  buffer_->encodeSignalEvent(event_, epoch_);
+  pending_.push_back({epoch_++, buffer_, uniforms_});
+  buffer_->commit();
+  buffer_ = nullptr;
+  uniforms_ = nullptr;
+  uniform_offset_ = 0;
+  PERF_METAL_counter_add(kSubmissions, 1);
+  return Poll();
+}
+bool MetalSubmission::Wait(uint64_t epoch) {
+  if (!Poll()) return false;
+  if (event_->signaledValue() >= epoch) return true;
+  struct Notification {
+    std::mutex mutex;
+    std::condition_variable cv;
+    bool signaled = false;
+  };
+  auto notification = std::make_shared<Notification>();
+  event_->notifyListener(listener_, epoch,
+      MTL::SharedEventNotificationFunction([notification](MTL::SharedEvent*, uint64_t) {
+        std::lock_guard lock(notification->mutex);
+        notification->signaled = true;
+        notification->cv.notify_all();
+      }));
+  std::unique_lock lock(notification->mutex);
+  while (!notification->signaled && event_->signaledValue() < epoch) {
+    notification->cv.wait_for(lock, std::chrono::milliseconds(10));
+    if (!Poll()) return false;  // GPU error must not deadlock the CP.
+  }
+  return Poll();
+}
+bool MetalSubmission::BeforeUpload(uint64_t last_use) {
+  if (!Poll()) return false;
+  if (last_use == epoch_ && buffer_) {
+    PERF_METAL_counter_add(kMetalSplitForUpload, 1);
+    if (!Submit(perf::CounterId::kPassEndBarrierUpload) || !Begin()) return false;
+  }
+  if (last_use > event_->signaledValue()) {
+    const auto start = std::chrono::steady_clock::now();
+    bool success = Wait(last_use);
+    PERF_METAL_counter_add(kMetalUploadWaitUs,
+        std::chrono::duration_cast<std::chrono::microseconds>(
+            std::chrono::steady_clock::now() - start).count());
+    return success;
+  }
+  return true;
+}
+bool MetalSubmission::AllocateConstants(size_t size, MTL::Buffer*& buffer, size_t& offset) {
+  constexpr size_t kRingSize = 8 * 1024 * 1024;
+  size = (size + 255) & ~size_t(255);
+  if (size > kRingSize || !Begin()) return false;
+  if (uniform_offset_ + size > kRingSize &&
+      (!Submit(perf::CounterId::kPassEndBarrierUpload) || !Begin())) return false;
+  if (!uniforms_) {
+    if (free_uniforms_.empty()) {
+      uniforms_ = device_->newBuffer(kRingSize, MTL::ResourceStorageModeShared);
+    } else {
+      uniforms_ = free_uniforms_.back();
+      free_uniforms_.pop_back();
+    }
+    if (!uniforms_) return false;
+  }
+  buffer = uniforms_;
+  offset = uniform_offset_;
+  uniform_offset_ += size;
+  return true;
+}
+void MetalSubmission::Finish() {
+  // Only teardown drains the queue; ordinary submission and cache clearing are async.
+  Submit();
+  for (const auto& p : pending_) p.buffer->waitUntilCompleted();
+  Poll();
+}
+
+MetalSharedMemory::~MetalSharedMemory() {
+  ShutdownCommon();
+  ReleaseObject(buffer_);
+}
+bool MetalSharedMemory::Initialize(MTL::Device* device) {
+  buffer_ = device->newBuffer(kBufferSize, MTL::ResourceStorageModeShared);
+  if (!buffer_) return false;
+  // No eager copy or bytesNoCopy alias: RequestRanges selects each snapshot.
+  InitializeCommon();
+  return true;
+}
+bool MetalSharedMemory::RequestRangeForGpuWrite(uint32_t start, uint32_t length) {
+  if (!length) return true;
+  if (start >= kBufferSize || length > kBufferSize - start) return false;
+  // RangeWrittenByGpu preserves whole native pages. Request their untouched
+  // bytes too: hot-page requests otherwise upload only the requested bytes.
+  // Already GPU-written pages stay resident in the base RequestRange path.
+  const uint32_t page_mask = (uint32_t(1) << page_size_log2()) - 1;
+  const uint32_t page_start = start & ~page_mask;
+  const uint32_t page_last = (start + length - 1) | page_mask;
+  return SharedMemory::RequestRange(page_start, page_last - page_start + 1);
+}
+void MetalSharedMemory::MarkGpuWrittenRange(uint32_t start, uint32_t length) {
+  if (start >= kBufferSize) return;
+  // Readers and writers share the ordered queue and monotonic epoch. Copy
+  // waits for whichever access came last, with no separate wait path.
+  MarkUsed(start, length);
+}
+void MetalSharedMemory::RangeWrittenByGpu(uint32_t start, uint32_t length) {
+  MarkGpuWrittenRange(start, length);
+  SharedMemory::RangeWrittenByGpu(start, length);
+}
+void MetalSharedMemory::MarkUsed(uint32_t start, uint32_t length) {
+  start &= kBufferSize - 1;
+  length = std::min(length, kBufferSize - start);
+  if (!length) return;
+  for (uint32_t p = start >> 14; p <= (start + length - 1) >> 14; ++p)
+    last_use_[p] = submission_.epoch();
+}
+bool MetalSharedMemory::Copy(uint32_t start, uint32_t length, bool make_valid) {
+  if (!buffer_ || start > kBufferSize || length > kBufferSize - start) return false;
+  if (!length) return true;
+  uint64_t last_use = 0;
+  for (uint32_t p = start >> 14; p <= (start + length - 1) >> 14; ++p)
+    last_use = std::max(last_use, last_use_[p]);
+  if (!submission_.BeforeUpload(last_use)) return false;
+  // Protect immediately before the copy so concurrent guest writes invalidate
+  // the snapshot, exactly as in VulkanSharedMemory::UploadRanges.
+  if (make_valid) MakeRangeValid(start, length, false);
+  std::memcpy(static_cast<uint8_t*>(buffer_->contents()) + start,
+              memory().TranslatePhysical(start), length);
+  PERF_METAL_counter_add(kUploadBytes, length);
+  return true;
+}
+bool MetalSharedMemory::UploadRanges(
+    const std::vector<std::pair<uint32_t, uint32_t>>& ranges) {
+  for (auto [start, length] : ranges) {
+    if (!Copy(start << page_size_log2(), length << page_size_log2(), true)) return false;
+  }
+  return true;
+}
+bool MetalSharedMemory::UploadByteRanges(
+    const std::vector<std::pair<uint32_t, uint32_t>>& ranges) {
+  for (auto [start, length] : ranges) {
+    if (!Copy(start, length, false)) return false;
+  }
+  return true;
+}
+
+MetalPrimitiveProcessor::~MetalPrimitiveProcessor() {
+  EndFrame();
+  ReleaseObject(builtin_);
+  ShutdownCommon();
+}
+void MetalPrimitiveProcessor::EndFrame() {
+  ClearPerFrameCache();
+  // Encoded command buffers retain these. Never reuse them while the GPU runs.
+  for (auto [buffer, offset] : converted_) buffer->release();
+  converted_.clear();
+}
+bool MetalPrimitiveProcessor::InitializeBuiltinIndexBuffer(
+    size_t size, std::function<void(void*)> fill) {
+  builtin_ = device_->newBuffer(size, MTL::ResourceStorageModeShared);
+  if (!builtin_) return false;
+  fill(builtin_->contents());
+  return true;
+}
+void* MetalPrimitiveProcessor::RequestHostConvertedIndexBufferForCurrentFrame(
+    xenos::IndexFormat format, uint32_t count, bool coalign, uint32_t original, size_t& handle) {
+  size_t size = size_t(count) * (format == xenos::IndexFormat::kInt16 ? 2 : 4);
+  auto* buffer = device_->newBuffer(std::max(size_t(4), size) +
+      XE_GPU_PRIMITIVE_PROCESSOR_SIMD_SIZE, MTL::ResourceStorageModeShared);
+  if (!buffer) return nullptr;
+  size_t offset = coalign ? GetSimdCoalignmentOffset(buffer->contents(), original) : 0;
+  handle = converted_.size();
+  converted_.emplace_back(buffer, offset);
+  return static_cast<uint8_t*>(buffer->contents()) + offset;
+}
+std::pair<MTL::Buffer*, size_t> MetalPrimitiveProcessor::GetIndexBuffer(
+    const ProcessingResult& r) const {
+  if (r.index_buffer_type == kHostConverted) return converted_.at(r.host_index_buffer_handle);
+  return {builtin_, GetBuiltinIndexBufferOffsetBytes(r.host_index_buffer_handle)};
+}
+bool MetalPrimitiveProcessor::Process(ProcessingResult& r) {
+  if (!PrimitiveProcessor::Process(r)) return false;
+  // Metal cannot disable restart on strips. Convert no-restart strips to lists,
+  // preserving raw index bits and shader endianness, including real 0xFFFF /
+  // 0xFFFFFFFF vertices. List restart was already removed by the base class.
+  bool triangles = r.host_primitive_type == xenos::PrimitiveType::kTriangleStrip;
+  if (r.host_primitive_reset_enabled ||
+      (!triangles && r.host_primitive_type != xenos::PrimitiveType::kLineStrip)) return true;
+  const uint32_t minimum = triangles ? 3 : 2;
+  if (r.host_draw_vertex_count < minimum) {
+    r.host_draw_vertex_count = 0;
+    return true;
+  }
+  const uint8_t* source = nullptr;
+  if (r.index_buffer_type == kGuestDMA) {
+    // Same CPU conversion source and timing as PrimitiveProcessor's fan/quad path.
+    source = memory_.TranslatePhysical<const uint8_t*>(r.guest_index_base);
+  } else if (r.index_buffer_type != kNone) {
+    auto [buffer, offset] = GetIndexBuffer(r);
+    source = static_cast<const uint8_t*>(buffer->contents()) + offset;
+  }
+  bool short_index = source && r.host_index_format == xenos::IndexFormat::kInt16;
+  uint32_t count = (r.host_draw_vertex_count - minimum + 1) * minimum;
+  auto* output = static_cast<uint32_t*>(RequestHostConvertedIndexBufferForCurrentFrame(
+      xenos::IndexFormat::kInt32, count, false, 0, r.host_index_buffer_handle));
+  if (!output) return false;
+  auto index = [&](uint32_t i) {
+    if (!source) return i;
+    if (short_index) {
+      uint16_t value;
+      std::memcpy(&value, source + size_t(i) * 2, 2);
+      return uint32_t(value);
+    }
+    uint32_t value;
+    std::memcpy(&value, source + size_t(i) * 4, 4);
+    return value;
+  };
+  for (uint32_t i = minimum - 1; i < r.host_draw_vertex_count; ++i) {
+    if (triangles) {
+      *output++ = index(i - 2 + (i & 1));
+      *output++ = index(i - 1 - (i & 1));
+    } else {
+      *output++ = index(i - 1);
+    }
+    *output++ = index(i);
+  }
+  r.index_buffer_type = kHostConverted;
+  r.host_index_format = xenos::IndexFormat::kInt32;
+  r.host_primitive_type = triangles ? xenos::PrimitiveType::kTriangleList
+                                  : xenos::PrimitiveType::kLineList;
+  r.host_draw_vertex_count = count;
+  return true;
+}
+}  // namespace rex::graphics::metal
+#endif
