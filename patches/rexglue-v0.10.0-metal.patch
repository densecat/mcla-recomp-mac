+namespace rex::graphics::metal {
+namespace {
+// PNG RGBA8, filter None, zlib stored DEFLATE blocks: no extra library/framework.
+void BE32(std::vector<uint8_t>& out, uint32_t v) {
+  for (int shift = 24; shift >= 0; shift -= 8) out.push_back(uint8_t(v >> shift));
+}
+void Chunk(std::vector<uint8_t>& out, const char* tag, const std::vector<uint8_t>& data) {
+  BE32(out, uint32_t(data.size()));
+  size_t start = out.size();
+  out.insert(out.end(), tag, tag + 4);
+  out.insert(out.end(), data.begin(), data.end());
+  uint32_t crc = UINT32_MAX;
+  for (size_t i = start; i < out.size(); ++i) {
+    crc ^= out[i];
+    for (uint32_t bit = 0; bit < 8; ++bit)
+      crc = (crc >> 1) ^ (0xEDB88320u & (0u - (crc & 1)));
+  }
+  BE32(out, ~crc);
+}
+bool WritePNG(const std::filesystem::path& path, const ui::RawImage& image) {
+  if (!image.width || !image.height || image.width > 16384 || image.height > 16384) return false;
+  size_t row_bytes = size_t(image.width) * 4;
+  if (image.stride < row_bytes ||
+      image.data.size() < image.stride * (image.height - 1) + row_bytes) return false;
+  std::vector<uint8_t> raw;
+  raw.reserve((row_bytes + 1) * image.height);
+  for (uint32_t y = 0; y < image.height; ++y) {
+    raw.push_back(0);
+    const auto* row = image.data.data() + y * image.stride;
+    raw.insert(raw.end(), row, row + row_bytes);
+    // RawImage promises RGBX, not RGBA.
+    for (size_t x = raw.size() - row_bytes + 3; x < raw.size(); x += 4) raw[x] = 255;
+  }
+  std::vector<uint8_t> zlib{0x78, 0x01};
+  uint32_t a = 1, b = 0;
+  for (size_t offset = 0; offset < raw.size();) {
+    uint16_t length = uint16_t(std::min(size_t(65535), raw.size() - offset));
+    zlib.push_back(offset + length == raw.size() ? 1 : 0);
+    zlib.push_back(uint8_t(length)); zlib.push_back(uint8_t(length >> 8));
+    zlib.push_back(uint8_t(~length)); zlib.push_back(uint8_t((~length) >> 8));
+    zlib.insert(zlib.end(), raw.begin() + offset, raw.begin() + offset + length);
+    for (size_t i = offset; i < offset + length; ++i) {
+      a = (a + raw[i]) % 65521; b = (b + a) % 65521;
+    }
+    offset += length;
+  }
+  BE32(zlib, (b << 16) | a);
+  std::vector<uint8_t> png{137, 80, 78, 71, 13, 10, 26, 10}, header;
+  BE32(header, image.width); BE32(header, image.height);
+  header.insert(header.end(), {8, 6, 0, 0, 0});
+  Chunk(png, "IHDR", header); Chunk(png, "IDAT", zlib); Chunk(png, "IEND", {});
+  std::ofstream stream(path, std::ios::binary | std::ios::trunc);
+  stream.write(reinterpret_cast<const char*>(png.data()), std::streamsize(png.size()));
+  stream.close();
+  return bool(stream);
+}
+}
+void DumpFrameIfRequested(ui::Presenter& presenter, uint64_t swap) {
+  const uint64_t n = REXCVAR_GET(metal_dump_frame);
+  if (!n || (REXCVAR_GET(metal_dump_every) ? swap % n != 0 : swap != n)) return;
+  // CaptureGuestOutput reads the completed mailbox texture, never a CAMetalDrawable.
+  // Thus capture does not require a paintable display or a successful present.
+  ui::RawImage image;
+  if (!presenter.CaptureGuestOutput(image)) {
+    REXLOG_ERROR("Metal PNG readback failed at swap {}", swap);
+    return;
+  }
+  std::error_code error;
+  auto directory = std::filesystem::absolute(REXCVAR_GET(metal_dump_path), error);
+  if (!error) std::filesystem::create_directories(directory, error);
+  auto path = directory / fmt::format("metal-swap-{:08}.png", swap);
+  if (error || !WritePNG(path, image)) {
+    REXLOG_ERROR("Metal PNG write failed at swap {}: {}", swap,
+                 error ? error.message() : path.string());
+    return;
+  }
+  REXLOG_INFO("Metal PNG swap {}: {}", swap, path.string());
+}
+}  // namespace rex::graphics::metal
+#endif
