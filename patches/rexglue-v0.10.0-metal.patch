diff --git a/src/graphics/metal/msl_shader.cpp b/src/graphics/metal/msl_shader.cpp
new file mode 100644
index 0000000..f59cc86
--- /dev/null
+++ b/src/graphics/metal/msl_shader.cpp
@@ -0,0 +1,81 @@
+#include <rex/graphics/metal/msl_shader.h>
+#if defined(__APPLE__) && defined(REX_HAS_METAL) && REX_HAS_METAL
+#include <spirv_msl.hpp>
+#include <cstring>
+#include <stdexcept>
+#include <rex/logging.h>
+#include <rex/perf/counter.h>
+#include "../../ui/metal/metal_util.h"
+
+namespace rex::graphics::metal {
+namespace cross = SPIRV_CROSS_NAMESPACE;
+using ui::metal::Adopt;
+using ui::metal::ErrorText;
+using ui::metal::ReleaseObject;
+
+MetalFunction::~MetalFunction() {
+  ReleaseObject(function);
+  ReleaseObject(library);
+}
+bool CompileMSL(MTL::Device* device, const std::vector<uint8_t>& binary,
+                bool vertex, uint32_t texture_count, uint32_t sampler_count,
+                MetalFunction& result, uint32_t attachment_mask) {
+  auto pool = Adopt(NS::AutoreleasePool::alloc()->init());
+  try {
+    if (binary.empty() || binary.size() % 4 || texture_count > 128 || sampler_count > 16)
+      throw std::runtime_error("invalid SPIR-V size or discrete Metal resource limit exceeded");
+    std::vector<uint32_t> words(binary.size() / 4);
+    std::memcpy(words.data(), binary.data(), binary.size());
+    cross::CompilerMSL compiler(std::move(words));
+    auto options = compiler.get_msl_options();
+    options.platform = cross::CompilerMSL::Options::macOS;
+    options.set_msl_version(2, 4);
+    options.argument_buffers = false;
+    // Match the real pass, including sparse MRT slots; preserve shader side effects.
+    options.enable_frag_output_mask = attachment_mask >> 1;
+    options.enable_frag_depth_builtin = (attachment_mask & 1) != 0;
+    compiler.set_msl_options(options);
+    auto stage = vertex ? spv::ExecutionModelVertex : spv::ExecutionModelFragment;
+    compiler.set_entry_point("main", stage);
+    // These layouts are asserted against SpirvShaderTranslator in pipeline_cache.cpp.
+    auto bind = [&](uint32_t set, uint32_t binding, uint32_t buffer,
+                    uint32_t texture, uint32_t sampler) {
+      cross::MSLResourceBinding resource{};
+      resource.stage = stage;
+      resource.desc_set = set;
+      resource.binding = binding;
+      resource.msl_buffer = buffer;
+      resource.msl_texture = texture;
+      resource.msl_sampler = sampler;
+      compiler.add_msl_resource_binding(resource);
+    };
+    bind(0, 0, 0, 0, 0);  // Single 512 MiB shared-memory SSBO.
+    for (uint32_t i = 0; i < 5; ++i) bind(1, i, 1 + i, 0, 0);
+    uint32_t texture_set = vertex ? 2 : 3;
+    for (uint32_t i = 0; i < texture_count; ++i) bind(texture_set, i, 0, i, 0);
+    for (uint32_t i = 0; i < sampler_count; ++i)
+      bind(texture_set, texture_count + i, 0, 0, i);
+    std::string source = compiler.compile();
+    std::string entry = compiler.get_cleansed_entry_point_name("main", stage);
+    auto compile_options = Adopt(MTL::CompileOptions::alloc()->init());
+    compile_options->setLanguageVersion(MTL::LanguageVersion2_4);
+    compile_options->setFastMathEnabled(false);
+    NS::Error* error = nullptr;
+    result.library = device->newLibrary(NS::String::string(source.c_str(), NS::UTF8StringEncoding),
+                                        compile_options.get(), &error);
+    if (!result.library) throw std::runtime_error(ErrorText(error));
+    result.function = result.library->newFunction(
+        NS::String::string(entry.c_str(), NS::UTF8StringEncoding));
+    if (!result.function) throw std::runtime_error("compiled library has no stage entry point");
+    return true;
+  } catch (const std::exception& error) {
+    PERF_METAL_counter_add(kMetalMslCompileFailures, 1);
+    REXLOG_ERROR("Metal MSL compile failed: hash={:016X}, modification={:016X}, stage={}: {}",
+                 result.hash, result.modification, vertex ? "VS" : "PS", error.what());
+    ReleaseObject(result.function);
+    ReleaseObject(result.library);
+    return false;
+  }
+}
+}  // namespace rex::graphics::metal
+#endif
