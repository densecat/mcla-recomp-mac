diff --git a/src/graphics/metal/command_processor.cpp b/src/graphics/metal/command_processor.cpp
new file mode 100644
index 0000000..dda1220
--- /dev/null
+++ b/src/graphics/metal/command_processor.cpp
@@ -0,0 +1,97 @@
+#include <rex/graphics/metal/command_processor.h>
+#if defined(__APPLE__) && defined(REX_HAS_METAL) && REX_HAS_METAL
+
+#include <chrono>
+#include <cmath>
+#include <utility>
+#include <xxhash.h>
+#include <rex/graphics/graphics_system.h>
+#include <rex/graphics/pipeline/shader/shader.h>
+#include <rex/logging.h>
+#include <rex/perf/counter.h>
+#include <rex/ui/metal/presenter.h>
+#include <rex/ui/metal/provider.h>
+
+namespace rex::graphics::metal {
+MetalCommandProcessor::MetalCommandProcessor(GraphicsSystem* graphics, system::KernelState* kernel)
+    : CommandProcessor(graphics, kernel) {}
+MetalCommandProcessor::~MetalCommandProcessor() = default;
+
+bool MetalCommandProcessor::SetupContext() {
+  if (!CommandProcessor::SetupContext()) return false;
+  auto* provider = static_cast<ui::metal::MetalProvider*>(graphics_system_->provider());
+  if (!provider || !provider->device() || !provider->queue()) {
+    REXLOG_ERROR("Metal command processor: missing provider");
+    return false;
+  }
+  REXLOG_WARN("Metal milestone 1: guest draws/copies are counted but not rendered");
+  return true;
+}
+
+void MetalCommandProcessor::ShutdownContext() {
+  REXLOG_INFO("Metal M1 counts: draws={}, copies={}, swaps={}", draws_, copies_, swaps_);
+  active_vertex_shader_ = active_pixel_shader_ = nullptr;
+  shaders_.clear();
+  CommandProcessor::ShutdownContext();
+}
+
+Shader* MetalCommandProcessor::LoadShader(xenos::ShaderType type, uint32_t,
+                                         const uint32_t* host_address, uint32_t dword_count) {
+  if (!host_address || !dword_count) return nullptr;
+  uint64_t hash = XXH3_64bits(host_address, size_t(dword_count) * sizeof(uint32_t));
+  // Shader copies big-endian guest microcode into owned native-endian storage.
+  auto shader = std::make_unique<Shader>(type, hash, host_address, dword_count);
+  auto range = shaders_.equal_range(hash);
+  for (auto it = range.first; it != range.second; ++it) {
+    if (it->second->type() == type && it->second->ucode_data() == shader->ucode_data()) {
+      return it->second.get();
+    }
+  }
+  auto* result = shader.get();
+  shaders_.emplace(hash, std::move(shader));
+  return result;
+}
+
+bool MetalCommandProcessor::IssueDraw(xenos::PrimitiveType, uint32_t,
+                                      IndexBufferInfo*, bool) {
+  // The base packet decoder calls IssueDraw for copy-mode draws too.
+  if (register_file_->Get<reg::RB_MODECONTROL>().edram_mode == xenos::EdramMode::kCopy) {
+    return IssueCopy();
+  }
+  ++draws_;
+  PROFILE_DRAW_CALL();
+  return true;
+}
+
+bool MetalCommandProcessor::IssueCopy() {
+  ++copies_;
+  PROFILE_DRAW_CALL();
+  return true;
+}
+
+void MetalCommandProcessor::IssueSwap(uint32_t, uint32_t width, uint32_t height) {
+  ++swaps_;
+  auto* presenter = graphics_system_->presenter();
+  if (!presenter) return;  // Headless guest GPU.
+  if (!width || !height) {
+    presenter->RefreshGuestOutput(0, 0, 0, 0, {});
+    return;
+  }
+  double phase = std::chrono::duration<double>(
+      std::chrono::steady_clock::now().time_since_epoch()).count() * 0.25;
+  bool refreshed = presenter->RefreshGuestOutput(width, height, width, height,
+      [phase](ui::Presenter::GuestOutputRefreshContext& context) {
+        auto& metal = static_cast<ui::metal::MetalGuestOutputRefreshContext&>(context);
+        return metal.Clear(0.10 + 0.06 * std::sin(phase),
+                           0.14 + 0.06 * std::sin(phase + 2.0),
+                           0.22 + 0.06 * std::sin(phase + 4.0));
+      });
+  if (!refreshed && !swap_failure_logged_) {
+    REXLOG_ERROR("Metal guest-output refresh failed");
+    swap_failure_logged_ = true;
+  } else if (refreshed) {
+    swap_failure_logged_ = false;
+  }
+}
+}  // namespace rex::graphics::metal
+#endif
