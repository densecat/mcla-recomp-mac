diff --git a/src/graphics/metal/msl_shader.cpp b/src/graphics/metal/msl_shader.cpp
new file mode 100644
index 0000000..c8f708d
--- /dev/null
+++ b/src/graphics/metal/msl_shader.cpp
@@ -0,0 +1,82 @@
+#include <rex/graphics/metal/msl_shader.h>
+#if defined(__APPLE__) && defined(REX_HAS_METAL) && REX_HAS_METAL
+#include <spirv_msl.hpp>
+#include <cstring>
+#include <stdexcept>
+#include <rex/logging.h>
+#include <rex/perf/counter.h>
+#include "../../ui/metal/metal_util.h"
+
+namespace rex::graphics::metal {
+namespace cross = SPIRV_CROSS_NAMESPACE;
+using ui::metal::Adopt;
+using ui::metal::ErrorText;
+using ui::metal::ReleaseObject;
+
+MetalFunction::~MetalFunction() {
+  ReleaseObject(function);
+  ReleaseObject(library);
+}
+bool CompileMSL(MTL::Device* device, const std::vector<uint8_t>& binary,
+                bool vertex, uint32_t texture_count, uint32_t sampler_count,
+                MetalFunction& result) {
+  auto pool = Adopt(NS::AutoreleasePool::alloc()->init());
+  try {
+    if (binary.empty() || binary.size() % 4 || texture_count > 128 || sampler_count > 16)
+      throw std::runtime_error("invalid SPIR-V size or discrete Metal resource limit exceeded");
+    std::vector<uint32_t> words(binary.size() / 4);
+    std::memcpy(words.data(), binary.data(), binary.size());
+    cross::CompilerMSL compiler(std::move(words));
+    auto options = compiler.get_msl_options();
+    options.platform = cross::CompilerMSL::Options::macOS;
+    options.set_msl_version(2, 4);
+    options.argument_buffers = false;
+    compiler.set_msl_options(options);
+    auto stage = vertex ? spv::ExecutionModelVertex : spv::ExecutionModelFragment;
+    compiler.set_entry_point("main", stage);
+    // These layouts are asserted against SpirvShaderTranslator in pipeline_cache.cpp.
+    auto bind = [&](uint32_t set, uint32_t binding, uint32_t buffer,
+                    uint32_t texture, uint32_t sampler) {
+      cross::MSLResourceBinding resource{};
+      resource.stage = stage;
+      resource.desc_set = set;
+      resource.binding = binding;
+      resource.msl_buffer = buffer;
+      resource.msl_texture = texture;
+      resource.msl_sampler = sampler;
+      compiler.add_msl_resource_binding(resource);
+    };
+    bind(0, 0, 0, 0, 0);  // Single 512 MiB shared-memory SSBO.
+    for (uint32_t i = 0; i < 5; ++i) bind(1, i, 1 + i, 0, 0);
+    uint32_t texture_set = vertex ? 2 : 3;
+    for (uint32_t i = 0; i < texture_count; ++i) bind(texture_set, i, 0, i, 0);
+    for (uint32_t i = 0; i < sampler_count; ++i)
+      bind(texture_set, texture_count + i, 0, 0, i);
+    // M2a has only scratch color attachment 0. Preserve all shader side effects.
+    if (!vertex) {
+      for (uint32_t i = 1; i < 4; ++i) compiler.mask_stage_output_by_location(i, 0);
+    }
+    std::string source = compiler.compile();
+    std::string entry = compiler.get_cleansed_entry_point_name("main", stage);
+    auto compile_options = Adopt(MTL::CompileOptions::alloc()->init());
+    compile_options->setLanguageVersion(MTL::LanguageVersion2_4);
+    compile_options->setFastMathEnabled(false);
+    NS::Error* error = nullptr;
+    result.library = device->newLibrary(NS::String::string(source.c_str(), NS::UTF8StringEncoding),
+                                        compile_options.get(), &error);
+    if (!result.library) throw std::runtime_error(ErrorText(error));
+    result.function = result.library->newFunction(
+        NS::String::string(entry.c_str(), NS::UTF8StringEncoding));
+    if (!result.function) throw std::runtime_error("compiled library has no stage entry point");
+    return true;
+  } catch (const std::exception& error) {
+    PERF_METAL_counter_add(kMetalMslCompileFailures, 1);
+    REXLOG_ERROR("Metal MSL compile failed: hash={:016X}, modification={:016X}, stage={}: {}",
+                 result.hash, result.modification, vertex ? "VS" : "PS", error.what());
+    ReleaseObject(result.function);
+    ReleaseObject(result.library);
+    return false;
+  }
+}
+}  // namespace rex::graphics::metal
+#endif
diff --git a/src/graphics/metal/pipeline_cache.cpp b/src/graphics/metal/pipeline_cache.cpp
new file mode 100644
index 0000000..05d805c
--- /dev/null
+++ b/src/graphics/metal/pipeline_cache.cpp
@@ -0,0 +1,219 @@
+// Adapted from Xenia / ReXGlue's Vulkan host-render-target implementation.
+// Copyright 2021-2022 Ben Vanik. All rights reserved.
+// Released under the BSD license - see LICENSE in the root for more details.
+#include <rex/graphics/metal/pipeline_cache.h>
+#if defined(__APPLE__) && defined(REX_HAS_METAL) && REX_HAS_METAL
+#include <algorithm>
+#include <xxhash.h>
+#include <rex/graphics/util/draw.h>
+#include <rex/graphics/flags.h>
+#include <rex/string/buffer.h>
+#include <rex/perf/counter.h>
+#include "../../ui/metal/metal_util.h"
+
+namespace rex::graphics::metal {
+using ui::metal::Adopt;
+using ui::metal::ErrorText;
+namespace {
+using T = SpirvShaderTranslator;
+static_assert(T::kDescriptorSetSharedMemoryAndEdram == 0 &&
+              T::kDescriptorSetConstants == 1 && T::kDescriptorSetTexturesVertex == 2 &&
+              T::kDescriptorSetTexturesPixel == 3 && T::kConstantBufferSystem == 0 &&
+              T::kConstantBufferFloatVertex == 1 && T::kConstantBufferFloatPixel == 2 &&
+              T::kConstantBufferBoolLoop == 3 && T::kConstantBufferFetch == 4 &&
+              T::kConstantBufferCount == 5);
+T::Features Features(MTL::Device* device) {
+  // Match the pinned MoltenVK MVKDevice::initFeatures / Vulkan Features ctor,
+  // without creating or loading a Vulkan device.
+  T::Features f(false);
+  f.spirv_version = spv::Spv_1_5;
+  f.max_storage_buffer_range = uint32_t(std::min(uint64_t(UINT32_MAX),
+                                                uint64_t(device->maxBufferLength())));
+  f.full_draw_index_uint32 = true;
+  f.vertex_pipeline_stores_and_atomics = true;
+  f.fragment_stores_and_atomics = true;
+  f.clip_distance = true;
+  f.cull_distance = false;
+  f.image_view_format_swizzle = true;
+  f.signed_zero_inf_nan_preserve_float32 = true;
+  f.denorm_flush_to_zero_float32 = false;
+  f.rounding_mode_rte_float32 = true;
+  f.fragment_shader_sample_interlock = false;  // Host RT path.
+  f.demote_to_helper_invocation = true;
+  f.sample_rate_shading = true;
+  return f;
+}
+MTL::BlendFactor BlendFactor(uint32_t factor) {
+  static const MTL::BlendFactor table[32] = {
+      MTL::BlendFactorZero, MTL::BlendFactorOne, MTL::BlendFactorZero, MTL::BlendFactorZero,
+      MTL::BlendFactorSourceColor, MTL::BlendFactorOneMinusSourceColor,
+      MTL::BlendFactorSourceAlpha, MTL::BlendFactorOneMinusSourceAlpha,
+      MTL::BlendFactorDestinationColor, MTL::BlendFactorOneMinusDestinationColor,
+      MTL::BlendFactorDestinationAlpha, MTL::BlendFactorOneMinusDestinationAlpha,
+      MTL::BlendFactorBlendColor, MTL::BlendFactorOneMinusBlendColor,
+      MTL::BlendFactorBlendAlpha, MTL::BlendFactorOneMinusBlendAlpha,
+      MTL::BlendFactorSourceAlphaSaturated};
+  return table[factor & 31];
+}
+MTL::BlendOperation BlendOperation(uint32_t op) {
+  static const MTL::BlendOperation table[8] = {
+      MTL::BlendOperationAdd, MTL::BlendOperationSubtract, MTL::BlendOperationMin,
+      MTL::BlendOperationMax, MTL::BlendOperationReverseSubtract,
+      MTL::BlendOperationAdd, MTL::BlendOperationAdd, MTL::BlendOperationAdd};
+  return table[op & 7];
+}
+MTL::StencilOperation StencilOperation(xenos::StencilOp op) {
+  static const MTL::StencilOperation table[] = {
+      MTL::StencilOperationKeep, MTL::StencilOperationZero, MTL::StencilOperationReplace,
+      MTL::StencilOperationIncrementClamp, MTL::StencilOperationDecrementClamp,
+      MTL::StencilOperationInvert, MTL::StencilOperationIncrementWrap,
+      MTL::StencilOperationDecrementWrap};
+  return table[uint32_t(op) & 7];
+}
+}  // namespace
+MetalPipelineCache::MetalPipelineCache(MTL::Device* device)
+    : device_(device), translator_(Features(device),
+          REXCVAR_GET(native_2x_msaa) && device->supportsTextureSampleCount(2),
+          REXCVAR_GET(native_2x_msaa) && device->supportsTextureSampleCount(2), false, 1, 1) {}
+MetalPipelineCache::~MetalPipelineCache() {
+  for (auto& [key, state] : pipelines_) if (state) state->release();
+  for (auto& [key, state] : depths_) if (state) state->release();
+}
+MetalFunction* MetalPipelineCache::GetShader(SpirvShader& shader, uint64_t modification) {
+  auto* translation = shader.GetOrCreateTranslation(modification);
+  if (!translation->is_translated() && !translator_.TranslateAnalyzedShader(*translation)) {
+    PERF_METAL_counter_add(kMetalMslCompileFailures, 1);
+    REXLOG_ERROR("Metal SPIR-V translation failed: {:016X}/{:016X}",
+                 shader.ucode_data_hash(), modification);
+    return nullptr;
+  }
+  if (!translation->is_valid()) return nullptr;
+  const auto& binary = translation->translated_binary();
+  uint64_t hash = XXH3_64bits(binary.data(), binary.size());
+  std::array<uint64_t, 3> key{hash, modification, uint64_t(shader.type())};
+  auto it = shaders_.find(key);
+  if (it != shaders_.end()) return it->second->function ? it->second.get() : nullptr;
+  auto value = std::make_unique<MetalFunction>();
+  value->hash = hash;
+  value->modification = modification;
+  bool success = CompileMSL(device_, binary, shader.type() == xenos::ShaderType::kVertex,
+                            uint32_t(shader.GetTextureBindingsAfterTranslation().size()),
+                            uint32_t(shader.GetSamplerBindingsAfterTranslation().size()), *value);
+  auto* result = value.get();
+  shaders_.emplace(key, std::move(value));  // Cache failures; no endless recompilation.
+  return success ? result : nullptr;
+}
+uint64_t MetalPipelineCache::VertexModification(const RegisterFile& regs, const SpirvShader& shader,
+    Shader::HostVertexShaderType type, uint32_t interpolators, bool param_gen) const {
+  T::Modification m(translator_.GetDefaultVertexShaderModification(
+      shader.GetDynamicAddressableRegisterCount(regs.Get<reg::SQ_PROGRAM_CNTL>().vs_num_reg), type));
+  m.vertex.interpolator_mask = interpolators;
+  auto clip = regs.Get<reg::PA_CL_CLIP_CNTL>();
+  m.vertex.user_clip_plane_count = rex::bit_count(clip.clip_disable ? 0u : uint32_t(clip.ucp_ena));
+  m.vertex.point_ps_ucp_mode = clip.ps_ucp_mode;
+  m.vertex.output_point_parameters = type == Shader::HostVertexShaderType::kPointListAsTriangleStrip
+      ? param_gen : ((shader.writes_point_size_edge_flag_kill_vertex() & 1) &&
+                    regs.Get<reg::VGT_DRAW_INITIATOR>().prim_type == xenos::PrimitiveType::kPointList);
+  return m.value;
+}
+uint64_t MetalPipelineCache::PixelModification(const RegisterFile& regs, const SpirvShader& shader,
+    uint32_t interpolators, uint32_t param_gen) const {
+  T::Modification m(translator_.GetDefaultPixelShaderModification(
+      shader.GetDynamicAddressableRegisterCount(regs.Get<reg::SQ_PROGRAM_CNTL>().ps_num_reg)));
+  m.pixel.interpolator_mask = interpolators;
+  m.pixel.interpolators_centroid = interpolators & ~xenos::GetInterpolatorSamplingPattern(
+      regs.Get<reg::RB_SURFACE_INFO>().msaa_samples, regs.Get<reg::SQ_CONTEXT_MISC>().sc_sample_cntl,
+      regs.Get<reg::SQ_INTERPOLATOR_CNTL>().sampling_pattern);
+  if (param_gen < xenos::kMaxInterpolators) {
+    m.pixel.param_gen_enable = 1;
+    m.pixel.param_gen_interpolator = param_gen;
+    m.pixel.param_gen_point =
+        regs.Get<reg::VGT_DRAW_INITIATOR>().prim_type == xenos::PrimitiveType::kPointList;
+  }
+  if (shader.implicit_early_z_write_allowed() &&
+      (!shader.writes_color_target(0) ||
+       !draw_util::DoesCoverageDependOnAlpha(regs.Get<reg::RB_COLORCONTROL>())))
+    m.pixel.depth_stencil_mode = T::Modification::DepthStencilMode::kEarlyHint;
+  return m.value;
+}
+MTL::RenderPipelineState* MetalPipelineCache::GetPipeline(const RegisterFile& regs,
+    const MetalFunction& vs, const MetalFunction* ps, xenos::PrimitiveType primitive,
+    uint32_t color_mask, bool rasterize, MTL::PixelFormat color, MTL::PixelFormat depth,
+    uint32_t samples) {
+  auto blend = regs.Get<reg::RB_BLENDCONTROL>(reg::RB_BLENDCONTROL::rt_register_indices[0]);
+  std::array<uint64_t, 12> key{vs.hash, vs.modification, ps ? ps->hash : 0,
+      ps ? ps->modification : 0, uint64_t(primitive), uint64_t(color), uint64_t(depth),
+      samples, uint64_t(blend.value & 0x1FFF1FFF), color_mask & 15, rasterize, bool(ps)};
+  auto it = pipelines_.find(key);
+  if (it != pipelines_.end()) {
+    PERF_METAL_counter_add(kPipelineCacheHits, 1);
+    return it->second;
+  }
+  PERF_METAL_counter_add(kPipelineCacheMisses, 1);
+  auto desc = Adopt(MTL::RenderPipelineDescriptor::alloc()->init());
+  desc->setVertexFunction(vs.function);
+  desc->setFragmentFunction(rasterize && ps ? ps->function : nullptr);
+  desc->setRasterizationEnabled(rasterize);
+  desc->setRasterSampleCount(samples);
+  desc->setInputPrimitiveTopology(primitive == xenos::PrimitiveType::kPointList
+      ? MTL::PrimitiveTopologyClassPoint
+      : (primitive == xenos::PrimitiveType::kLineList || primitive == xenos::PrimitiveType::kLineStrip)
+          ? MTL::PrimitiveTopologyClassLine : MTL::PrimitiveTopologyClassTriangle);
+  desc->setDepthAttachmentPixelFormat(depth);
+  desc->setStencilAttachmentPixelFormat(depth);
+  auto* attachment = desc->colorAttachments()->object(0);
+  attachment->setPixelFormat(color);
+  uint32_t mask = color_mask & 15;
+  attachment->setWriteMask(MTL::ColorWriteMask(
+      ((mask & 1) ? MTL::ColorWriteMaskRed : 0) |
+      ((mask & 2) ? MTL::ColorWriteMaskGreen : 0) |
+      ((mask & 4) ? MTL::ColorWriteMaskBlue : 0) |
+      ((mask & 8) ? MTL::ColorWriteMaskAlpha : 0)));
+  attachment->setBlendingEnabled(mask && (blend.value & 0x1FFF1FFF) != 0x00010001);
+  attachment->setSourceRGBBlendFactor(BlendFactor(uint32_t(blend.color_srcblend)));
+  attachment->setDestinationRGBBlendFactor(BlendFactor(uint32_t(blend.color_destblend)));
+  attachment->setSourceAlphaBlendFactor(BlendFactor(uint32_t(blend.alpha_srcblend)));
+  attachment->setDestinationAlphaBlendFactor(BlendFactor(uint32_t(blend.alpha_destblend)));
+  attachment->setRgbBlendOperation(BlendOperation(uint32_t(blend.color_comb_fcn)));
+  attachment->setAlphaBlendOperation(BlendOperation(uint32_t(blend.alpha_comb_fcn)));
+  NS::Error* error = nullptr;
+  auto* pipeline = device_->newRenderPipelineState(desc.get(), &error);
+  if (!pipeline) REXLOG_ERROR("Metal pipeline creation failed: {}", ErrorText(error));
+  else PERF_METAL_counter_add(kMetalPipelinesCreated, 1);
+  pipelines_.emplace(key, pipeline);
+  return pipeline;
+}
+MTL::DepthStencilState* MetalPipelineCache::GetDepthState(const RegisterFile& regs,
+    bool polygonal, reg::RB_DEPTHCONTROL depth) {
+  if (!polygonal) depth.backface_enable = 0;
+  auto front = regs.Get<reg::RB_STENCILREFMASK>();
+  auto back = depth.backface_enable
+      ? regs.Get<reg::RB_STENCILREFMASK>(XE_GPU_REG_RB_STENCILREFMASK_BF) : front;
+  std::array<uint32_t, 3> key{depth.value, front.value & 0x00FFFF00, back.value & 0x00FFFF00};
+  auto it = depths_.find(key);
+  if (it != depths_.end()) return it->second;
+  auto desc = Adopt(MTL::DepthStencilDescriptor::alloc()->init());
+  desc->setDepthCompareFunction(depth.z_enable ? MTL::CompareFunction(depth.zfunc)
+                                               : MTL::CompareFunctionAlways);
+  desc->setDepthWriteEnabled(depth.z_enable && depth.z_write_enable);
+  if (depth.stencil_enable) {
+    for (int i = 0; i < 2; ++i) {
+      auto stencil = Adopt(MTL::StencilDescriptor::alloc()->init());
+      bool bf = i && depth.backface_enable;
+      stencil->setStencilCompareFunction(MTL::CompareFunction(bf ? depth.stencilfunc_bf : depth.stencilfunc));
+      stencil->setStencilFailureOperation(StencilOperation(bf ? depth.stencilfail_bf : depth.stencilfail));
+      stencil->setDepthFailureOperation(StencilOperation(bf ? depth.stencilzfail_bf : depth.stencilzfail));
+      stencil->setDepthStencilPassOperation(StencilOperation(bf ? depth.stencilzpass_bf : depth.stencilzpass));
+      stencil->setReadMask(i ? back.stencilmask : front.stencilmask);
+      stencil->setWriteMask(i ? back.stencilwritemask : front.stencilwritemask);
+      if (i) desc->setBackFaceStencil(stencil.get());
+      else desc->setFrontFaceStencil(stencil.get());
+    }
+  }
+  auto* state = device_->newDepthStencilState(desc.get());
+  if (!state) REXLOG_ERROR("Metal depth/stencil state creation failed");
+  depths_.emplace(key, state);
+  return state;
+}
+}  // namespace rex::graphics::metal
+#endif
