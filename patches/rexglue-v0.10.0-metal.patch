+REXCVAR_DEFINE_UINT64(metal_dump_frame, 0, "GPU", "Dump swap N to PNG; 0 disables dumping");
+REXCVAR_DEFINE_STRING(metal_dump_path, "metal_frames", "GPU", "Directory for Metal guest-output PNGs");
+REXCVAR_DEFINE_BOOL(metal_dump_every, false, "GPU", "Dump every N-th swap instead of only swap N");
