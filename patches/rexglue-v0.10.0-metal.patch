+T::SystemConstants SystemConstants(const RegisterFile& regs,
+    const PrimitiveProcessor::ProcessingResult& p, const draw_util::ViewportInfo& vp, bool polygonal,
+    const MetalRenderTargetCache& targets) {
+  T::SystemConstants c{};
+  const auto vte = regs.Get<reg::PA_CL_VTE_CNTL>();
+  const auto clip = regs.Get<reg::PA_CL_CLIP_CNTL>();
+  const auto surface = regs.Get<reg::RB_SURFACE_INFO>();
+  const auto control = regs.Get<reg::RB_COLORCONTROL>();
+  if (vte.vtx_xy_fmt) c.flags |= T::kSysFlag_XYDividedByW;
+  if (vte.vtx_z_fmt) c.flags |= T::kSysFlag_ZDividedByW;
+  if (vte.vtx_w0_fmt) c.flags |= T::kSysFlag_WNotReciprocal;
+  if (polygonal) c.flags |= T::kSysFlag_PrimitivePolygonal;
+  if (draw_util::IsPrimitiveLine(regs)) c.flags |= T::kSysFlag_PrimitiveLine;
+  c.flags |= uint32_t(surface.msaa_samples) << T::kSysFlag_MsaaSamples_Shift;
+  if (regs.Get<reg::RB_DEPTH_INFO>().depth_format == xenos::DepthRenderTargetFormat::kD24FS8)
+    c.flags |= T::kSysFlag_DepthFloat24;
+  c.flags |= uint32_t(control.alpha_test_enable ? control.alpha_func : xenos::CompareFunction::kAlways)
+             << T::kSysFlag_AlphaPassIfLess_Shift;
+  if (p.index_buffer_type == PrimitiveProcessor::kHostBuiltinForDMA) {
+    c.flags |= T::kSysFlag_ComputeOrPrimitiveVertexIndexLoad;
+    if (regs.Get<reg::VGT_DRAW_INITIATOR>().index_size == xenos::IndexFormat::kInt32)
+      c.flags |= T::kSysFlag_ComputeOrPrimitiveVertexIndexLoad32Bit;
+  }
+  c.vertex_index_load_address = p.guest_index_base;
+  c.vertex_index_endian = p.host_shader_index_endian;
+  c.vertex_base_index = regs.Get<int32_t>(XE_GPU_REG_VGT_INDX_OFFSET);
+  c.vertex_index_min = regs[XE_GPU_REG_VGT_MIN_VTX_INDX];
+  c.vertex_index_max = regs[XE_GPU_REG_VGT_MAX_VTX_INDX];
+  c.line_loop_closing_index = p.line_loop_closing_index;
+  uint32_t plane_out = 0;
+  if (!clip.clip_disable) {
+    for (uint32_t i = 0; i < 6; ++i) if (clip.ucp_ena & (1u << i))
+      std::memcpy(c.user_clip_planes[plane_out++], &regs[XE_GPU_REG_PA_CL_UCP_0_X + 4 * i], 16);
+  }
+  for (uint32_t i = 0; i < 3; ++i) {
+    c.ndc_scale[i] = vp.ndc_scale[i];
+    c.ndc_offset[i] = vp.ndc_offset[i];
+  }
+  auto point = regs.Get<reg::PA_SU_POINT_SIZE>();
+  auto bounds = regs.Get<reg::PA_SU_POINT_MINMAX>();
+  c.point_vertex_diameter_min = float(bounds.min_size) * 0.125f;
+  c.point_vertex_diameter_max = float(bounds.max_size) * 0.125f;
+  c.point_constant_diameter[0] = float(point.width) * 0.125f;
+  c.point_constant_diameter[1] = float(point.height) * 0.125f;
+  for (uint32_t i = 0; i < 2; ++i)
+    c.point_screen_diameter_to_ndc_radius[i] = 1.0f / std::max(1u, vp.xy_extent[i]);
+  c.alpha_test_reference = regs.Get<float>(XE_GPU_REG_RB_ALPHA_REF);
+  c.alpha_to_mask = control.alpha_to_mask_enable ? (control.value >> 24) | 256 : 0;
+  for (uint32_t i = 0; i < 4; ++i) {
+    auto info = regs.Get<reg::RB_COLOR_INFO>(reg::RB_COLOR_INFO::rt_register_indices[i]);
+    int32_t bias = info.color_exp_bias;
+    if (REXCVAR_GET(snorm16_render_target_full_range) &&
+        (info.color_format == xenos::ColorRenderTargetFormat::k_16_16 ||
+         info.color_format == xenos::ColorRenderTargetFormat::k_16_16_16_16)) bias -= 5;
+    c.color_exp_bias[i] = std::ldexp(1.0f, bias);
+    if (!targets.gamma_unorm16() &&
+        info.color_format == xenos::ColorRenderTargetFormat::k_8_8_8_8_GAMMA)
+      c.flags |= T::kSysFlag_ConvertColor0ToGamma << i;
+  }
+  return c;
+}
+void FloatConstants(uint8_t* dest, const RegisterFile& regs, const SpirvShader* shader, bool pixel) {
+  if (!shader) return;
+  const auto& map = shader->constant_register_map();
+  for (uint32_t group = 0; group < 4; ++group) {
+    uint64_t bits = map.float_bitmap[group];
+    uint32_t index;
+    while (rex::bit_scan_forward(bits, &index)) {
+      bits &= ~(uint64_t(1) << index);
+      std::memcpy(dest, &regs[(pixel ? XE_GPU_REG_SHADER_CONSTANT_256_X : XE_GPU_REG_SHADER_CONSTANT_000_X)
+                              + group * 256 + index * 4], 16);
+      dest += 16;
+    }
+  }
+}
