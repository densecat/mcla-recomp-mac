@@ -0,0 +1,714 @@
+// Adapted from Xenia / ReXGlue's Vulkan host-render-target implementation.
+// Copyright 2021-2022 Ben Vanik. All rights reserved.
+// Released under the BSD license - see LICENSE in the root for more details.
+#include <rex/graphics/metal/command_processor.h>
+#if defined(__APPLE__) && defined(REX_HAS_METAL) && REX_HAS_METAL
+
+#include <algorithm>
+#include <cmath>
+#include <cstring>
+#include <utility>
+#include <xxhash.h>
+#include <rex/graphics/flags.h>
+#include <rex/graphics/graphics_system.h>
+#include <rex/graphics/metal/resources.h>
+#include <rex/graphics/metal/pipeline_cache.h>
+#include <rex/graphics/metal/render_target_cache.h>
+#include <rex/graphics/metal/texture_cache.h>
+#include "frame_dump.h"
+#include <rex/graphics/util/draw.h>
+#include <rex/graphics/util/draw_extent_estimator.h>
+#include <rex/kernel/xboxkrnl/video.h>
+#include <rex/logging.h>
+#include <rex/perf/counter.h>
+#include <rex/string/buffer.h>
+#include <rex/ui/metal/presenter.h>
+#include <rex/ui/metal/provider.h>
+#include "../../ui/metal/metal_util.h"
+
+REXCVAR_DEFINE_BOOL(metal_debug_present_last_rt, false, "GPU",
+                    "Debug only: display the largest guest color target instead of the frontbuffer");
+
+namespace rex::graphics::metal {
+using ui::metal::Adopt;
+using ui::metal::ReleaseObject;
+using T = SpirvShaderTranslator;
+
+struct MetalCommandProcessor::State {
+  MTL::Device* device;
+  MetalSubmission submission;
+  MetalSharedMemory shared;
+  MetalPrimitiveProcessor primitives;
+  MetalRenderTargetCache targets;
+  MetalTextureCache textures;
+  MetalPipelineCache pipelines;
+  DrawExtentEstimator extent;
+  std::array<MTL::Texture*, 6> placeholders{};
+  MTL::SamplerState* sampler = nullptr;
+  bool debug_present_logged = false;
+  MTL::RenderPipelineState* swap_pipeline = nullptr;
+  bool swap_pipeline_attempted = false;
+  uint32_t trace_draws = 0;
+  uint64_t previous_draws = 0, previous_rejected = 0;
+  string::StringBuffer disassembly;
+
+  State(MTL::Device* d, MTL::CommandQueue* queue, const RegisterFile& regs, memory::Memory& memory)
+      : device(d), submission(d, queue), shared(memory, submission),
+        primitives(regs, memory, shared, d), targets(regs, memory, d, submission),
+        textures(regs, shared, d, submission), pipelines(d, targets), extent(regs, memory) {}
+  ~State() {
+    submission.Finish();
+    for (auto*& texture : placeholders) ReleaseObject(texture);
+    ReleaseObject(sampler);
+    ReleaseObject(swap_pipeline);
+  }
+  bool Initialize() {
+    if (device->maxBufferLength() < SharedMemory::kBufferSize ||
+        !submission.Initialize() || !shared.Initialize(device) || !primitives.Initialize())
+      return false;
+    for (uint32_t i = 0; i < placeholders.size(); ++i) {
+      auto desc = Adopt(MTL::TextureDescriptor::alloc()->init());
+      const MTL::TextureType types[] = {MTL::TextureType2DArray, MTL::TextureType3D, MTL::TextureTypeCube};
+      desc->setTextureType(types[i % 3]);
+      desc->setPixelFormat(i >= 3 ? MTL::PixelFormatRGBA8Snorm : MTL::PixelFormatRGBA8Unorm);
+      desc->setWidth(1); desc->setHeight(1); desc->setDepth(1);
+      desc->setArrayLength(1);
+      desc->setStorageMode(MTL::StorageModeShared);
+      desc->setUsage(MTL::TextureUsageShaderRead);
+      placeholders[i] = device->newTexture(desc.get());
+      if (!placeholders[i]) return false;
+      // UNORM and SNORM both sample as opaque mid-grey.
+      uint32_t texel = i >= 3 ? 0x7F404040 : 0xFF808080;
+      for (uint32_t slice = 0; slice < (i % 3 == 2 ? 6u : 1u); ++slice)
+        placeholders[i]->replaceRegion(MTL::Region(0, 0, 0, 1, 1, 1), 0, slice, &texel, 4, 4);
+    }
+    auto desc = Adopt(MTL::SamplerDescriptor::alloc()->init());
+    desc->setNormalizedCoordinates(true);
+    desc->setMinFilter(MTL::SamplerMinMagFilterLinear);
+    desc->setMagFilter(MTL::SamplerMinMagFilterLinear);
+    desc->setSAddressMode(MTL::SamplerAddressModeClampToEdge);
+    desc->setTAddressMode(MTL::SamplerAddressModeClampToEdge);
+    desc->setRAddressMode(MTL::SamplerAddressModeClampToEdge);
+    sampler = device->newSamplerState(desc.get());
+    return sampler != nullptr;
+  }
+  MTL::RenderPipelineState* GetSwapPipeline() {
+    if (swap_pipeline_attempted) return swap_pipeline;
+    swap_pipeline_attempted = true;
+    // SDK Vulkan gamma shader rules: 256-entry RGB table for 8888; 128 RGB
+    // base/delta entries with a three-bit increment for 2101010.
+    constexpr const char* source = R"MSL(
+#include <metal_stdlib>
+using namespace metal;
+vertex float4 swap_vertex(uint index [[vertex_id]]) {
+  float2 p = float2(float((index << 1u) & 2u), float(index & 2u));
+  return float4(p * 2.0f - 1.0f, 0.0f, 1.0f);
+}
+fragment float4 swap_fragment(float4 position [[position]],
+    texture2d<float, access::read> source [[texture(0)]],
+    constant uint* ramp [[buffer(0)]], constant uint& flags [[buffer(1)]]) {
